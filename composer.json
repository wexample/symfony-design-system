{
  "name": "wexample/symfony-design-system",
  "description": "Design system assets for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "39.0.2",
  "keywords": [
    "symfony-ux"
  ],
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDesignSystem\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-loader": ">=25.0.0",
    "symfony/security-bundle": "^7.4 || ^8.0",
    "wexample/symfony-routing": ">=2.2.0",
    "wexample/symfony-template": ">=2.1.0",
    "wexample/symfony-preference": ">=2.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}