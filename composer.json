{
  "name": "wexample/symfony-design-system",
  "description": "Design system assets for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "11.0.1",
  "keywords": [
    "symfony-ux"
  ],
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDesignSystem\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-live": ">=3.0.0",
    "wexample/symfony-loader": ">=6.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}