{%- extends '@WexampleSymfonyDesignSystemBundle/components/bases/vue/vue.vue.twig' -%}

{%- block vue_body -%}
    {# Client-side twin of components/bar.html.twig: same markup, same classes.
       A change to either is a change to both. #}
    <component :is="tag" class="bar" :href="href">
        <div v-if="avatar || icon" class="bar--leading">
            <template v-if="avatar">
                <span v-html="avatar"></span>
            </template>
            <div v-else class="avatar" v-html="iconHtml"></div>
        </div>
        <div class="bar--title-block">
            <div class="text-strong text-ellipsis">[[ title ]]</div>
            <div v-if="subtitle" class="text-secondary text-ellipsis">[[ subtitle ]]</div>
        </div>
        {# A slot, so it is markup: a date, a tag, a button row. #}
        <div v-if="$slots.trailing" class="bar--trailing">
            <slot name="trailing"></slot>
        </div>
    </component>
{%- endblock -%}
