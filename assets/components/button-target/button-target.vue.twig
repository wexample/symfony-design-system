{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_body -%}
    {# Client-side twin of components/button-target.html.twig: same options, same
       markup. A change to either is a change to both. #}
    {#- Whatever the caller puts inside — a file path — led where the target
        says, instead of the icon and the words. -#}
    <a
            v-if="$slots.default"
            :class="className"
            :href="href || '#'"
            @click="onClick"
    ><slot></slot></a>
    <a
            v-else-if="label"
            :class="className"
            :href="href || '#'"
            @click="onClick"
    >
        <span v-if="iconHtml" class="button--icon" v-html="iconHtml"></span>
        <span>[[ label ]]</span>
    </a>
    {#- Without a label the icon is the button, and wrapping it would only reserve
        room for the words that are not there. -#}
    <a
            v-else
            :class="className"
            :href="href || '#'"
            @click="onClick"
            v-html="iconHtml"
    ></a>
{%- endblock -%}
