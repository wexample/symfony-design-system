{# Client-side twin of vue/partials/button-target.vue: same options, same markup.
   A change to either is a change to both. #}
{#- A button first, whatever is added to it (`class`), as button and
    button_link have it: a flat one stays a button. -#}
<a class="button{{ options.class|default('') ? ' ' ~ options.class }}"
   href="{{ options.href|default('#') }}"
   data-target="{{ options.target }}"
   {#- Where it opens when its target is not on the page — an embed a page
       opened in a panel does not hold: `panel` unless said. -#}
   {% if options.target_embedded is defined %}data-target-embedded="{{ options.target_embedded }}"{% endif %}
   {% if options.target_options is defined %}data-target-options="{{ options.target_options|json_encode|e('html_attr') }}"{% endif %}
        {{ component_render_tag_attributes(options.attr|default({})) }}>
    {%- if html is defined and html -%}
        {#- Whatever the caller drew — a file path — made to lead where a
            target button leads. -#}
        {{- html|raw -}}
    {%- elseif label -%}
        {%- if icon -%}<span class="button--icon">{{ icon(icon) }}</span>{%- endif -%}
        <span>{{ label | trans }}</span>
    {%- else -%}
        {#- Without a label the icon is the button, and wrapping it would only
            reserve room for the words that are not there. -#}
        {{- icon(icon) -}}
    {%- endif -%}
</a>
