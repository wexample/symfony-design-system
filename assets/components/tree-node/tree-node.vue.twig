{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.components.tree-node.tree-node::*') }}
{%- endblock -%}

{%- block vue_body -%}
    <li class="tree--item" :class="{ 'is-open': isOpen, 'is-selected': isSelected }">
        <component
                :is="item.href ? 'a' : 'span'"
                ref="row"
                class="tree--row"
                :href="item.href || null"
                :style="{ '--tree-depth': depth }"
                @click="onRowClick"
        >
            {# Drawn by the node and not by the row: the caret says whether this
               node opens and whether it is open, which the row knows nothing of. #}
            <span class="tree--caret" v-html="caretHtml" @click.stop.prevent="onCaretClick"></span>
            <component
                    v-if="rowComponent"
                    :is="rowComponent"
                    :item="item"
                    :label="label"
                    :is-open="isOpen"
                    @action="$emit('action', $event)"
            ></component>
            <template v-else>
                <span v-if="item.icon" class="tree--icon" v-html="iconHtml"></span>
                <span class="tree--label">[[ label ]]</span>
            </template>
        </component>
        <ul v-if="hasLoadedChildren" class="tree--children">
            <tree-node
                    v-for="(child, index) in children"
                    :key="index"
                    :item="child"
                    :depth="depth + 1"
                    :parent-key="nodeKey"
                    @select="$emit('select', $event)"
                    @action="$emit('action', $event)"
            ></tree-node>
            {# What the level still holds is offered where the level ends, at its
               own indentation, and not as a control hanging outside the tree. #}
            <li v-if="remainingCount" class="tree--item">
                <span
                        class="tree--row tree--row--more"
                        :style="{ '--tree-depth': depth + 1 }"
                        @click="loadMore"
                >
                    <span class="tree--caret"></span>
                    <span class="tree--label">[[ moreLabel ]]</span>
                </span>
            </li>
        </ul>
    </li>
{%- endblock -%}
