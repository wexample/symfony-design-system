{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/tree') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/tree-row-directory') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/date-display') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/spinner') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer') -}}
{%- endblock -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.explorer.*') }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.zone.*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div class="file-explorer" :class="framed ? 'block block--card' : 'file-explorer--flush'">
        <div v-if="title" class="block--title">[[ title ]]</div>
        {#- The way back and forth, where it stands, and how it is shown. -#}
        <div class="toolbar toolbar--shaded toolbar--compact file-explorer--toolbar">
            <div class="toolbar--group">
                <button type="button" class="toolbar--action" :disabled="!backStack.length" :aria-label="t('back')" :data-tooltip="t('back')" @click="goBack" v-html="renderIcon('ph:bold/caret-left')"></button>
                <button type="button" class="toolbar--action" :disabled="!forwardStack.length" :aria-label="t('forward')" :data-tooltip="t('forward')" @click="goForward" v-html="renderIcon('ph:bold/caret-right')"></button>
                <button type="button" class="toolbar--action" :disabled="!path" :aria-label="t('up')" :data-tooltip="t('up')" @click="goUp" v-html="renderIcon('ph:bold/arrow-up')"></button>
            </div>
            <nav class="breadcrumb file-explorer--path" :aria-label="t('path')">
                <template v-for="(segment, index) in segments" :key="index">
                    <span v-if="index === segments.length - 1" class="breadcrumb--item breadcrumb--item--current">
                        <span class="breadcrumb--label">[[ segment.label ]]</span>
                    </span>
                    <button v-else type="button" class="breadcrumb--item file-explorer--crumb" @click="navigate(segment.path)">
                        <span class="breadcrumb--label">[[ segment.label ]]</span>
                    </button>
                    <span v-if="index < segments.length - 1" class="breadcrumb--separator" v-html="renderIcon('ph:bold/caret-right')"></span>
                </template>
            </nav>
            <div class="toolbar--group">
                <div class="form--input-group form--filter form--filter--compact file-explorer--filter">
                    <span class="form--input-addon" aria-hidden="true" v-html="renderIcon('ph:bold/magnifying-glass')"></span>
                    <input v-model="filter" type="search" class="form--input" :placeholder="t('filter')" :aria-label="t('filter')">
                </div>
                <button type="button" class="toolbar--action" :aria-label="t('view_list')" :data-tooltip="t('view_list')" :aria-pressed="view === 'list' ? 'true' : 'false'" @click="setView('list')" v-html="renderIcon('ph:bold/list')"></button>
                <button type="button" class="toolbar--action" :aria-label="t('view_grid')" :data-tooltip="t('view_grid')" :aria-pressed="view === 'grid' ? 'true' : 'false'" @click="setView('grid')" v-html="renderIcon('ph:bold/squares-four')"></button>
                <button type="button" class="toolbar--action" :aria-label="t('refresh')" :data-tooltip="t('refresh')" @click="refresh" v-html="renderIcon('ph:bold/arrows-clockwise')"></button>
            </div>
            {#- What the page adds: an upload, a new folder, a deletion — given
                the folder shown and what is selected. -#}
            <div v-if="$slots.actions" class="toolbar--group file-explorer--actions">
                <slot name="actions" :folder="currentFolder()" :selected="selectedItems"></slot>
            </div>
        </div>

        {#- The folders and the listing are two regions of one split: the
            folders a column the reader may widen, the listing the rest. -#}
        <div class="zone zone--split file-explorer--body">
            <div v-if="showTree" class="zone zone--narrow file-explorer--tree" :class="{ 'zone--panel': !framed }">
                {#- What scrolls is inside: the handle stays on the edge of the
                    column however far down the folders go. -#}
                <div class="file-explorer--tree-scroll">
                <tree
                        :key="treeGeneration"
                        :items="rootDirectories"
                        :row-components="{ directory: 'tree-row-directory' }"
                        :load-children="loadDirectories"
                        :state-id="treeStateId"
                        :item-key="(item) => item.path"
                        @select="onTreeSelect"
                ></tree>
                </div>
                <zone-resizer></zone-resizer>
            </div>

            <div ref="main" class="zone file-explorer--main" :class="{ 'zone--panel': !framed }" tabindex="0" @keydown="onKeyDown">
                <div v-if="loading && !items.length" class="file-explorer--state">
                    <spinner size="sm" :label="t('loading')"></spinner>
                </div>
                <div v-else-if="failed" class="empty">[[ t('failed') ]]</div>
                <div v-else-if="!shownItems.length" class="empty">[[ filter ? t('empty_filtered') : t('empty') ]]</div>

                {#- A list, read across: what it is, then its kind, size and date,
                    each column sorted by its heading. -#}
                <div v-else-if="view === 'list'" class="file-explorer--list" role="grid" :aria-busy="loading ? 'true' : null">
                    <div class="file-explorer--head" role="row">
                        <span v-for="column in ['name', 'kind', 'size', 'modifiedAt']"
                              :key="column"
                              role="columnheader"
                              class="file-explorer--heading"
                              :class="'file-explorer--heading--' + column"
                              :aria-sort="sort.key === column ? (sort.direction > 0 ? 'ascending' : 'descending') : null">
                            <button type="button" class="table--sort" :class="{ 'is-active': sort.key === column }" @click="sortBy(column)">
                                <span>[[ t('column.' + column) ]]</span>
                                <span class="table--sort-icon" aria-hidden="true" v-html="renderIcon(sortIcon(column))"></span>
                            </button>
                        </span>
                    </div>
                    <div v-for="(item, index) in shownItems"
                         :key="itemKey(item)"
                         role="row"
                         class="file-explorer--row file-explorer--cell"
                         :class="{ 'is-selected': isSelected(item), 'is-cursor': index === cursorIndex }"
                         :aria-selected="isSelected(item) ? 'true' : 'false'"
                         @click="select(index, $event)"
                         @dblclick="open(item)">
                        <span class="file-explorer--name">
                            <span class="file-explorer--icon" :class="{ 'is-directory': isDirectory(item) }" v-html="iconHtml(item)"></span>
                            <span class="file-explorer--label" :title="item.name">[[ item.name ]]</span>
                        </span>
                        <span class="file-explorer--kind">[[ kindLabel(item) ]]</span>
                        <span class="file-explorer--size">[[ sizeLabel(item) ]]</span>
                        <span class="file-explorer--date">
                            <date-display v-if="item.modifiedAt" :value="item.modifiedAt" format="date_time_short"></date-display>
                        </span>
                    </div>
                </div>

                {#- A grid, looked over: the icon first, the name under it. -#}
                <div v-else class="disk-item-explorer file-explorer--grid" role="grid" :aria-busy="loading ? 'true' : null">
                    <div v-for="(item, index) in shownItems"
                         :key="itemKey(item)"
                         role="gridcell"
                         class="disk-item file-explorer--cell"
                         :class="[isDirectory(item) ? 'disk-item--directory' : 'disk-item--file', { 'is-selected': isSelected(item), 'is-cursor': index === cursorIndex }]"
                         :aria-selected="isSelected(item) ? 'true' : 'false'"
                         :title="item.name"
                         @click="select(index, $event)"
                         @dblclick="open(item)">
                        <img v-if="item.thumbnailUrl" class="disk-item--thumbnail" :src="item.thumbnailUrl" alt="" loading="lazy">
                        <span v-else class="disk-item--icon" :class="{ 'is-directory': isDirectory(item) }" v-html="iconHtml(item)"></span>
                        <span class="disk-item--title-ellipsis">[[ item.name ]]</span>
                    </div>
                </div>

                <div v-if="hasMore && !failed" class="file-explorer--more">
                    <button type="button" class="button button--flat button--compact" :disabled="loading" @click="loadMore">
                        <span>[[ t('more', { '%count%': total - items.length }) ]]</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="status-bar file-explorer--status">
            <span aria-live="polite">[[ status ]]</span>
            {#- What the page adds at the foot: a picker's choice. -#}
            <div v-if="$slots.status" class="status-bar--end">
                <slot name="status" :selected="selectedItems"></slot>
            </div>
        </div>
    </div>
{%- endblock -%}
