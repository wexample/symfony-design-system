{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.choice_list.*') }}
{%- endblock -%}

{%- block vue_body -%}
    {#- Client-side twin of choice-list.html.twig: same classes, same order. A
        change to either is a change to both. -#}
    <div class="choice-list">
        <div v-if="filterable" class="form--input-group form--filter form--filter--compact choice-list--filter">
            <span class="form--input-addon" aria-hidden="true" v-html="searchIconHtml"></span>
            <input
                    v-model="filterQuery"
                    class="form--input choice-list--filter-input"
                    type="search"
                    autocomplete="off"
                    :placeholder="filterLabel"
                    :aria-label="filterLabel"
            >
        </div>
        <ul class="choice-list--items" role="radiogroup" :aria-label="label || null">
            <template v-for="{ item, heading } in shownRows" :key="item.value">
            {#- A group opened: its name, above its items. -#}
            <li v-if="heading" class="choice-list--group" role="presentation">[[ heading ]]</li>
            <li class="choice-list--item">
                <button
                        type="button"
                        class="choice-list--choice"
                        role="radio"
                        :aria-checked="isChosen(item) ? 'true' : 'false'"
                        :data-value="item.value"
                        :disabled="item.disabled || null"
                        @click="choose(item)"
                >
                    <span v-if="item.icon" class="choice-list--icon" aria-hidden="true" v-html="renderIcon(item.icon)"></span>
                    <span class="choice-list--text">
                        <span class="choice-list--label">[[ item.label ]]</span>
                        <span v-if="item.description" class="choice-list--description">[[ item.description ]]</span>
                    </span>
                    <span class="choice-list--check" aria-hidden="true" v-html="checkIconHtml"></span>
                </button>
            </li>
            </template>
        </ul>
        <p v-if="filterable && !shownItems.length" class="choice-list--empty">[[ emptyLabel ]]</p>
    </div>
{%- endblock -%}
