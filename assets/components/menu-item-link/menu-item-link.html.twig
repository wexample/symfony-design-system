{% set new_window = options.new_window|default(false) %}
{% set attr = options.attr|default({}) %}
{% if new_window %}
    {% set attr = attr|merge({'target': '_blank', 'rel': 'noopener noreferrer'}) %}
{% endif %}
{#- An item is the page being read when it leads to it. A section spanning
    several addresses knows it and says so itself, since only the caller knows
    which pages are the same place. -#}
{% set active = options.active ?? (href == app.request.pathInfo) %}
<li>
    <a class="{{ options.class|default('') }}{{ active ? ' active' }}"
       href="{{ href }}"
       {{ component_render_tag_attributes(attr) }}>
        <span class="menu--item--icon">
            {{ icon(icon) }}
        </span>
        <span class="menu--item--label">{{ label | trans }}</span>
        {#- How many of whatever the item leads to, at the far end. -#}
        {%- if options.count is defined and options.count is not null -%}
            <span class="count menu--item--count">{{ options.count }}</span>
        {%- endif -%}
    </a>
</li>
