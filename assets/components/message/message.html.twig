<div class="message message--{{ type }}{% if options.compact|default(false) %} message--compact{% endif %}{% if options.class is defined %} {{ options.class }}{% endif %}"
     {{ component_render_tag_attributes(options.attr|default({})) }}>
    {% if title is not empty %}
        {# Compact states a single sentence: it reads as plain text, not as a heading. #}
        <div{% if not options.compact|default(false) %} class="message--title"{% endif %}>
            {% if options.icon is defined and options.icon %}
                {{ icon(options.icon, 'message--icon') }}
            {% endif %}
            {{ title | trans }}
        </div>
    {% endif %}
    {% if body is not empty %}
        {#- `html`: a body the caller translated and marked up itself — a path
            set in bold —, written as it is. -#}
        <p>{{ options.html|default(false) ? body|raw : body | trans }}</p>
    {% endif %}
    {#- What to do about it, when there is one thing to do: { icon, label, href }. -#}
    {% if options.action is defined and options.action %}
        <div class="message--actions">
            {#- `new_window` opens it beside the page rather than in its place. -#}
            {{ button_link(options.action.icon, options.action.label | trans, options.action.href, {
                class: 'button--flat',
                attr: options.action.new_window|default(false) ? { target: '_blank', rel: 'noopener noreferrer' } : {},
            }) }}
        </div>
    {% endif %}
</div>
