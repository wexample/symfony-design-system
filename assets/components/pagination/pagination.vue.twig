{%- extends '@WexampleSymfonyDesignSystemBundle/components/bases/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.pagination.*') }}
{%- endblock -%}

{%- block vue_body -%}
    <nav v-if="isVisible" class="pagination" :aria-label="resolvedLabel">
        <button
                type="button"
                class="pagination--control"
                :disabled="!hasPrevious || disabled"
                :aria-label="resolvedPreviousLabel"
                @click="select(page - 1)"
        >
            <span class="pagination--control--icon" aria-hidden="true">&lsaquo;</span>
            <span class="pagination--control--label">[[ resolvedPreviousLabel ]]</span>
        </button>

        <ol v-if="!isCompact" class="pagination--pages">
            <li
                    v-for="(entry, entryIndex) in visiblePages"
                    :key="`pagination-entry-${entryIndex}`"
                    class="pagination--pages--item"
            >
                <span v-if="entry === null" class="pagination--ellipsis" aria-hidden="true">
                    [[ resolvedEllipsisLabel ]]
                </span>
                <button
                        v-else
                        type="button"
                        class="pagination--number"
                        :class="{ 'pagination--number--current': entry === page }"
                        :aria-current="entry === page ? 'page' : null"
                        :aria-label="`${resolvedPageLabel} ${entry + 1}`"
                        :disabled="disabled"
                        @click="select(entry)"
                >
                    [[ entry + 1 ]]
                </button>
            </li>
        </ol>
        <span v-else class="pagination--status">[[ compactStatus ]]</span>

        <button
                type="button"
                class="pagination--control"
                :disabled="!hasNext || disabled"
                :aria-label="resolvedNextLabel"
                @click="select(page + 1)"
        >
            <span class="pagination--control--label">[[ resolvedNextLabel ]]</span>
            <span class="pagination--control--icon" aria-hidden="true">&rsaquo;</span>
        </button>
    </nav>
{%- endblock -%}
