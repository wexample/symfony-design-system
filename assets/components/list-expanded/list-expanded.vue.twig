{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.components.list-expanded.list-expanded::*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div ref="focusableRoot" class="list-expanded">
        <div v-if="showHeader" class="list-expanded--header">
            <div class="form--input-group form--filter list-expanded--search">
                <span class="form--input-addon" aria-hidden="true" v-html="searchIconHtml"></span>
                <input
                        ref="searchInput"
                        class="form--input"
                        type="search"
                        :placeholder="resolvedSearchPlaceholder"
                        :value="searchValue"
                        @input="onSearchInput"
                        @keydown.tab="onSearchTab"
                >
            </div>
            <button
                    v-if="showFilterButton"
                    type="button"
                    class="button"
                    @click="onFilterClick"
            >
                [[ resolvedFilterLabel ]]
            </button>
        </div>

        <div v-if="hasItems" ref="itemsContainer" class="list-expanded--items" @focusin="onItemFocus">
            <slot></slot>
        </div>
        <div v-else class="empty">[[ resolvedEmptyLabel ]]</div>
    </div>
{%- endblock -%}
