{#- What an item is, out of what it carries: a word and a target is a link, a
    word and a state is a toggle, a word and children is a submenu. The caller
    may say it outright with `type`; it never has to. -#}
{% macro item_type(item) %}
    {%- if item.type is defined and item.type -%}
        {{- item.type -}}
    {%- elseif item.heading is defined -%}
        heading
    {%- elseif item.separator|default(false) -%}
        separator
    {%- elseif item.items|default([])|length -%}
        submenu
    {%- elseif item.checked is defined -%}
        toggle
    {%- else -%}
        link
    {%- endif -%}
{% endmacro %}

{#- What every kind of item shows, in the same two places: what it is on the
    leading side, what qualifies it on the trailing one. A toggle spends its
    leading slot on its state — a mark and an icon on one row would be two
    things to read where the eye expects one. The mark is always drawn and only
    shown when checked: the slot keeps its width either way, so a column of
    toggles has its words aligned, and turning one on is a class and not a
    redraw — which is how both sides of the stack can flip it. -#}
{% macro row(item, type) %}
    {%- if type == 'toggle' -%}
        <span class="button-menu--item-check" aria-hidden="true">{{ icon('ph:bold/check') }}</span>
    {%- elseif item.icon|default(null) -%}
        <span class="button-menu--item-icon">{{ icon(item.icon) }}</span>
    {%- endif -%}
    <span class="button-menu--item-label">{{ item.label | trans }}</span>
    {%- if item.count is defined and item.count is not null -%}
        <span class="count button-menu--item-count">{{ item.count }}</span>
    {%- endif -%}
    {%- if item.trailing_icon|default(null) -%}
        <span class="button-menu--item-trailing">{{ icon(item.trailing_icon) }}</span>
    {%- elseif item.new_window|default(false) -%}
        {#- Opened beside the page: said at the end of the row, as the web says it. -#}
        <span class="button-menu--item-trailing" aria-hidden="true">{{ icon('ph:bold/arrow-square-out') }}</span>
    {%- elseif type == 'submenu' -%}
        <span class="button-menu--item-trailing button-menu--item-caret" aria-hidden="true"></span>
    {%- endif -%}
{% endmacro %}

{% macro item(item, depth) %}
    {% import _self as menu %}
    {% set type = menu.item_type(item)|trim %}
    {% set item_class = item.class is defined and item.class ? ' ' ~ item.class : '' %}
    {#- `tone` — a state, `dev` — colours a section's heading and its items' icons:
        what development alone shows, set apart from the product. Toggles take
        theirs on the box instead (below). -#}
    {% set tone_class = item.tone|default(null) and item.checked is not defined ? ' button-menu--tone--' ~ item.tone : '' %}
    {% set item_class = item_class ~ tone_class %}
    {% set item_attr = item.attr|default({}) %}

    {%- if type == 'heading' -%}
        {#- Who or what the menu is about, at its head: a title (`heading`), lines
            saying more of it under it (`lines`), a rule closing it. -#}
        <li class="button-menu--heading" role="presentation">
            <span class="button-menu--heading-title">{{ item.heading | trans }}</span>
            {%- for line in item.lines|default([]) -%}
                <span class="button-menu--heading-line">{{ line | trans }}</span>
            {%- endfor -%}
        </li>
        <li class="button-menu--separator" role="separator"></li>

    {%- elseif type == 'separator' -%}
        {#- Not an item but the line between two runs of them. Given a word it
            becomes the heading of what follows. -#}
        {% if item.label|default(null) %}
            <li class="button-menu--separator button-menu--separator--titled{{ tone_class }}" role="separator">{{ item.label | trans }}</li>
        {% else %}
            <li class="button-menu--separator" role="separator"></li>
        {% endif %}

    {%- elseif type == 'toggle' -%}
        {#- `box` draws the box before it is ticked, `radio` makes it round for
            a choice of one, `tone` colours it — a status, a category. -#}
        {% set item_class = item_class
            ~ (item.box|default(false) or item.radio|default(false) ? ' button-menu--toggle--box')
            ~ (item.radio|default(false) ? ' button-menu--toggle--radio')
            ~ (item.tone|default(null) ? ' button-menu--toggle--' ~ item.tone) %}
        {#- A state the reader turns on and off. It is a button and not a link
            because it goes nowhere, and the panel stays open under it: a menu
            of filters is read by the handful, not one at a time. -#}
        <li class="button-menu--item" role="none">
            {%- if item.href|default(null) -%}
                {#- A state kept in the address rather than on the page — a
                    filter of a server table: the link turns it and the page
                    comes back with it turned. -#}
                <a class="button-menu--link button-menu--toggle{{ item.checked|default(false) ? ' is-checked' }}{{ item_class }}"
                   href="{{ item.href }}"
                   role="menuitemcheckbox"
                   aria-checked="{{ item.checked|default(false) ? 'true' : 'false' }}"
                   {{ component_render_tag_attributes(item_attr) }}>
                    {{- menu.row(item, type) -}}
                </a>
            {%- else -%}
                <button type="button"
                        class="button-menu--link button-menu--toggle{{ item.checked|default(false) ? ' is-checked' }}{{ item_class }}"
                        role="menuitemcheckbox"
                        aria-checked="{{ item.checked|default(false) ? 'true' : 'false' }}"
                        {% if item.value is defined and item.value is not null %}data-value="{{ item.value }}"{% endif %}
                        {% if item.disabled|default(false) %}disabled="disabled"{% endif %}
                        {{ component_render_tag_attributes(item_attr) }}>
                    {{- menu.row(item, type) -}}
                </button>
            {%- endif -%}
        </li>

    {%- elseif type == 'submenu' -%}
        {#- A branch: the row opens what hangs under it rather than leading
            anywhere. One level deep, on purpose — a menu that needs two is a
            page. -#}
        <li class="button-menu--item button-menu--item--submenu" role="none">
            <button type="button"
                    class="button-menu--link button-menu--submenu{{ item_class }}"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    {% if item.disabled|default(false) %}disabled="disabled"{% endif %}
                    {{ component_render_tag_attributes(item_attr) }}>
                {{- menu.row(item, type) -}}
            </button>
            <ul class="button-menu--list button-menu--sublist" role="menu">
                {% for child in item.items %}
                    {{ menu.item(child, depth + 1) }}
                {% endfor %}
            </ul>
        </li>

    {%- else -%}
        {% if item.new_window|default(false) %}
            {% set item_attr = item_attr|merge({'target': '_blank', 'rel': 'noopener noreferrer'}) %}
        {% endif %}
        {% set item_href = item.href|default(null) %}
        {% if item_href is empty %}
            {% if item.route is defined and item.route %}
                {% set item_href = path(item.route, item.route_params|default({})) %}
            {% else %}
                {% set item_href = '#' %}
            {% endif %}
        {% endif %}
        {#- An action and not a page: `method: 'post'` sends a form to the
            address, with its `token`, and asks first when it says `confirm:
            { title, message, accept }` — as a row action of a table does. -#}
        {% if item.method|default('get')|lower == 'post' %}
        {% set confirm = item.confirm|default(null) %}
        <li class="button-menu--item" role="none">
            <form class="button-menu--form" method="post" action="{{ item_href }}"
                  {%- if item.request|default(null) %} data-request="{{ item.request }}"{% endif %}
                  {#- `busy`: the answer is a whole new page, slow to come — the
                      window is held under a spinner meanwhile; a string says
                      what is being done. -#}
                  {%- if item.busy|default(false) %} data-busy="{{ item.busy is same as(true) ? '' : item.busy }}"{% endif %}
                  {%- if confirm %} data-confirm-message="{{ confirm.message }}"{% if confirm.title is defined %} data-confirm-title="{{ confirm.title }}"{% endif %}{% if confirm.accept is defined %} data-confirm-accept="{{ confirm.accept }}"{% endif %}{% endif %}>
                {%- if item.token|default(null) -%}
                    <input type="hidden" name="_token" value="{{ item.token }}">
                {%- endif -%}
                <button type="submit" class="button-menu--link{{ item_class }}" role="menuitem"
                        {{ component_render_tag_attributes(item_attr) }}>
                    {{- menu.row(item, type) -}}
                </button>
            </form>
        </li>
        {% elseif item.disabled|default(false) %}
        {#- Out of reach for now — not gone: the row stays where it is, said
            unavailable, and leads nowhere. -#}
        <li class="button-menu--item" role="none">
            <button type="button" class="button-menu--link{{ item_class }}" role="menuitem"
                    disabled="disabled" aria-disabled="true"
                    {{ component_render_tag_attributes(item_attr) }}>
                {{- menu.row(item, type) -}}
            </button>
        </li>
        {% else %}
        {#- `target` — panel, modal — opens the page there rather than in
            place, as a target button does; a modified click still goes. -#}
        <li class="button-menu--item" role="none">
            <a class="button-menu--link{{ item_class }}"
               href="{{ item_href }}"
               role="menuitem"
               {% if item.target|default(null) %}data-target="{{ item.target }}"{% endif %}
               {{ component_render_tag_attributes(item_attr) }}>
                {{- menu.row(item, type) -}}
            </a>
        </li>
        {% endif %}
    {%- endif -%}
{% endmacro %}

{% import _self as menu %}
{% set menu_align = options.menu_align|default('left') %}
{% set menu_vertical = options.menu_vertical|default('bottom') %}
{% set items_align = options.items_align|default('left') %}
{% set wrapper_class = options.wrapper_class|default('') %}
{% set wrapper_attr = options.wrapper_attr|default({}) %}
{% set button_attr = options.attr|default({}) %}
{#- A menu that asks for it with `filter_from` is read by looking for one:
    from that many items the panel scrolls under a field that narrows it — a
    list of languages, not a toolbar's handful of actions. Off unless asked. -#}
{% set filter_from = options.filter_from ?? 0 %}
{% set filterable = filter_from > 0 and items|filter(entry => not (entry.separator|default(false)))|length >= filter_from %}
{#- Given an `action` — `{ href }`, or `{ type: 'submit' }` in a form — the
    button is split: its body does the action, a caret stuck to its end opens
    the menu, and only the caret does. -#}
{% set action = options.action|default(null) %}
<div class="button-menu{% if action %} button-menu--split{% endif %}{% if wrapper_class %} {{ wrapper_class }}{% endif %}"
     {{ component_render_tag_attributes(wrapper_attr) }}>
    {%- if action -%}
        {%- set action_class = 'button button-menu--action' ~ (options.class is defined ? ' ' ~ options.class : '') -%}
        {%- set more_label = 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.more'|trans -%}
        <div class="button-menu--split-group">
            {%- if action.href|default(null) -%}
                <a class="{{ action_class }}" href="{{ action.href }}" {{ component_render_tag_attributes(action.attr|default({})) }}>
            {%- else -%}
                <button class="{{ action_class }}" type="{{ action.type|default('button') }}" {{ component_render_tag_attributes(action.attr|default({})) }}>
            {%- endif -%}
                {%- if icon -%}<span class="button--icon">{{ icon(icon) }}</span>{%- endif -%}
                {%- if label -%}<span class="button-menu--label">{{ label }}</span>{%- endif -%}
            {%- if action.href|default(null) -%}</a>{%- else -%}</button>{%- endif -%}
            <button class="button button--menu button-menu--split-toggle{% if options.class is defined %} {{ options.class }}{% endif %}"
                    type="button"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-label="{{ more_label }}"
                    title="{{ more_label }}">
                <span class="button-menu--caret" aria-hidden="true"></span>
            </button>
        </div>
    {%- else -%}
        <button class="button button--menu{% if options.class is defined %} {{ options.class }}{% endif %}"
                type="{{ options.type|default('button') }}"
                aria-haspopup="menu"
                aria-expanded="false"
                {{ component_render_tag_attributes(button_attr) }}>
            {#- `trigger` — markup — is the button's whole face: a marker that
                opens a menu. `avatar` — initials — stands for a person: the
                menu of their account, opened from their face rather than from
                a word. -#}
            {%- if options.trigger|default(null) -%}
                {{- options.trigger|raw -}}
            {%- elseif options.avatar|default(null) -%}
                <span class="avatar button-menu--avatar" aria-hidden="true">{{ options.avatar }}</span>
            {%- elseif icon -%}
                <span class="button--icon">
                    {{ icon(icon) }}
                </span>
            {%- endif -%}
            {%- if label -%}
                <span class="button-menu--label">{{ label }}</span>
            {%- endif -%}
            {#- An icon on its own says it opens something by what it is — a caret
                beside it is noise. Anything with a word keeps one. -#}
            {%- if options.caret|default(label is not empty and not options.avatar|default(null) and not options.trigger|default(null)) -%}
                <span class="button-menu--caret" aria-hidden="true"></span>
            {%- endif -%}
        </button>
    {%- endif -%}
    <div class="button-menu--panel button-menu--panel--{{ menu_align }}{% if menu_vertical == 'top' %} button-menu--panel--top{% endif %}{% if filterable %} button-menu--panel--long{% endif %}"
         role="menu"
         hidden="hidden">
        {%- if filterable -%}
            {%- set filter_label = 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.filter'|trans -%}
            <div class="button-menu--filter">
                <input class="button-menu--filter-input" type="search" autocomplete="off"
                       placeholder="{{ filter_label }}" aria-label="{{ filter_label }}">
            </div>
        {%- endif -%}
        <ul class="button-menu--list button-menu--list--items-{{ items_align }}">
            {% for item in items %}
                {{ menu.item(item, 0) }}
            {% endfor %}
        </ul>
        {%- if filterable -%}
            <p class="button-menu--filter-empty" hidden>{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.filter_empty'|trans }}</p>
        {%- endif -%}
    </div>
</div>
