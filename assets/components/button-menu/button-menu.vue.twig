{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.*') }}
{%- endblock -%}

{%- block vue_body -%}
    {#- Client-side twin of components/button-menu.html.twig: same markup, same
        classes, same item shapes. A change to either is a change to both. -#}
    <div :class="wrapperClasses">
        {#- Split: the body does the action, the caret opens the menu. -#}
        <div v-if="action" ref="group" class="button-menu--split-group">
            <component
                    :is="action.href ? 'a' : 'button'"
                    :class="['button', 'button-menu--action', buttonClass]"
                    :href="action.href || null"
                    :type="action.href ? null : (action.type || 'button')"
                    @click="onAction"
            >
                <span v-if="iconHtml" class="button--icon" v-html="iconHtml"></span>
                <span v-if="label" class="button-menu--label">[[ label ]]</span>
            </component>
            <button
                    ref="button"
                    :class="['button', 'button--menu', 'button-menu--split-toggle', buttonClass]"
                    type="button"
                    aria-haspopup="menu"
                    :aria-expanded="isOpen ? 'true' : 'false'"
                    :aria-label="trans('@vue::menu.more')"
                    :title="trans('@vue::menu.more')"
                    @click.prevent="toggle"
            >
                <span class="button-menu--caret" aria-hidden="true"></span>
            </button>
        </div>
        <button
                v-else
                ref="button"
                :class="buttonClasses"
                type="button"
                aria-haspopup="menu"
                :aria-expanded="isOpen ? 'true' : 'false'"
                @click.prevent="toggle"
        >
            <span v-if="avatar" class="avatar button-menu--avatar" aria-hidden="true">[[ avatar ]]</span>
            <span v-else-if="iconHtml" class="button--icon" v-html="iconHtml"></span>
            <span v-if="label" class="button-menu--label">[[ label ]]</span>
            <span v-if="hasCaret" class="button-menu--caret" aria-hidden="true"></span>
        </button>
        <div
                ref="panel"
                :class="panelClasses"
                role="menu"
                :hidden="!isOpen"
        >
            <div v-if="filterable" class="button-menu--filter">
                <input
                        ref="filter"
                        v-model="filterQuery"
                        class="button-menu--filter-input"
                        type="search"
                        autocomplete="off"
                        :placeholder="trans('@vue::menu.filter')"
                        :aria-label="trans('@vue::menu.filter')"
                        @keydown.enter.prevent="followFirstVisible"
                >
            </div>
            <ul :class="listClasses">
                <template v-for="(item, index) in items" :key="index">
                    {#- Not an item but the line between two runs of them. Given a
                        word it becomes the heading of what follows. -#}
                    <li
                            v-if="itemType(item) === 'separator'"
                            v-show="!filterQuery.trim()"
                            class="button-menu--separator"
                            :class="{ 'button-menu--separator--titled': item.label }"
                            role="separator"
                    >[[ item.label ]]</li>
                    <li v-else v-show="itemVisible(item)" :class="itemClasses(item, index)" role="none">
                        {#- One row for the three kinds: a link goes somewhere and
                            is an anchor, a toggle and a branch go nowhere and are
                            buttons. -#}
                        <component
                                :is="itemTag(item)"
                                :class="linkClasses(item)"
                                :href="isAnchor(item) ? itemHref(item) : null"
                                :type="isAnchor(item) ? null : 'button'"
                                :role="itemRole(item)"
                                :aria-checked="itemType(item) === 'toggle' ? (item.checked ? 'true' : 'false') : null"
                                :aria-haspopup="itemType(item) === 'submenu' ? 'menu' : null"
                                :aria-expanded="itemType(item) === 'submenu' ? (openSubmenu === index ? 'true' : 'false') : null"
                                :disabled="item.disabled || null"
                                v-bind="itemAttributes(item)"
                                @click="onItemClick(item, index, $event)"
                                @mouseenter="itemType(item) === 'submenu' ? placeSubmenu($event) : null"
                        >
                            <span
                                    v-if="itemType(item) === 'toggle'"
                                    class="button-menu--item-check"
                                    aria-hidden="true"
                                    v-html="checkGlyph"
                            ></span>
                            <span
                                    v-else-if="item.icon"
                                    class="button-menu--item-icon"
                                    v-html="renderIcon(item.icon)"
                            ></span>
                            <span class="button-menu--item-label">[[ item.label ]]</span>
                            <span
                                    v-if="item.count !== undefined && item.count !== null"
                                    class="count button-menu--item-count"
                            >[[ item.count ]]</span>
                            <span
                                    v-if="item.trailingIcon"
                                    class="button-menu--item-trailing"
                                    v-html="renderIcon(item.trailingIcon)"
                            ></span>
                            <span
                                    v-else-if="itemType(item) === 'submenu'"
                                    class="button-menu--item-trailing button-menu--item-caret"
                                    aria-hidden="true"
                            ></span>
                        </component>
                        {#- One level deep, on purpose — a menu that needs two is
                            a page. -#}
                        <ul
                                v-if="itemType(item) === 'submenu'"
                                class="button-menu--list button-menu--sublist"
                                role="menu"
                        >
                            <template v-for="(child, childIndex) in item.items" :key="childIndex">
                                <li
                                        v-if="itemType(child) === 'separator'"
                                        class="button-menu--separator"
                                        :class="{ 'button-menu--separator--titled': child.label }"
                                        role="separator"
                                >[[ child.label ]]</li>
                                <li v-else class="button-menu--item" role="none">
                                    <component
                                            :is="itemTag(child)"
                                            :class="linkClasses(child)"
                                            :href="isAnchor(child) ? itemHref(child) : null"
                                            :type="isAnchor(child) ? null : 'button'"
                                            :role="itemRole(child)"
                                            :aria-checked="itemType(child) === 'toggle' ? (child.checked ? 'true' : 'false') : null"
                                            :disabled="child.disabled || null"
                                            v-bind="itemAttributes(child)"
                                            @click="onItemClick(child, null, $event)"
                                    >
                                        <span
                                                v-if="itemType(child) === 'toggle'"
                                                class="button-menu--item-check"
                                                aria-hidden="true"
                                                v-html="checkGlyph"
                                        ></span>
                                        <span
                                                v-else-if="child.icon"
                                                class="button-menu--item-icon"
                                                v-html="renderIcon(child.icon)"
                                        ></span>
                                        <span class="button-menu--item-label">[[ child.label ]]</span>
                                        <span
                                                v-if="child.count !== undefined && child.count !== null"
                                                class="count button-menu--item-count"
                                        >[[ child.count ]]</span>
                                        <span
                                                v-if="child.trailingIcon"
                                                class="button-menu--item-trailing"
                                                v-html="renderIcon(child.trailingIcon)"
                                        ></span>
                                    </component>
                                </li>
                            </template>
                        </ul>
                    </li>
                </template>
            </ul>
            <p v-if="filterable && !anyVisible" class="button-menu--filter-empty">[[ trans('@vue::menu.filter_empty') ]]</p>
        </div>
    </div>
{%- endblock -%}
