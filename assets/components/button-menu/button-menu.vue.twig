{%- extends '@WexampleSymfonyDesignSystemBundle/components/bases/vue/vue.vue.twig' -%}

{%- block vue_body -%}
    {#- Client-side twin of components/button-menu.html.twig: same markup, same
        classes. A change to either is a change to both. -#}
    <div :class="wrapperClasses">
        <button
                ref="button"
                :class="buttonClasses"
                type="button"
                aria-haspopup="menu"
                :aria-expanded="isOpen ? 'true' : 'false'"
                @click.prevent="toggle"
        >
            <span v-if="iconHtml" class="button--icon" v-html="iconHtml"></span>
            <span v-if="label" class="button-menu--label">[[ label ]]</span>
            <span v-if="hasCaret" class="button-menu--caret" aria-hidden="true"></span>
        </button>
        <div
                ref="panel"
                :class="panelClasses"
                role="menu"
                :hidden="!isOpen"
        >
            <ul :class="listClasses">
                <template v-for="(item, index) in items" :key="index">
                    {#- Not an item but the line between two runs of them. Given a
                        word it becomes the heading of what follows. -#}
                    <li
                            v-if="item.separator"
                            class="button-menu--separator"
                            :class="{ 'button-menu--separator--titled': item.label }"
                            role="separator"
                    >[[ item.label ]]</li>
                    <li v-else class="button-menu--item" role="none">
                    <a
                            class="button-menu--link"
                            :class="item.class"
                            :href="itemHref(item)"
                            role="menuitem"
                            v-bind="itemAttributes(item)"
                            @click="onItemClick(item, $event)"
                    >
                        <span
                                v-if="item.icon"
                                class="button-menu--item-icon"
                                v-html="renderIcon(item.icon)"
                        ></span>
                        <span class="button-menu--item-label">[[ item.label ]]</span>
                        <span
                                v-if="item.count !== undefined && item.count !== null"
                                class="pill button-menu--item-count"
                        >[[ item.count ]]</span>
                    </a>
                    </li>
                </template>
            </ul>
        </div>
    </div>
{%- endblock -%}
