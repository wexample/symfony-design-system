{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_body -%}
    {#- Views picked in place: a list of tabs, the one shown selected, the
        arrows moving from one to the next (the server bar's tabs are routes,
        links of a navigation: tab-item). -#}
    <div class="tabs" :class="resolvedTabsClass" role="tablist" @keydown="onKeydown">
        {#- Shown once the bar scrolls (TabsHelper), each at its end. -#}
        <button type="button" class="tabs--arrow tabs--arrow--start" tabindex="-1" aria-hidden="true" @click="scrollTabs(-1)">{{ icon('ph:bold/caret-left') }}</button>
        <a
                v-for="item in resolvedItems"
                :key="item.key"
                href="#"
                class="tabs--item"
                :class="{ 'tabs--item--active': isActive(item) }"
                role="tab"
                :aria-selected="isActive(item) ? 'true' : 'false'"
                :tabindex="isActive(item) ? 0 : -1"
                :aria-disabled="item.disabled ? 'true' : null"
                @click="onClickTab($event, item)"
        >
            <span class="tabs--item-content">
                <span
                        v-if="item.icon"
                        class="tabs--item-icon"
                        v-html="getItemIcon(item)"
                ></span>
                <span class="tabs--item-label">[[ item.label ]]</span>
                <span
                        v-if="item.count !== undefined && item.count !== null"
                        class="count tabs--item-count"
                >[[ item.count ]]</span>
            </span>
        </a>
        <button type="button" class="tabs--arrow tabs--arrow--end" tabindex="-1" aria-hidden="true" @click="scrollTabs(1)">{{ icon('ph:bold/caret-right') }}</button>
    </div>
{%- endblock -%}
