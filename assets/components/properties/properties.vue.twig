{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/identifier') -}}
{%- endblock -%}

{%- block vue_body -%}
    {#- Client-side twin of properties.html.twig: same classes, same reading of
        an empty value. A change to either is a change to both. -#}
    <dl :class="listClass">
        <div v-for="(item, index) in items" :key="index" :class="rowClass(item)">
            <dt class="properties--key">[[ item.key ]]</dt>
            <dd v-if="isEmpty(item)" class="properties--value properties--value--empty">&mdash;</dd>
            <dd v-else class="properties--value" :class="valueClass(item)">
                {#- An identifier that acts — an id leading to its record —: read
                    as one, pressed as a link. -#}
                <button v-if="item.code && item.onClick" type="button" class="properties--link" @click="item.onClick(item)">
                    <identifier :value="item.value" :short="item.short || false"></identifier>
                </button>
                <identifier v-else-if="item.code" :value="item.value" :short="item.short || false" :copy="item.copy || false"></identifier>
                <span v-else-if="item.html" v-html="item.value"></span>
                <a v-else-if="item.href" class="properties--link" :href="item.href">[[ item.value ]]</a>
                <button v-else-if="item.onClick" type="button" class="properties--link" @click="item.onClick(item)">[[ item.value ]]</button>
                <template v-else>[[ item.value ]]</template>
            </dd>
        </div>
    </dl>
{%- endblock -%}
