<div class="switch color-scheme-switch" data-checked="{{ render_pass.usages['color_scheme']|default('light') != 'dark' ? 'true' : 'false' }}">
    <span class="switch--pill">
        <span class="switch--knob"></span>
        <span class="switch--inner switch--off-inner">{{ icon('ph:bold/moon') }}</span>
        <span class="switch--inner switch--on-inner">{{ icon('ph:bold/sun') }}</span>
    </span>
    <span class="switch--label">{{ label | default('@component::label' | trans) }}</span>
</div>
