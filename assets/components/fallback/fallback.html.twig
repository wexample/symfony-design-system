{#- The other way, when the first one fails: the question, then what to do
    instead — a value, copied in one click, or a link. Standing right under
    what it stands in for, and aligned with it. -#}
<div class="fallback{{ center|default(false) ? ' fallback--center' }}{% if class|default('') %} {{ class }}{% endif %}">
    <span class="fallback--question">{{ question | trans }}</span>
    {%- if href|default(null) -%}
        <a class="fallback--value" href="{{ href }}">{{ value | trans }}</a>
    {%- else -%}
        <span class="fallback--value">
            <code class="fallback--code">{{ value }}</code>
            {%- if copy|default(true) -%}
                {{ copy_button({ value: value }) }}
            {%- endif -%}
        </span>
    {%- endif -%}
</div>
