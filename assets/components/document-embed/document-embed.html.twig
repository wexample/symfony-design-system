{#- The frame, and above it a bar holding what the application does with
    the document — open it elsewhere, download it from its own route,
    regenerate it —, which a browser's viewer hides once its frame is narrow,
    and would cover were they laid over it. Each action is an icon, its label
    its tooltip: { icon, label, href, target?, download?, new_window? }. -#}
<div class="{{ class }}">
    {%- if actions -%}
        <div class="toolbar toolbar--compact document-embed--toolbar">
            <div class="toolbar--group">
                {%- for action in actions -%}
                    {%- set action_label = action.label | trans -%}
                    {%- set action_attr = { 'aria-label': action_label, 'data-tooltip': action_label } -%}
                    {%- if action.target|default(null) -%}
                        {#- Opened where a target button would — `panel`, `modal`. -#}
                        {{ button_target(action.icon, '', action.href, action.target, { link: true, class: 'action-icon', attr: action_attr }) }}
                    {%- else -%}
                        <a class="action-icon" href="{{ action.href }}"
                           {%- if action.download|default(false) %} download{% endif -%}
                           {%- if action.new_window|default(false) %} target="_blank" rel="noopener"{% endif %}
                           {{ component_render_tag_attributes(action_attr) }}>{{ icon(action.icon) }}</a>
                    {%- endif -%}
                {%- endfor -%}
            </div>
        </div>
    {%- endif -%}
    <div class="{{ frame_class }}">
        <iframe src="{{ src }}" title="{{ title }}" loading="{{ loading }}"></iframe>
    </div>
</div>
