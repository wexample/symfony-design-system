{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/button-target') -}}
{%- endblock -%}

{%- block vue_body -%}
    {# Client-side twin of components/document-embed.html.twig: same options,
       same markup. A change to either is a change to both. #}
    <div :class="wrapperClass">
        <div v-if="actions.length" class="toolbar toolbar--compact document-embed--toolbar">
            <div class="toolbar--group">
                <template v-for="action in actions" :key="action.href">
                    <button-target
                            v-if="action.target"
                            :app="app"
                            :href="action.href"
                            :target="action.target"
                            :icon="action.icon"
                            class-name="action-icon"
                            :aria-label="action.label"
                            :data-tooltip="action.label"
                    ></button-target>
                    <a
                            v-else
                            class="action-icon"
                            :href="action.href"
                            :download="action.download ? '' : null"
                            :target="action.new_window ? '_blank' : null"
                            :rel="action.new_window ? 'noopener' : null"
                            :aria-label="action.label"
                            :data-tooltip="action.label"
                            v-html="renderIcon(action.icon)"
                    ></a>
                </template>
            </div>
        </div>
        <div :class="frameClass">
            <iframe :src="src" :title="title" :loading="loading"></iframe>
        </div>
    </div>
{%- endblock -%}
