{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.zone.*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/button-menu') -}}
{%- endblock -%}

{%- block vue_body -%}
    <div
            v-if="isSplit"
            ref="split"
            class="zone zone--split zone-tiling--split"
            :class="{ 'zone--split--vertical': isVertical }"
    >
        <div
                v-for="(child, index) in node.children"
                :key="child.id"
                class="zone zone-tiling--cell"
                :style="cellStyle(child)"
        >
            <zone-tiling-node :node="child">
                <template #zone="scope"><slot name="zone" v-bind="scope"></slot></template>
            </zone-tiling-node>
            <div
                    v-if="index < node.children.length - 1"
                    class="zone-resizer zone-resizer--end"
                    :class="{ 'zone-resizer--y': isVertical }"
                    role="separator"
                    tabindex="0"
                    :aria-orientation="isVertical ? 'horizontal' : 'vertical'"
                    :title="trans('@vue::zone.resize')"
                    @pointerdown="onSeamDown(index, $event)"
                    @keydown="onSeamKey(index, $event)"
                    @dblclick="onSeamReset(index)"
            ></div>
        </div>
    </div>
    <div v-else class="zone zone--panel zone-tiling--zone" :data-zone-id="node.id">
        {#- What the zone shows: the page's. Nothing given, the zone says it is
            empty. -#}
        <slot name="zone" :zone="node" :tiling="zoneTiling">
            <div class="empty zone-tiling--empty">[[ trans('@vue::zone.empty') ]]</div>
        </slot>
        {#- Its menu, in its corner while the pointer is over it. -#}
        <div class="zone-tiling--tools">
            <button-menu
                    icon="ph:bold/gear-six"
                    :items="menuItems"
                    menu-align="end"
                    button-class="action-icon"
                    :caret="false"
                    @select="zoneTiling.onMenuSelect(node, $event)"
            ></button-menu>
        </div>
    </div>
{%- endblock -%}
