{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.zone.*') }}
{%- endblock -%}

{%- block vue_body -%}
    <div class="zone zone-tiling--node">
        {#- A bar over the node — a section, or a zone —, what it holds the
            page's (`toolbar` slot): set on the node (`toolbar`), it holds for
            everything under it. -#}
        <div v-if="hasBar" class="zone--panel toolbar toolbar--shaded toolbar--compact zone-tiling--bar">
            <slot name="toolbar" :node="node" :tiling="zoneTiling"></slot>
        </div>
        <div
                v-if="isSplit"
                ref="split"
                class="zone zone--split zone-tiling--split"
                :class="{ 'zone--split--vertical': isVertical }"
        >
            <div
                    v-for="(child, index) in node.children"
                    :key="child.id"
                    class="zone zone-tiling--cell"
                    :style="cellStyle(child)"
            >
                <zone-tiling-node :node="child">
                    <template #zone="scope"><slot name="zone" v-bind="scope"></slot></template>
                <template #toolbar="scope"><slot name="toolbar" v-bind="scope"></slot></template>
                </zone-tiling-node>
                <div
                        v-if="index < node.children.length - 1"
                        class="zone-resizer zone-resizer--end"
                        :class="{ 'zone-resizer--y': isVertical }"
                        role="separator"
                        tabindex="0"
                        :aria-orientation="isVertical ? 'horizontal' : 'vertical'"
                        :title="trans('WexampleSymfonyDesignSystemBundle.common.system::frontend.zone.resize')"
                        @pointerdown="onSeamDown(index, $event)"
                        @keydown="onSeamKey(index, $event)"
                        @dblclick="onSeamReset(index)"
                ></div>
            </div>
        </div>
        <div v-else class="zone zone--panel zone-tiling--zone" :class="{ 'is-editing': zoneTiling.editing }" :data-zone-id="node.id">
            {#- What the zone shows: the page's. Nothing given, the zone says it is
                empty. Hidden while the screen is being arranged, not unmounted:
                what it shows keeps its state. -#}
            <div v-show="!zoneTiling.editing" class="zone-tiling--content">
                <slot name="zone" :zone="node" :tiling="zoneTiling">
                    <div class="empty zone-tiling--empty">[[ trans('WexampleSymfonyDesignSystemBundle.common.system::frontend.zone.empty') ]]</div>
                </slot>
            </div>
            {#- The screen being arranged: what the zone is, and what can be done
                to it, in its middle. -#}
            <div v-if="zoneTiling.editing" class="zone-tiling--edit">
                <p v-if="label" class="zone-tiling--edit-label">[[ label ]]</p>
                <div class="zone-tiling--edit-actions">
                    <template v-for="(item, index) in menuItems" :key="item.value || index">
                        <button
                                v-if="!item.separator"
                                type="button"
                                class="button button--compact"
                                @click="zoneTiling.onMenuSelect(node, item)"
                        >
                            <span v-if="item.icon" class="button--icon" v-html="renderIcon(item.icon)"></span>
                            <span>[[ item.label ]]</span>
                        </button>
                    </template>
                </div>
            </div>
        </div>
    </div>
{%- endblock -%}
