{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block field_label -%}
    <label v-if="hasLabel" class="form--label" :for="resolvedId">[[ resolveLabel(label) ]]</label>
{%- endblock -%}

{%- block field_control -%}{%- endblock -%}

{%- block field_errors -%}
    <div class="form--field-errors" v-if="hasErrors">
        <ul>
            <li v-for="(error, index) in resolvedErrors" :key="index">
                <template v-if="hasErrorTranslationPrefix">
                    [[ trans(errorTranslationPrefix + error) ]]
                </template>
                <template v-else>
                    [[ error ]]
                </template>
            </li>
        </ul>
    </div>
{%- endblock -%}

{%- block field_help -%}
    <div class="form--help" v-if="help">[[ help ]]</div>
{%- endblock -%}

{%- block vue_body -%}
    {#- Inert while assisted: the whole group stops answering to the keyboard and
        the pointer, rather than each control being locked one by one. -#}
    <div
            class="form--group"
            :class="{ 'has-error': hasErrors, 'is-disabled': controllerDisabled, 'is-assisted': isAssisted }"
            :inert="isAssisted ? true : null"
    >
        {{ block('field_label') }}
        {{ block('field_control') }}
        {{ block('field_errors') }}
        {{ block('field_help') }}
    </div>
{%- endblock -%}
