{#- `prefix` and `suffix`: a fixed word beside the value — a unit, a currency —
    shown in the field's frame, read with the field, never submitted. -#}
{%- set prefix = prefix|default(null) -%}
{%- set suffix = suffix|default(null) -%}
{%- set described_by = [prefix ? id ~ '-prefix', suffix ? id ~ '-suffix']|filter(entry => entry) -%}
<div {{ component_render_tag_attributes({class:'form--group'}) }}>
    <label class="form--label" for="{{ id }}">{{ label }}</label>
    {%- if described_by is not empty %}
    <div class="form--input-group">
        {%- if prefix %}<span class="form--input-addon" id="{{ id }}-prefix">{{ prefix }}</span>{% endif -%}
    {%- endif %}
    <input
        class="form--input"
        id="{{ id }}"
        type="{{ type|default('text') }}"
        {% if name is defined %}name="{{ name }}"{% endif %}
        {% if required is defined and required %}required{% endif %}
        {% if value is defined and value_attr is not defined %}value="{{ value }}"{% endif %}
        {% if value_attr is defined %}{{ value_attr|raw }}{% endif %}
        {% if input_attr is defined %}{{ input_attr|raw }}{% endif %}
        {% if placeholder is defined %}placeholder="{{ placeholder }}"{% endif %}
        {% if described_by is not empty %}aria-describedby="{{ described_by|join(' ') }}"{% endif %}
    >
    {%- if described_by is not empty %}
        {%- if suffix %}<span class="form--input-addon" id="{{ id }}-suffix">{{ suffix }}</span>{% endif -%}
    </div>
    {%- endif %}
</div>
