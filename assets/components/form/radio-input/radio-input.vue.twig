{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/form-field/form-field.vue.twig' -%}

{#- The label names the group: no single control stands for it. -#}
{%- block field_label -%}
    <label v-if="hasLabel" class="form--label" :id="resolvedId + '-label'">[[ resolveLabel(label) ]]</label>
{%- endblock -%}

{%- block field_control -%}
    <div
            class="radio-group"
            :class="{ 'radio-group--segmented': segmented }"
            role="radiogroup"
            :aria-labelledby="hasLabel ? resolvedId + '-label' : null"
    >
        <div
                v-for="(option, index) in options"
                :key="index"
                class="radio-option"
        >
            <input
                    class="form--radio"
                    type="radio"
                    :id="resolveOptionId(index)"
                    :name="name || null"
                    :value="resolveOptionValue(option)"
                    :checked="modelValue === resolveOptionValue(option)"
                    :disabled="disabled ? true : null"
                    @change="onChange(resolveOptionValue(option))"
            >
            <label
                    class="form--radio-label"
                    :for="resolveOptionId(index)"
            >[[ resolveOptionLabel(option) ]]</label>
        </div>
    </div>
{%- endblock -%}
