<button
    {{ component_render_tag_attributes({class: 'button' ~ (primary is defined and primary ? ' button--invert' : '')}) }}
    type="submit"
    {% if name is defined %}name="{{ name }}"{% endif %}
    {% if id is defined %}id="{{ id }}"{% endif %}
    {% if value is defined and value != '' %}value="{{ value }}"{% endif %}
    {#- Standing outside the form it sends — in a card's or a modal's foot. -#}
    {% if target_form is defined and target_form %}form="{{ target_form }}"{% endif %}
>
    <span class="button--icon">
        {{ icon(icon is defined and icon ? icon : 'ph:bold/paper-plane-tilt') }}
    </span>
    <span class="button--spinner" aria-hidden="true">
        {% include '@WexampleSymfonyDesignSystemBundle/components/spinner/spinner.html.twig' with { align: 'inline' } only %}
    </span>
    <span>{% if label is defined %}{{ label }}{% endif %}</span>
</button>
