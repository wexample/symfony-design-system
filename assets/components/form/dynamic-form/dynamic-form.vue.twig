{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/form/form.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.form.*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/dynamic-field') -}}
{%- endblock -%}

{#- What the processor refused of the form as a whole, said in words already:
    the answer carries its translations. -#}
{%- block form_errors -%}
    <div class="form--errors" v-if="formErrors && formErrors.length">
        <ul>
            <li v-for="(error, index) in formErrors" :key="index">[[ error ]]</li>
        </ul>
    </div>
{%- endblock -%}

{#- Each field by its kind, its label and its limits the form's; the errors
    reach each by the name it is registered under, through the form's
    controller. -#}
{%- block form_body -%}
    <div class="dynamic-form" :class="layoutClass">
        {#- A cell per field: what spans the line spans it whole. -#}
        <div v-for="field in shownFields" :key="field.name" class="dynamic-form--cell" :class="{ 'form--span': field.span }">
            <dynamic-field
                    :field="field"
                    v-model="draft[field.name]"
                    :name="fullName(field)"
                    :errors-of="getFieldErrors"
                    :readonly="readonly"
                    :draft="draft"
            ></dynamic-field>
        </div>
        <div v-if="!readonly" class="form--actions">
            <button type="submit" class="button button--invert" :disabled="formIsSubmitting">
                <span class="button--icon">{{ icon('ph:bold/check') }}</span>[[ submitText ]]
            </button>
        </div>
    </div>
{%- endblock -%}
