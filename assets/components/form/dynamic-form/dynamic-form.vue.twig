{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/form/form.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.form.*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/text-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/textarea-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/select-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/key-value-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/tags-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/search-select-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/color-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/switch-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/checkbox-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/number-input') -}}
{%- endblock -%}

{#- What the processor refused of the form as a whole, said in words already:
    the answer carries its translations. -#}
{%- block form_errors -%}
    <div class="form--errors" v-if="formErrors && formErrors.length">
        <ul>
            <li v-for="(error, index) in formErrors" :key="index">[[ error ]]</li>
        </ul>
    </div>
{%- endblock -%}

{#- Each field by its kind, its label and its limits the form's; the errors
    reach each by the name it is registered under, through the form's
    controller. -#}
{%- block form_body -%}
    <div class="dynamic-form" :class="layoutClass">
        {#- A cell per field: what spans the line spans it whole. -#}
        <div v-for="field in shownFields" :key="field.name" class="dynamic-form--cell" :class="{ 'form--span': field.span }">
            {#- A kind the caller hands over (`fieldComponents`): drawn by its
                own component, given what any field is given. -#}
            <component
                    v-if="customField(field)"
                    :is="customField(field).component"
                                        v-model="draft[field.name]"
                    :name="fullName(field)"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :placeholder="field.placeholder || ''"
                    :required="Boolean(field.required)"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
                    v-bind="customProps(field)"
            ></component>
            <textarea-input
                    v-else-if="field.type === 'textarea' || field.type === 'code'"
                                        v-model="draft[field.name]"
                    :name="fullName(field)"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :placeholder="field.placeholder || ''"
                    :rows="field.rows || 3"
                    :required="Boolean(field.required)"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></textarea-input>
            <select-input
                    v-else-if="field.type === 'select'"
                                        v-model="draft[field.name]"
                    :name="fullName(field)"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :options="optionsOf(field)"
                    :required="Boolean(field.required)"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></select-input>
            <key-value-input
                    v-else-if="field.type === 'key_value'"
                                        v-model="draft[field.name]"
                    :name="fullName(field)"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :required="Boolean(field.required)"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></key-value-input>
            <tags-input
                    v-else-if="field.type === 'tags'"
                                        v-model="draft[field.name]"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :placeholder="field.placeholder || null"
                    :separator="field.separator || ','"
                    :suggestions="field.suggestions || []"
                    :suggestions-url="field.suggestionsUrl || null"
                    :tone="field.tone || 'neutral'"
                    :glyph="field.glyph || null"
                    :required="Boolean(field.required)"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></tags-input>
            <search-select-input
                    v-else-if="field.type === 'search_select'"
                                        v-model="draft[field.name]"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :placeholder="field.placeholder || null"
                    :options="field.options || []"
                    :options-url="field.optionsUrl || null"
                    :value-label="field.valueLabel || null"
                    :required="Boolean(field.required)"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></search-select-input>
            <color-input
                    v-else-if="field.type === 'color'"
                                        v-model="draft[field.name]"
                    :name="fullName(field)"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :swatches="field.swatches || []"
                    :required="Boolean(field.required)"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></color-input>
            {#- Yes or no, its label beside it. -#}
            <switch-input
                    v-else-if="field.type === 'switch'"
                    v-model="draft[field.name]"
                    :name="fullName(field)"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></switch-input>
            <checkbox-input
                    v-else-if="field.type === 'checkbox'"
                    v-model="draft[field.name]"
                    :name="fullName(field)"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></checkbox-input>
            {#- A number between its bounds, by its step. -#}
            <number-input
                    v-else-if="field.type === 'number'"
                    v-model="draft[field.name]"
                    :name="fullName(field)"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :placeholder="field.placeholder || ''"
                    :min="field.min ?? null"
                    :max="field.max ?? null"
                    :step="field.step ?? null"
                    :stepper="Boolean(field.stepper)"
                    :required="Boolean(field.required)"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></number-input>
            <text-input
                    v-else
                                        v-model="draft[field.name]"
                    :type="inputType(field)"
                    :name="fullName(field)"
                    :errors="getFieldErrors(fullName(field))"
                    :label="field.label"
                    :placeholder="field.placeholder || ''"
                    :required="Boolean(field.required)"
                    :readonly="readonly"
                    :extensions="field.extensions || {}"
                    :translate="false"
            ></text-input>
        </div>
        <div v-if="!readonly" class="form--actions">
            <button type="submit" class="button button--invert" :disabled="formIsSubmitting">
                <span class="button--icon">{{ icon('ph:bold/check') }}</span>[[ submitText ]]
            </button>
        </div>
    </div>
{%- endblock -%}
