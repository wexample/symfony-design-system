{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.field_expression.*') }}
{%- endblock -%}

{#- While on, the editor in the control's place — the form's code editor when
    it has one, a text area else, named as the page's field is —; under the
    field, the strip switching between a value and an expression. -#}
{%- block vue_body -%}
    <div class="field-expression" :class="{ 'is-on': on }">
        <component
                v-if="on && editor"
                :is="editor"
                class="field-expression--editor"
                :model-value="held"
                :language="language"
                :name="targetName"
                :translate="false"
                @update:model-value="onEditorInput"
        ></component>
        <textarea
                v-else-if="on"
                class="form--input form--textarea field-expression--editor field-expression--text"
                :name="targetName"
                :rows="rows"
                :value="held"
                spellcheck="false"
                @input="onEditorInput"
        ></textarea>
        <div class="field-expression--bar field-extension--strip">
            {#- The glyph alone, its word under the pointer: a footer is a strip, not a bar. -#}
            <button type="button" class="action-icon field-expression--toggle" :aria-pressed="on ? 'true' : 'false'" :aria-label="on ? t('to_value') : t('to_expression')" :data-tooltip="on ? t('to_value') : t('to_expression')" @click="toggle">
                <span v-if="on">{{ icon('ph:bold/text-aa') }}</span>
                <span v-else>{{ icon('ph:bold/code') }}</span>
            </button>
        </div>
    </div>
{%- endblock -%}
