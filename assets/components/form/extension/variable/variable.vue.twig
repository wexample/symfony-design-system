{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.field_variable.*') }}
{%- endblock -%}

{#- Its glyph — lit while bound —, the name beside it or being written, in
    the field's first strip when another extension drew one, its own else;
    on a page's field, the name in a hidden input posted beside it. -#}
{%- block vue_body -%}
    <div class="field-variable" :class="{ 'is-bound': bound }">
        <input v-if="target && postedName" type="hidden" :name="postedName" :value="bound || ''">
        <div v-show="!joined" class="field-variable--strip field-extension--strip">
            <teleport :to="joined" :disabled="!joined">
                <span class="field-variable--items">
                    <template v-if="editing">
                        <input
                                ref="input"
                                v-model="draft"
                                class="form--input field-variable--input"
                                :class="{ 'is-invalid': !valid }"
                                type="text"
                                spellcheck="false"
                                autocomplete="off"
                                :list="suggestions.length ? listId : null"
                                :placeholder="title"
                                :aria-label="title"
                                :aria-invalid="valid ? null : 'true'"
                                :title="valid ? null : t('invalid')"
                                @keydown.enter.prevent="commit"
                                @keydown.esc.prevent="cancel"
                                @blur="commit"
                        >
                        <datalist v-if="suggestions.length" :id="listId">
                            <option v-for="name in suggestions" :key="name" :value="name"></option>
                        </datalist>
                    </template>
                    <button v-else-if="bound" type="button" class="field-variable--name" :data-tooltip="t('change')" @click="edit"><code>[[ bound ]]</code></button>
                    <button
                            type="button"
                            class="action-icon field-variable--toggle"
                            :aria-pressed="bound ? 'true' : 'false'"
                            :aria-label="bound ? t('bound', { '%name%': bound }) : t('bind', { '%label%': title })"
                            :data-tooltip="bound ? t('bound', { '%name%': bound }) : t('bind', { '%label%': title })"
                            @click="editing ? commit() : edit()"
                            v-html="iconHtml"
                    ></button>
                </span>
            </teleport>
        </div>
    </div>
{%- endblock -%}
