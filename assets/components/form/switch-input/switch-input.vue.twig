{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/form-field/form-field.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.switch.*') }}
{%- endblock -%}

{%- block field_label -%}{%- endblock -%}

{%- block field_control -%}
    <input
            class="switch--checkbox"
            type="checkbox"
            :id="resolvedId"
            :name="name || null"
            :checked="modelValue"
            :required="required ? true : null"
            :disabled="isDisabled ? true : null"
            @change="onChange"
    >
    <label
            class="switch"
            :for="resolvedId"
            :data-checked="modelValue ? 'true' : 'false'"
    >
        <span class="switch--pill">
            <span class="switch--knob"></span>
        </span>
        <span class="switch--label">[[ resolveLabel(label) ]]</span>
    </label>
{%- endblock -%}
