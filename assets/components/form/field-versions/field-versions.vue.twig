{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/diff-text') -}}
{%- endblock -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.field_versions.*') }}
{%- endblock -%}

{#- The footer of a text field, glued under it inside its frame: which
    version is read — the current one alone while the address answers no
    earlier one —, at the strip's end, the version taken back before it;
    the footer's options start from the right. The version read
    compared with the draft under the field. -#}
{%- block vue_body -%}
    <div class="field-versions">
        <div class="field-versions--bar">
            <button v-if="version" type="button" class="button button--flat button--small field-versions--take" @click="take">
                <span class="button--icon">{{ icon('ph:bold/arrow-u-up-left') }}</span>[[ t('take') ]]
            </button>
            <span class="field-versions--icon" aria-hidden="true">{{ icon('ph:bold/clock-counter-clockwise') }}</span>
            <select class="form--input--select field-versions--select" :value="chosen" :aria-label="t('version')" :disabled="!versions.length ? true : null" @change="onChoice">
                <option v-for="choice in choices" :key="choice.value" :value="choice.value">[[ choice.label ]]</option>
            </select>
        </div>
        <diff-text
                v-if="version"
                class="field-versions--diff"
                :before="version.content || ''"
                :after="draft"
                :mode="mode"
                :before-label="version.label"
                :after-label="draftLabel"
        ></diff-text>
    </div>
{%- endblock -%}
