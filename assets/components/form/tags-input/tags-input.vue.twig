{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/form-field/form-field.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.tags_input.*') }}
{%- endblock -%}

{%- block field_label -%}
    <label v-if="hasLabel" class="form--label" :for="resolvedId">[[ resolveLabel(label) ]]</label>
{%- endblock -%}

{#- Client-side twin of tags-input.html.twig: the same frame and tags, the
    words offered under it. -#}
{%- block field_control -%}
    <div class="tags-input--frame" @click="$refs.entry && $refs.entry.focus()">
        <span class="tags-input--list">
            <span v-for="tag in modelValue" :key="tag" class="tags-input--tag">[[ tag ]]<button
                        type="button"
                        class="tags-input--remove"
                        :aria-label="removeLabel + ' ' + tag"
                        :disabled="disabled || readonly ? true : null"
                        @click.stop="remove(tag)"
                >×</button></span>
        </span>
        <input
                ref="entry"
                v-model="entry"
                class="tags-input--entry"
                type="text"
                :id="resolvedId"
                :name="name || null"
                :placeholder="entryPlaceholder"
                :disabled="disabled ? true : null"
                :readonly="readonly ? true : null"
                @keydown="onKeydown"
                @blur="commit"
        >
    </div>
    <div v-if="offered.length && !disabled && !readonly" class="tags-input--suggestions">
        <button v-for="tag in offered"
                :key="tag"
                type="button"
                class="tags-input--suggestion"
                :aria-label="suggestLabel(tag)"
                @click="write([...modelValue, tag])">+ [[ tag ]]</button>
    </div>
{%- endblock -%}
