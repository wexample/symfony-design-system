{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/form-field/form-field.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.key_value.*') }}
{%- endblock -%}

{%- block field_label -%}
    <label v-if="hasLabel" class="form--label" :for="resolvedId">[[ resolveLabel(label) ]]</label>
{%- endblock -%}

{#- A line a pair, its key and its value side by side; the last line opens the
    next one. -#}
{%- block field_control -%}
    <div class="key-value-input--pairs">
        <div v-for="(pair, index) in modelValue" :key="index" class="key-value-input--pair" :data-pair="index">
            <input class="form--input key-value-input--key"
                   type="text"
                   :value="pair.key"
                   :aria-label="t('key')"
                   :placeholder="keyPlaceholder || t('key')"
                   :disabled="disabled ? true : null"
                   :readonly="readonly ? true : null"
                   @input="update(index, 'key', $event.target.value)">
            <input class="form--input key-value-input--value"
                   type="text"
                   :value="pair.value"
                   :aria-label="t('value')"
                   :placeholder="valuePlaceholder || t('value')"
                   :disabled="disabled ? true : null"
                   :readonly="readonly ? true : null"
                   @input="update(index, 'value', $event.target.value)">
            <button v-if="!disabled && !readonly"
                    type="button"
                    class="form--input-action key-value-input--remove"
                    :aria-label="t('remove')"
                    :title="t('remove')"
                    @click="remove(index)">{{ icon('ph:bold/x') }}</button>
        </div>
        <div v-if="!disabled && !readonly" class="key-value-input--pair key-value-input--new">
            <input class="form--input key-value-input--key"
                   type="text"
                   v-model="draft"
                   :id="resolvedId"
                   :placeholder="t('add')"
                   @keydown.enter.prevent="add"
                   @blur="add">
        </div>
    </div>
{%- endblock -%}
