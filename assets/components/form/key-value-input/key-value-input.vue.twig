{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/form-field/form-field.vue.twig' -%}

{%- block vue_config -%}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.key_value.*') }}
{%- endblock -%}

{%- block field_label -%}
    <label v-if="hasLabel" class="form--label" :for="resolvedId">[[ resolveLabel(label) ]]</label>
{%- endblock -%}

{#- One frame, a line a pair, its key and its value side by side; the last
    line is the next pair, written in place. Lines are keyed by their place,
    so the line written in stays the same element once it becomes a pair. -#}
{%- block field_control -%}
    <div class="key-value-input is-active">
        <div class="key-value-input--frame" :class="{ 'is-readonly': readonly }" role="group" :aria-label="resolveLabel(label)">
            <template v-for="(line, index) in lines" :key="index">
                <div v-if="!line.isNew || editable"
                     class="key-value-input--pair"
                     :class="{ 'key-value-input--new': line.isNew }"
                     :data-pair="index">
                    <input class="key-value-input--key"
                           :class="{ 'is-duplicate': isDuplicate(line) }"
                           type="text"
                           :id="index === 0 ? resolvedId : null"
                           :value="line.key"
                           :aria-label="t('key')"
                           :aria-invalid="isDuplicate(line) ? 'true' : null"
                           :title="isDuplicate(line) ? t('duplicate') : null"
                           :placeholder="line.isNew ? t('add') : (keyPlaceholder || t('key'))"
                           :disabled="disabled ? true : null"
                           :readonly="readonly ? true : null"
                           @input="update(index, 'key', $event.target.value)"
                           @keydown.enter.prevent="focusLine(index, 'value')"
                           @keydown.backspace="onKeyBackspace(index, $event)">
                    <input class="key-value-input--value"
                           type="text"
                           :value="line.value"
                           :aria-label="t('value')"
                           :placeholder="valuePlaceholder || t('value')"
                           :disabled="disabled ? true : null"
                           :readonly="readonly ? true : null"
                           @input="update(index, 'value', $event.target.value)"
                           @keydown.enter.prevent="next(index)">
                    <span v-if="line.isNew" class="key-value-input--mark" aria-hidden="true">{{ icon('ph:bold/plus') }}</span>
                    <button v-else-if="editable"
                            type="button"
                            class="key-value-input--remove"
                            :aria-label="t('remove')"
                            :title="t('remove')"
                            @click="remove(index)">{{ icon('ph:bold/x') }}</button>
                    <span v-else></span>
                </div>
            </template>
            <div v-if="!editable && !pairs.length" class="key-value-input--pair">
                <span class="key-value-input--key">—</span>
            </div>
        </div>
    </div>
{%- endblock -%}
