{# The server renderer of the data table. Its client twin is data-table.vue,
   beside it, and the two take the same column definitions — what a cell value
   may be is where they part, and that is written in the component's
   declaration: this one is drawn once the data is known, the other before. #}
{% set selectable = options.selectable|default(false) %}
{#- Each row opening its detail where `target` says — a panel, a modal, an
    embed —: the row's address under `key`, already resolved. The link stands
    in a last column of its own, reached from the keyboard, and a press on the
    row is a press on it. -#}
{% set row_link = options.row_link|default(null) %}
{% set columns_count = (columns|length ?: 1) + (selectable ? 1 : 0) + (row_link ? 1 : 0) %}
{% set bulk_actions = options.bulk_actions|default([]) %}
{#- The checkboxes sit in the table and the form above it: a row may hold forms
    of its own, and forms do not nest, so the boxes join the bulk form by its id
    rather than by being inside it. -#}
{% set bulk_form_id = 'data-table-bulk-' ~ random() %}
{#- Filters at the head of the bar, kept in the page's query: the controller
    reads the same query to narrow the rows it hands the table. With a
    `query_key`, the filters and the order live under that key alone, so two
    tables on one page keep each their own. -#}
{% set filters = options.filters|default([]) %}
{%- set filter_bar -%}
    {%- if filters is not empty -%}
        {% include '@WexampleSymfonyDesignSystemBundle/components/filter-bar/filter-bar.html.twig' with { filters: filters, query_key: options.query_key|default(null) } %}
    {%- endif -%}
{%- endset -%}
{#- How many rows the table holds, at the end of the bar above it. -#}
{% set show_count = options.show_count|default(false) %}
{%- set total_count -%}
    {%- if show_count -%}
        <span class="table--total">{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.table.total'|trans({ '%count%': rows|filter(row => row.group is not defined)|length }) }}</span>
    {%- endif -%}
{%- endset -%}

{#- One root, for the script to hang from: it keeps the select-all box, the
    count and the bulk actions in step with the rows that are ticked. -#}
<div class="data-table">
{%- if selectable and bulk_actions is not empty -%}
    {#- What can be done to the ticked rows: each action posts them, their values
        under one name, to its own address. Buttons when there are few, a select
        when there are enough to crowd the bar. -#}
    <form class="table--bar" id="{{ bulk_form_id }}" method="post" action="{{ (bulk_actions|first).href|default('#') }}">
        {{ filter_bar }}
        <span class="table--bulk-count" data-label="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.table.selected'|trans({ '%count%': '%count%' }) }}">
            {{- 'WexampleSymfonyDesignSystemBundle.common.system::frontend.table.selected'|trans({ '%count%': 0 }) -}}
        </span>
        {%- if options.bulk_actions_mode|default('buttons') == 'select' -%}
            <input type="hidden" name="_token" value="">
            <select class="form--input table--bulk-select" aria-label="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.table.actions'|trans }}">
                <option value="">{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.table.actions'|trans }}</option>
                {%- for action in bulk_actions -%}
                    <option value="{{ loop.index0 }}" data-href="{{ action.href|default('#') }}" data-token="{{ action.token|default('') }}"{% if action.all|default(false) %} data-all{% endif %}>{{ action.label|default('') }}</option>
                {%- endfor -%}
            </select>
            {{ button('ph:bold/check', 'WexampleSymfonyDesignSystemBundle.common.system::frontend.table.apply', {
                type: 'submit',
                class: 'table--bulk-apply',
                disabled: true,
            }) }}
        {%- else -%}
            {%- for action in bulk_actions -%}
                {#- The token rides on the button, so each action carries its own. -#}
                {#- One marked `all` acts on every row and needs nothing ticked. -#}
                {{ button(action.icon|default(null), action.label|default(''), {
                    type: 'submit',
                    class: 'table--bulk-action' ~ (action.all|default(false) ? ' table--bulk-action--all') ~ (action.class is defined ? ' ' ~ action.class),
                    formaction: action.href|default('#'),
                    name: '_token',
                    value: action.token|default(''),
                    disabled: not action.all|default(false),
                }) }}
            {%- endfor -%}
        {%- endif -%}
        {{ total_count }}
    </form>
{%- elseif show_count or filters is not empty -%}
    <div class="table--bar">{{ filter_bar }}{{ total_count }}</div>
{%- endif -%}

{#- The frame is what scrolls sideways when the columns are wider than the room:
    the table keeps its own width, the page keeps its own. -#}
<div class="table--frame{{ options.sticky|default(false) ? ' table--frame--sticky' }}{{ options.scroll|default(false) ? ' table--frame--scroll' }}">
<table class="table{{ options.sticky|default(false) ? ' table--sticky' }}{{ (options.striped ?? true) ? ' table--striped' }}{{ (options.hover ?? true) ? ' table--hover' }}{{ options.class is defined ? ' ' ~ options.class }}">
    {% if options.show_header|default(true) %}
        <thead>
        <tr class="table--row">
            {% if selectable %}
                <th class="table--cell table--cell--select" scope="col">
                    <input class="table--select table--select-all" type="checkbox" aria-label="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.table.select_all'|trans }}">
                </th>
            {% endif %}
            {% for column in columns %}
                {%- if column.sortable -%}
                    {#- A link to the same page in the next order: the controller
                        reads the query to list the rows, or the table orders
                        them itself with `sort_rows`. The arrow says the order in
                        force, the default one included. -#}
                    <th class="table--cell{{ column.class ? ' ' ~ column.class }}" scope="col" aria-sort="{{ column.sort_aria }}">
                        <a class="table--sort{{ column.sort_aria != 'none' ? ' is-active' }}" href="{{ column.sort_href }}">
                            <span{% if column.tooltip %} data-tooltip="{{ column.tooltip }}"{% endif %}>{{ column.label }}</span>
                            <span class="table--sort-icon" aria-hidden="true">{{ icon({ ascending: 'ph:bold/caret-up', descending: 'ph:bold/caret-down' }[column.sort_aria] ?? 'ph:bold/caret-up-down') }}</span>
                        </a>
                    </th>
                {%- else -%}
                    {#- A short label says enough to read the column by; its
                        tooltip says it whole (`tooltip`). -#}
                    <th class="table--cell{{ column.class ? ' ' ~ column.class }}" scope="col">
                        {%- if column.tooltip -%}<span data-tooltip="{{ column.tooltip }}">{{ column.label }}</span>{%- else -%}{{ column.label }}{%- endif -%}
                    </th>
                {%- endif -%}
            {% endfor %}
            {% if row_link %}
                <th class="table--cell table--cell--row-open" scope="col"><span class="visually-hidden">{{ row_link.label|default('WexampleSymfonyDesignSystemBundle.common.system::frontend.table.open'|trans) }}</span></th>
            {% endif %}
        </tr>
        </thead>
    {% endif %}
    <tbody>
    {% if options.loading|default(false) %}
        <tr class="table--row table--row--loading">
            <td class="table--cell table--cell--loading" colspan="{{ columns_count }}">
                {% include '@WexampleSymfonyDesignSystemBundle/components/spinner/spinner.html.twig' with {
                    size: 'sm',
                    label: options.loading_label|default('WexampleSymfonyDesignSystemBundle.common.system::frontend.loading'|trans)
                } only %}
            </td>
        </tr>
    {% elseif rows is empty and filters_clear_url %}
        {#- Nothing because of the filters, and the way out of them. -#}
        <tr class="table--row">
            <td class="table--cell table--cell--state text-empty" colspan="{{ columns_count }}">
                <span>{{ options.empty_filtered_label|default('WexampleSymfonyDesignSystemBundle.common.system::frontend.table.empty_filtered'|trans) }}</span>
                <a class="button button--compact" href="{{ filters_clear_url }}">{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.table.clear_filters'|trans }}</a>
            </td>
        </tr>
    {% elseif rows is empty %}
        <tr class="table--row">
            <td class="table--cell text-empty" colspan="{{ columns_count }}">
                {{- options.empty_label|default('WexampleSymfonyDesignSystemBundle.common.system::frontend.no_data'|trans) -}}
            </td>
        </tr>
    {% else %}
        {% for row in rows %}
            {#- A row carrying only a group is the line between two runs of rows,
                given a word: it spans the table and names what follows. -#}
            {% if row.group is defined %}
            <tr class="table--row table--row--group">
                <th class="table--cell table--cell--group" colspan="{{ columns_count }}" scope="colgroup">{{ row.group }}</th>
            </tr>
            {% else %}
            {#- One action in the whole row, and a link: the row is pressed as
                that link (data-table.ts). -#}
            {%- set row_actions = [] -%}
            {%- for column in columns -%}
                {%- if column.cell == 'actions' -%}
                    {%- set row_actions = row_actions|merge(attribute(row, column.key)|default([])) -%}
                {%- endif -%}
            {%- endfor -%}
            {%- set row_only_action = row_actions|length == 1 ? row_actions|first : null -%}
            {%- set row_href = row_link ? attribute(row, row_link.key|default('href'))|default(null) : null -%}
            {%- set row_is_link = row_href or (row_only_action
                and row_only_action.href|default(null)
                and row_only_action.method|default('get')|lower != 'post') -%}
            <tr class="table--row{{ row_is_link ? ' table--row--link' }}">
                {% if selectable %}
                    <td class="table--cell table--cell--select">
                        <input class="table--select table--select-row" type="checkbox"
                               form="{{ bulk_form_id }}"
                               name="{{ options.selection_name|default('ids[]') }}"
                               value="{{ attribute(row, options.selection_key|default('id')) }}"
                               aria-label="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.table.select_row'|trans }}">
                    </td>
                {% endif %}
                {% for column in columns %}
                    {% set value = column.key ? attribute(row, column.key) : null %}
                    <td class="table--cell{{ column.class ? ' ' ~ column.class }}{{ column.secondary ? ' table--cell--secondary' }}">
                        {%- if column.cell == 'actions' -%}
                            <span class="table--actions">
                                {%- for action in value -%}
                                    {#- An icon alone says nothing to a reader who cannot see
                                        it, nor to one who does not know it: every action
                                        carries its label, as a tooltip and as its name. -#}
                                    {%- set action_label = action.label|default(null) -%}
                                    {%- if action.method|default('get')|lower == 'post' -%}
                                        <form method="post" action="{{ action.href|default('#') }}">
                                            {%- if action.token|default(null) -%}
                                                <input type="hidden" name="_token" value="{{ action.token }}">
                                            {%- endif -%}
                                            <button class="table--icon-button" type="submit"
                                                    {%- if action_label %} title="{{ action_label }}" aria-label="{{ action_label }}"{% endif %}>{{ icon(action.icon) }}</button>
                                        </form>
                                    {%- elseif action.target|default(null) -%}
                                        {{ button_target(action.icon, '', action.href|default('#'), action.target, {
                                            class: 'table--icon-link',
                                            target_options: action.target_options|default({}),
                                            attr: action_label ? { title: action_label, 'aria-label': action_label } : {},
                                        }) }}
                                    {%- else -%}
                                        <a class="table--icon-link" href="{{ action.href|default('#') }}"
                                           {%- if action_label %} title="{{ action_label }}" aria-label="{{ action_label }}"{% endif %}>{{ icon(action.icon) }}</a>
                                    {%- endif -%}
                                {%- endfor -%}
                            </span>
                        {%- elseif column.cell == 'icon' -%}
                            {%- if value.href|default(null) -%}
                                <a class="table--icon-link" href="{{ value.href }}">{{ icon(value.icon) }}</a>
                            {%- else -%}
                                <span class="table--icon">{{ icon(value.icon) }}</span>
                            {%- endif -%}
                        {%- elseif column.cell == 'link' -%}
                            {%- if value.href|default(null) -%}
                                <a href="{{ value.href }}">{{ value.label }}</a>
                            {%- else -%}
                                {{- value.label -}}
                            {%- endif -%}
                        {%- elseif column.cell == 'date' -%}
                            {#- The browser keeps it up to date afterwards, which is
                                what the vue twin does with its date-display. -#}
                            {%- if value is not empty -%}
                                {{- date_display(value, column.date_format) -}}
                            {%- endif -%}
                        {%- elseif column.cell == 'html' -%}
                            {{- value|raw -}}
                        {%- elseif column.cell == 'path' -%}
                            {#- A path, or { path, href, target } leading to it. -#}
                            {#- Stacked: the name over its folders, so a column of
                                long paths fits the table instead of widening it. -#}
                            {%- if value is iterable -%}
                                {{- file_path(value.path|default(''), { href: value.href|default(null), target: value.target|default(null), stacked: true }) -}}
                            {%- else -%}
                                {{- file_path(value, { stacked: true }) -}}
                            {%- endif -%}
                        {%- elseif column.cell == 'clamp' -%}
                            {#- A long text — an error — held to `lines` lines,
                                the whole of it in the tooltip and in the detail a
                                `row_link` opens. -#}
                            {%- if value is not same as(null) and value is not same as('') -%}
                                <span class="table--clamp" style="--table-clamp: {{ column.lines }}" title="{{ value }}">{{ value }}</span>
                            {%- endif -%}
                        {%- elseif column.cell == 'status' -%}
                            {#- A type name, or { type, count, title, label }. One
                                capsule for the two: a mark and a count beside it
                                read as two objects, and a column of them as noise. -#}
                            {%- set state = value is iterable ? value : { type: value } -%}
                            {%- if state.type|default(null) -%}
                                {{ marker(state.type, state.label|default(null), {
                                    count: state.count|default(null),
                                    title: state.title|default(null),
                                    compact: true,
                                }) }}
                            {%- endif -%}
                        {%- elseif column.unit -%}
                            {%- if value is not same as(null) and value is not same as('') -%}
                                <span class="table--quantity">{{ value|table_number(column.digits) }}&nbsp;<span class="table--unit">{{ column.unit }}</span></span>
                            {%- endif -%}
                        {%- else -%}
                            {{- value -}}
                        {%- endif -%}
                    </td>
                {% endfor %}
                {% if row_link %}
                    <td class="table--cell table--cell--row-open">
                        {%- if row_href -%}
                            {%- set row_open_label = row_link.label|default('WexampleSymfonyDesignSystemBundle.common.system::frontend.table.open'|trans) -%}
                            {%- if row_link.target|default(null) -%}
                                {{ button_target('ph:bold/caret-right', '', row_href, row_link.target, {
                                    class: 'table--icon-link table--row-open',
                                    target_options: row_link.target_options|default({}),
                                    attr: { title: row_open_label, 'aria-label': row_open_label },
                                }) }}
                            {%- else -%}
                                <a class="table--icon-link table--row-open" href="{{ row_href }}" title="{{ row_open_label }}" aria-label="{{ row_open_label }}">{{ icon('ph:bold/caret-right') }}</a>
                            {%- endif -%}
                        {%- endif -%}
                    </td>
                {% endif %}
            </tr>
            {% endif %}
        {% endfor %}
    {% endif %}
    </tbody>
</table>
</div>
</div>
