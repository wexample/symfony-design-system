{#- Tools along the end of a page (tool_dock()): a column of zones, then the bar
    of icons opening them. Both are regions of the row the page's own zone stands
    in, so the dock is written in its `page_zones_after`.

    The column is dragged wider from its start edge, and is gone when nothing in
    it is open. What the top of the bar opens stands in its upper part, its
    height dragged from its foot against what the foot of the bar opened under
    it; alone, it takes the column whole. -#}
<div class="zone zone--narrow zone--split zone--split--vertical tool-dock{{ class ? ' ' ~ class }}" {{ zone_state(id) }}>
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer', {}, { edge: 'start' }) }}
    {%- for tool in tools -%}
        {%- set top = tool.group == 'start' -%}
        <div id="{{ tool.zone }}" class="zone zone--panel{{ top ? ' tool-dock--top' }}{{ tool.open ? '' : ' zone--closed' }}"{% if top %} {{ zone_state(id ~ '.' ~ tool.name ~ '-height') }}{% endif %}>
            {%- if top -%}
                {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer') }}
            {%- endif -%}
            {#- What a tool holds scrolls inside the frame, which keeps still,
                its handle hanging past it. -#}
            <div class="zone zone--scrollable">
                {%- if tool.url -%}
                    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/embed', {
                        name: tool.zone,
                        src: tool.url,
                        lazy: true,
                    }) }}
                {%- else -%}
                    <div class="zone--content stack--vertical">{{ tool.content|raw }}</div>
                {%- endif -%}
            </div>
        </div>
    {%- endfor -%}
</div>
<div class="{{ component_init_class(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-toolbar') }} zone zone--narrow zone--toolbar zone--joined-start" data-tooltip-placement="left">
    {%- for group in ['start', 'end'] -%}
        {%- set group_tools = tools|filter(tool => tool.group == group) -%}
        {%- if group_tools is not empty -%}
            <div class="zone--toolbar-group{{ group == 'end' ? ' zone--toolbar-group--end' }}">
                {%- for tool in group_tools -%}
                    <button type="button"
                            class="action-icon"
                            data-zone-toggle="{{ tool.zone }}"
                            data-ui-state="{{ tool.state }}"
                            aria-pressed="{{ tool.open ? 'true' : 'false' }}"
                            aria-controls="{{ tool.zone }}"
                            aria-label="{{ tool.label }}"
                            data-tooltip="{{ tool.label }}">
                        {{- icon(tool.icon) -}}
                    </button>
                {%- endfor -%}
            </div>
        {%- endif -%}
    {%- endfor -%}
</div>
