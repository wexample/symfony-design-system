{% if route is defined and route %}
    {% set _trans_domain = translation_build_domain_from_template_path(page_translation_path_from_route(route)) %}
    {% set _icon_name = (_trans_domain ~ '::page_icon') | trans %}
    {% set _label = (_trans_domain ~ '::page_title') | trans %}
    {% set active_class = route_is_current(route, route_params|default({}), 'active') %}
{% else %}
    {% set _icon_name = icon_name %}
    {% set _label = label %}
    {% set active_class = '' %}
{% endif %}
{# The component registers itself when it is called; binding here as well
   would give one element two render nodes, and the second would look for a
   placeholder the first had already taken. #}
<li class="menu-item-collapsible{{ is_open ? ' is-open' : '' }}">
    <div class="menu-item-collapsible--header{{ active_class ? ' ' ~ active_class : '' }}">
        <a href="{{ href }}" class="menu-item-collapsible--link">
            <span class="menu--item--icon">{{ icon(_icon_name) }}</span>
            <span class="menu--item--label">{{ _label }}</span>
        </a>
        <button class="menu-item-collapsible--toggle" type="button">{{ icon('ph:bold/caret-down') }}</button>
    </div>
    <div class="menu-item-collapsible--sub">{{ content | raw }}</div>
</li>
