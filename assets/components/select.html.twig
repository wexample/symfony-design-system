<div class="select">
    <select class="select--input"{% if disabled is defined and disabled %} disabled{% endif %}>
        {%- if placeholder is defined and placeholder is not null -%}
            <option value="">{{ placeholder | trans }}</option>
        {%- endif -%}
        {%- for option in options | default([]) -%}
            <option
                value="{{ option.value }}"
                {%- if value is defined and option.value == value %} selected{%- endif -%}
            >{{ option.label | trans }}</option>
        {%- endfor -%}
    </select>
    <span class="select--icon" aria-hidden="true">
        {{ icon('ph:bold/caret-down') }}
    </span>
</div>
