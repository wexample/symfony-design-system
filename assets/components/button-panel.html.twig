<a class="button{% if options.class is defined %} {{ options.class }}{% endif %}"
   href="{{ options.href|default('#') }}"
   data-panel="true"
   data-panel-route="{{ options.href|default('#') }}"
   {% if options.panel_options is defined %}data-panel-options="{{ options.panel_options|json_encode|e('html_attr') }}"{% endif %}
        {{ component_render_tag_attributes(options.attr|default({})) }}>
    {% if icon is defined and icon %}
        <span class="button--icon">
            {{ icon(icon) }}
        </span>
    {% endif %}
    <span>{{ label | trans }}</span>
</a>
