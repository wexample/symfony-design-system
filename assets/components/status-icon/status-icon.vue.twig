{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_body -%}
    <span
            :class="classes"
            :style="style"
            :role="label ? 'img' : null"
            :aria-label="label"
            :aria-hidden="label ? null : 'true'"
    >
        <svg class="status-icon--ring" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle class="status-icon--ring-track" cx="8" cy="8" r="7"></circle>
            <circle class="status-icon--ring-arc" cx="8" cy="8" r="7"></circle>
        </svg>
        <span v-if="glyphHtml" class="status-icon--glyph" v-html="glyphHtml"></span>
    </span>
{%- endblock -%}
