{#- Where a reader stands in a sequence: the steps behind, the one being done,
    those ahead, joined by a line that fills as it is walked. A step with an
    `href` can be gone back to; which ones get one is the caller's decision.
    A step marked `unknown` stands for what is not decided yet — where paths
    part, the steps ahead depend on an answer: it takes no number and moves
    none of the numbers after it. -#}
{%- set steps = steps|default([]) -%}
{%- set current = current|default(0) -%}
{%- set numbered = numbered ?? true -%}
<nav class="stepper{{ class is defined and class ? ' ' ~ class : '' }}"
     aria-label="{{ label|default('WexampleSymfonyDesignSystemBundle.common.system::frontend.stepper.label'|trans) }}">
    <ol class="stepper--list">
        {%- for step in steps -%}
            {%- set index = loop.index0 -%}
            {%- set state = index < current ? 'done' : (index == current ? 'current' : 'upcoming') -%}
            {%- set unknown = step.unknown ?? false -%}
            {%- set number = steps|slice(0, index)|filter(previous => not (previous.unknown ?? false))|length + 1 -%}
            {%- set label_text = step.label ?? null -%}
            {%- set body -%}
                {%- if numbered -%}<span class="stepper--index">{{ unknown ? '…' : number }}</span>{%- endif -%}
                {%- if label_text -%}
                    <span class="stepper--label">{{ label_text }}</span>
                {%- elseif unknown and not numbered -%}
                    <span class="stepper--label">…</span>
                {%- endif -%}
            {%- endset -%}
            <li class="stepper--item is-{{ state }}{{ unknown ? ' is-unknown' }}">
                {%- if step.href is defined and step.href and state != 'current' and not unknown -%}
                    <a class="stepper--step" href="{{ step.href }}">{{ body }}</a>
                {%- else -%}
                    <span class="stepper--step"{% if state == 'current' %} aria-current="step"{% endif %}>{{ body }}</span>
                {%- endif -%}
            </li>
        {%- endfor -%}
    </ol>
</nav>
