{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_body -%}
    <nav :class="['stepper', variant ? 'stepper--' + variant : null]" :aria-label="resolvedLabel">
        <ol class="stepper--list">
            <li
                    v-for="(step, index) in steps"
                    :key="index"
                    :class="['stepper--item', 'is-' + stateOf(index), { 'is-unknown': step.unknown }]"
            >
                <a
                        v-if="isLink(step, index)"
                        class="stepper--step"
                        :href="step.href"
                >
                    <span v-if="numbered" class="stepper--index">[[ step.unknown ? '…' : numbers[index] ]]</span>
                    <span v-if="step.label || (step.unknown && !numbered)" class="stepper--label">[[ step.label || '…' ]]</span>
                </a>
                <button
                        v-else-if="navigable && !step.unknown && index !== current"
                        type="button"
                        class="stepper--step"
                        @click="$emit('select', index)"
                >
                    <span v-if="numbered" class="stepper--index">[[ step.unknown ? '…' : numbers[index] ]]</span>
                    <span v-if="step.label || (step.unknown && !numbered)" class="stepper--label">[[ step.label || '…' ]]</span>
                </button>
                <span
                        v-else
                        class="stepper--step"
                        :aria-current="index === current ? 'step' : null"
                >
                    <span v-if="numbered" class="stepper--index">[[ step.unknown ? '…' : numbers[index] ]]</span>
                    <span v-if="step.label || (step.unknown && !numbered)" class="stepper--label">[[ step.label || '…' ]]</span>
                </span>
            </li>
        </ol>
    </nav>
{%- endblock -%}
