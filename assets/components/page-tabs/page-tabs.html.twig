{#- The views of one thing, in a bar under the header. At its start the way
    back to the list the thing was opened from — read from where the page
    stands (`back: true`), or given (`back: { href, label }`), or none — set
    apart from the tabs, which are the thing's own views. Each tab is a route
    of its own, lit on it. At the far end, what can be done to the thing.

    Short of room, the bar folds rather than wraps or scrolls (page-tabs.ts):
    first everything but the current tab gives up its words for its icon,
    then the tabs gather in a menu named after the current one.

    `actions` is either markup the page draws itself, or a list of items —
    { icon, label, href, target, method, token, confirm, request }, as a
    menu's items; `request: 'api'` posts without leaving the page —
    which the bar draws as buttons and gathers, at its last fold, in one ⋮
    menu: every action at hand on a desk, all of them in reach on a phone. -#}
{%- set fold_items = [] -%}
{%- set current = null -%}
{%- for item in items -%}
    {%- set is_current = route_is_current(item.route, item.params|default({}), 'current') == 'current' -%}
    {%- if is_current -%}{%- set current = item -%}{%- endif -%}
    {%- set fold_items = fold_items|merge([{ label: item.label, href: path(item.route, item.params|default({})), icon: item.icon|default(null), checked: is_current }]) -%}
{%- endfor -%}
<nav class="tabs page-tabs" aria-label="{{ label|default('WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.navigation'|trans) }}">
    {%- if back is iterable -%}
        <nav class="breadcrumb breadcrumb--back page-tabs--back">
            <a class="breadcrumb--item" href="{{ back.href }}">
                <span class="breadcrumb--back-icon">{{ icon('ph:bold/arrow-left') }}</span>
                <span class="breadcrumb--label">{{ back.label }}</span>
            </a>
        </nav>
    {%- elseif back -%}
        {{ breadcrumb_render({ back: true, class: 'page-tabs--back' }) }}
    {%- endif -%}
    {%- if items is not empty -%}
    <div class="page-tabs--items">
        {%- for item in items -%}
            {{ tab_item(item.label, item.route, item.params|default({}), { count: item.count|default(null) }, item.icon|default(null)) }}
        {%- endfor -%}
    </div>
    {%- endif -%}
    {%- if items is not empty -%}
    <div class="page-tabs--fold">
        {{ button_menu(current.icon|default('ph:bold/list'), current.label|default(label|default('WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.navigation'|trans)), fold_items, { class: 'button--flat', caret: true }) }}
    </div>
    {%- endif -%}
    {%- if actions is iterable and actions is not empty -%}
        <div class="page-tabs--actions toolbar--group">
            {%- for action in actions -%}
                {%- if action.method|default('get') == 'post' -%}
                    <form class="page-tabs--action" method="post" action="{{ action.href }}"
                          {%- if action.request|default(null) %} data-request="{{ action.request }}"{% endif %}
                          {%- if action.confirm|default(null) %} data-confirm-title="{{ action.confirm.title|default('') }}" data-confirm-message="{{ action.confirm.message }}" data-confirm-accept="{{ action.confirm.accept|default('') }}"{% endif %}>
                        {%- if action.token|default(null) -%}<input type="hidden" name="_token" value="{{ action.token }}">{%- endif -%}
                        {{ button(action.icon, action.label, { type: 'submit' }) }}
                    </form>
                {%- elseif action.target|default(null) -%}
                    <span class="page-tabs--action">{{ button_target(action.icon, action.label, action.href, action.target) }}</span>
                {%- else -%}
                    <span class="page-tabs--action">{{ button_link(action.icon, action.label, action.href) }}</span>
                {%- endif -%}
            {%- endfor -%}
            {%- set more_label = 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.more'|trans -%}
            <div class="page-tabs--actions-fold">
                {{ button_menu('ph:bold/dots-three-vertical', null, actions, {
                    menu_align: 'right',
                    attr: { 'aria-label': more_label, title: more_label },
                }) }}
            </div>
        </div>
    {%- elseif actions -%}
        <div class="page-tabs--actions toolbar--group">{{ actions|raw }}</div>
    {%- endif -%}
</nav>
