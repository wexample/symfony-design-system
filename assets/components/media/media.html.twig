{#- A picture in its frame: a link when it leads somewhere, the missing
    picture where there is none and its ground while it loads
    (`placeholder`), a caption over its foot. `pending`: one is being made —
    generated, processed —: the frame says so, alive, over what it holds;
    true, or the words to say it with. `width` and `height` are the picture's own, which
    the browser reserves before it loads. `class` and `style` are the frame's,
    what a wall hangs it by. -#}
{%- set tag = href|default(null) ? 'a' : 'div' -%}
<{{ tag }} class="media media--placeholder{{ class|default(null) ? ' ' ~ class }}"
    {%- if tag == 'a' %} href="{{ href }}"{% endif -%}
    {%- if style|default(null) %} style="{{ style }}"{% endif -%}
    {%- if caption|default(null) %} title="{{ caption }}"{% endif %}>
    {%- if src|default(null) -%}
        <img src="{{ src }}" alt="{{ alt|default('') }}" loading="{{ loading|default('lazy') }}"
            {%- if srcset|default(null) %} srcset="{{ srcset }}"{% endif -%}
            {%- if sizes|default(null) %} sizes="{{ sizes }}"{% endif -%}
            {%- if width|default(null) %} width="{{ width }}"{% endif -%}
            {%- if height|default(null) %} height="{{ height }}"{% endif %}>
    {%- else -%}
        <div class="placeholder" aria-hidden="true">{{ icon('ph:bold/image') }}</div>
    {%- endif -%}
    {%- if pending|default(false) -%}
        <div class="placeholder placeholder--pending media--pending" role="status">
            <span class="placeholder--label">{{ pending is same as(true) ? 'WexampleSymfonyDesignSystemBundle.common.system::frontend.placeholder.pending'|trans : pending }}</span>
        </div>
    {%- endif -%}
    {%- if caption|default(null) -%}
        <span class="media--caption">{{ caption }}</span>
    {%- endif -%}
</{{ tag }}>
