{#- A state and what qualifies it. The glyph comes from `status_glyph()` and
    not from a map written here: the circle draws the same states, and one of
    the two drifting would give a reader two drawings of one thing. -#}
{% set type = type|default('info') %}
{% set glyph = glyph_name|default(status_glyph(type)) %}
{#- A running state has no glyph of its own: the circle draws it with its arc,
    and a capsule has no room for one, so here it is named instead. -#}
{% if not glyph and type == 'running' %}{% set glyph = 'ph:bold/circle-notch' %}{% endif %}

<span class="status status--{{ type }}{{ solid|default(false) ? ' status--solid' }}{{ compact|default(false) ? ' status--compact' }}{% if class|default('') %} {{ class }}{% endif %}"
      {% if title|default(null) %}title="{{ title }}"{% endif %}
      {{ component_render_tag_attributes(attr|default({})) }}>
    {%- if glyph -%}
        <span class="status--glyph" aria-hidden="true">{{ icon(glyph) }}</span>
    {%- endif -%}
    {%- if label is defined and label is not null and label != '' -%}
        <span class="status--label">{{ label }}</span>
    {%- endif -%}
    {%- if count is defined and count is not null and count != '' -%}
        <span class="status--count">{{ count }}</span>
    {%- endif -%}
</span>
