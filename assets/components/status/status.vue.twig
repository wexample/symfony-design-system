{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_body -%}
    {#- Client-side twin of status.html.twig: same classes, same order. A change
        to either is a change to both. -#}
    <span :class="classes" :title="title">
        <span v-if="glyphHtml" class="status--glyph" aria-hidden="true" v-html="glyphHtml"></span>
        <span v-if="hasLabel" class="status--label">[[ label ]]</span>
        <span v-if="hasCount" class="status--count">[[ count ]]</span>
    </span>
{%- endblock -%}
