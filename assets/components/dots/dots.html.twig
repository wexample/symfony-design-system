{% set size = size|default(null) %}
{% set variant = variant|default('default') %}
{% set align = align|default('center') %}
{% set extra_class = class|default('') %}
{% set dots_attr = attr|default({}) %}
{% set aria_label = label|default(null) %}
{% set size_class = size ?? (align == 'inline' ? null : 'md') %}

<div class="dots--wrapper dots--align-{{ align }}{% if extra_class %} {{ extra_class }}{% endif %}">
    <div class="dots{% if size_class %} dots--{{ size_class }}{% endif %}{% if variant and variant != 'default' %} dots--{{ variant }}{% endif %}"
         {% if aria_label %}role="status" aria-label="{{ aria_label }}"{% else %}aria-hidden="true"{% endif %}
         {{ component_render_tag_attributes(dots_attr) }}>
        <span class="dots--dot"></span>
        <span class="dots--dot"></span>
        <span class="dots--dot"></span>
    </div>
</div>
