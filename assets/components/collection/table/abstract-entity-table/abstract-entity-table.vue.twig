{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/data-table') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/pagination') -}}
{%- endblock -%}

{%- block vue_config -%}
    {%- if entityName is defined and entityName is not empty -%}
        {{- trans_js(render_pass, '@entity.' ~ entityName ~ '::field.*') -}}
    {%- endif -%}
{%- endblock -%}

{%- block vue_body -%}
    <div class="entity-table">
        <data-table
                :rows="entities"
                :columns="columns"
                :app="app"
                :show-header="showHeader"
                :sticky="sticky"
                :fill="fill"
                :empty-label="emptyLabel"
                :loading="isLoading"
                :row-key="getEntityKey"
                :searchable="searchable"
                :search-rows="false"
                :search-placeholder="searchPlaceholder"
                :show-count="showCount"
                :total="pagination ? pagination.total : null"
                :default-sort="defaultSort"
                :sort="sort"
                :filters="barFilters"
                :filter-values="barFilterValues"
                @update:sort="onSortChange"
                @update:search="onSearchChange"
                @update:filter-values="onBarFilterValuesChange"
        >
            {#- The pages above the rows sit at the end of the table's bar,
                on the line of its search and its count. -#}
            <template v-if="hasPaginationAt('top')" #bar-end>
                <pagination
                        v-bind="paginationProps"
                        @change="goToPage"
                ></pagination>
            </template>
        </data-table>

        <pagination
                v-if="hasPaginationAt('bottom')"
                v-bind="paginationProps"
                @change="goToPage"
        ></pagination>
    </div>
{%- endblock -%}
