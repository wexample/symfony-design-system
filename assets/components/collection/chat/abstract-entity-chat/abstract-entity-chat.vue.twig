{%- extends '@WexampleSymfonyDesignSystemBundle/components/collection/thread/abstract-entity-thread/abstract-entity-thread.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.components.collection.chat.abstract-entity-chat.abstract-entity-chat::*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{ parent() }}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/composer') -}}
{%- endblock -%}

{%- block vue_body -%}
    <div class="chat">
        {#- What concerns the conversation itself — its sound —, above the
            thread and out of its way. -#}
        <div v-if="hasToolbar" class="toolbar chat--toolbar">
            <button
                    type="button"
                    class="button button--flat"
                    :aria-pressed="soundEnabled ? 'true' : 'false'"
                    :aria-label="soundLabel"
                    :title="soundLabel"
                    @click="toggleSound"
            ><span class="button--icon" v-html="soundIconHtml"></span></button>
        </div>

        {{ block('thread') }}

        {#- What writes to the conversation: the composer, handed what the
            chat lets be done besides, and sending through it. -#}
        <composer
                ref="composer"
                :submit="submitMessage"
                :placeholder="placeholder"
                :submit-label="submitLabel"
                :accepts-attachments="acceptsAttachments()"
                :attachment-accept="getAttachmentAccept()"
                :attachment-limit="getAttachmentLimit()"
                :actions="composerActions"
        >
            {#- What a chat lets its reader set about the next messages besides
                their words — how they are sent —, under its actions. Nothing
                by default. -#}
            <template #panel>{%- block chat_composer_panel -%}{%- endblock -%}</template>
        </composer>
    </div>
{%- endblock -%}
