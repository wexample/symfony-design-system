{%- extends '@WexampleSymfonyDesignSystemBundle/components/bases/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.vue.collection.chat.abstract-entity-chat::*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/date-display') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/load-more') -}}
{%- endblock -%}

{%- block vue_body -%}
    <div class="chat">
        <div ref="thread" class="chat-thread">
            <div v-if="hasOlderEntities" class="chat--thread-head">
                <load-more
                        :label="resolvedLoadOlderLabel"
                        icon="ph:bold/caret-up"
                        :is-loading="isLoadingOlder"
                        @load="loadOlderMessages"
                ></load-more>
            </div>

            <div
                    v-for="message in messages"
                    :key="message.key"
                    class="chat--message-row"
                    :class="message.variant ? 'chat--message-row--' + message.variant : null"
            >
                <div class="avatar" v-html="message.iconHtml"></div>
                <div class="chat--message">
                    <div class="chat--message-meta">
                        <span class="chat--message-author">[[ message.author ]]</span>
                        <date-display
                                v-if="message.date"
                                class="chat--message-date"
                                :value="message.date"
                        ></date-display>
                    </div>
                    <div class="chat--message-content">[[ message.content ]]</div>
                </div>
            </div>
        </div>

        <div class="chat--footer">
            <div class="chat-textarea">
                <textarea
                        ref="input"
                        rows="1"
                        class="chat--textarea"
                        :placeholder="resolvedPlaceholder"
                        :disabled="isSubmitting"
                        v-model="draft"
                        @keydown.enter.exact.prevent="submitMessage"
                ></textarea>
                <button
                        class="chat--submit"
                        type="button"
                        :disabled="!canSubmit"
                        :aria-label="resolvedSubmitLabel"
                        :title="resolvedSubmitLabel"
                        v-html="submitIconHtml"
                        @click="submitMessage"
                ></button>
            </div>
        </div>
    </div>
{%- endblock -%}
