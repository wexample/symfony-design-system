{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.components.collection.chat.abstract-entity-chat.abstract-entity-chat::*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/collection/chat/chat-message') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/load-more') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/disclosure') -}}
{%- endblock -%}

{%- block vue_body -%}
    <div class="chat" :class="'chat--' + layout">
        <div v-if="hasToolbar" class="toolbar chat--toolbar">
            <button
                    type="button"
                    class="button button--flat"
                    :aria-pressed="soundEnabled ? 'true' : 'false'"
                    :aria-label="soundLabel"
                    :title="soundLabel"
                    @click="toggleSound"
            ><span class="button--icon" v-html="soundIconHtml"></span></button>
        </div>
        <div ref="thread" class="chat-thread">
            <div v-if="hasOlderEntities" class="chat--thread-head">
                <load-more
                        :label="resolvedLoadOlderLabel"
                        icon="ph:bold/caret-up"
                        :is-loading="isLoadingOlder"
                        @load="loadOlderMessages"
                ></load-more>
            </div>

            {#- Each line drawn by the component the chat names for it: the
                conversation's line by default, whatever a chat's lines are
                otherwise. The layout places the line, whatever draws it. -#}
            <template v-for="item in threadItems" :key="item.key">
                {#- Lines of a kind gathered, folded under one line: what the
                    chat groups (getMessageGroupKey), each drawn as any line. -#}
                <div v-if="item.group" class="chat--group">
                    <disclosure
                            :label="getMessageGroupLabel(item)"
                            :open="isMessageGroupOpen(item)"
                            quiet
                    >
                        <div class="chat--group-lines">
                            <div
                                    v-for="line in item.lines"
                                    :key="line.key"
                                    class="chat--item"
                                    :class="{ 'chat--item--own': line.own }"
                            >
                                <component
                                        :is="getMessageComponent(line.entity)"
                                        v-bind="getMessageProps(line.entity)"
                                ></component>
                            </div>
                        </div>
                    </disclosure>
                </div>
                <div
                        v-else
                        class="chat--item"
                        :class="{ 'chat--item--own': item.own }"
                >
                    <component
                            :is="getMessageComponent(item.entity)"
                            v-bind="getMessageProps(item.entity)"
                    ></component>
                </div>
            </template>


            {#- A thread read and found empty: what the chat says before the
                first message, in the middle of the room the lines will take. -#}
            <div v-if="emptyText" class="empty chat--empty">[[ emptyText ]]</div>
        </div>

        <div
                class="chat--footer"
                :class="{ 'is-dragging': attachDragDepth > 0 }"
                @dragenter="onAttachDragEnter"
                @dragover="onAttachDragOver"
                @dragleave="onAttachDragLeave"
                @drop="onAttachDrop"
        >
            {#- While the other side works: what it is doing, and for how long.
                Gone once it answered. -#}
            <div v-if="awaitingReply" class="chat--activity" role="status">
                <span class="chat--activity-glyph" aria-hidden="true">[[ activityGlyph ]]</span>
                <span class="chat--activity-label">[[ activityLabel ]]</span>
                <span class="chat--activity-elapsed" aria-hidden="true">[[ activityElapsed ]]</span>
            </div>
            {#- The files going with the next message, each taken back by its
                cross. -#}
            <ul v-if="attachments.length" class="file-chips chat--attachments">
                <li v-for="(file, index) in attachments" :key="file.name + index" class="file-chip">
                    <img v-if="attachmentPreviews[index]" class="file-chip--media" :src="attachmentPreviews[index]" alt="">
                    <span v-else class="file-chip--icon" v-html="attachmentIconHtml(file)"></span>
                    <span class="file-chip--name" :title="file.name">[[ file.name ]]</span>
                    <button
                            type="button"
                            class="button button--flat button--compact file-chip--remove"
                            :aria-label="attachRemoveLabel + ' ' + file.name"
                            :disabled="isSubmitting"
                            @click="removeAttachment(index)"
                            v-html="removeIconHtml"
                    ></button>
                </li>
            </ul>
            <div class="chat-textarea">
                <textarea
                        ref="input"
                        rows="1"
                        class="chat--textarea"
                        :placeholder="resolvedPlaceholder"
                        :disabled="isSubmitting"
                        v-model="draft"
                        @keydown.enter.exact.prevent="submitMessage"
                ></textarea>
                <template v-if="acceptsAttachments()">
                    <input
                            ref="attachInput"
                            type="file"
                            multiple
                            hidden
                            :accept="getAttachmentAccept()"
                            @change="onAttachPicked"
                    >
                    <button
                            class="chat--attach"
                            type="button"
                            :disabled="isSubmitting || attachmentsFull"
                            :aria-label="attachLabel"
                            :title="attachLabel"
                            v-html="attachIconHtml"
                            @click="$refs.attachInput.click()"
                    ></button>
                </template>
                <button
                        class="chat--submit"
                        type="button"
                        :disabled="!canSubmit"
                        :aria-label="resolvedSubmitLabel"
                        :title="resolvedSubmitLabel"
                        v-html="submitIconHtml"
                        @click="submitMessage"
                ></button>
            </div>
            {#- What can be done to the conversation itself — start it over,
                attach a file —, under the composer and quieter than it. None
                unless the chat gives some (getComposerActions). -#}
            <div v-if="composerActions.length" class="chat--composer-actions">
                <template v-for="action in composerActions" :key="action.key">
                    <a
                            v-if="action.href"
                            class="button button--compact"
                            :class="composerActionClass(action)"
                            :href="action.href"
                            :title="action.iconOnly ? action.label : null"
                            :aria-label="action.iconOnly ? action.label : null"
                    >
                        <span v-if="action.iconHtml" class="button--icon" v-html="action.iconHtml"></span>
                        <span v-if="!action.iconOnly">[[ action.label ]]</span>
                    </a>
                    <button
                            v-else
                            type="button"
                            class="button button--compact"
                            :class="composerActionClass(action)"
                            :title="action.iconOnly ? action.label : null"
                            :aria-label="action.iconOnly ? action.label : null"
                            :aria-pressed="action.pressed === undefined ? null : String(action.pressed)"
                            :disabled="runningComposerAction !== null"
                            @click="runComposerAction(action)"
                    >
                        <span v-if="action.iconHtml" class="button--icon" v-html="action.iconHtml"></span>
                        <span v-if="!action.iconOnly">[[ action.label ]]</span>
                    </button>
                </template>
            </div>
            {#- What a chat lets its reader set about the next messages besides
                their words — how they are sent —, under its actions, shown
                when the chat says so. Nothing by default. -#}
            <div class="chat--composer-panel">
                {%- block chat_composer_panel -%}{%- endblock -%}
            </div>
        </div>
    </div>
{%- endblock -%}
