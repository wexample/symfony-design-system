{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/date-display') -}}
{%- endblock -%}

{%- block vue_body -%}
    <div
            class="chat--message-row"
            :class="[message.variant ? 'chat--message-row--' + message.variant : null, message.own ? 'chat--message-row--own' : null]"
    >
        <div class="avatar" v-html="message.iconHtml"></div>
        <div class="chat--message">
            <div class="chat--message-meta">
                <span class="chat--message-author">[[ message.author ]]</span>
                <date-display
                        v-if="message.date"
                        class="chat--message-date"
                        :value="message.date"
                ></date-display>
            </div>
            <div v-if="message.html" class="chat--message-content content" v-html="message.html"></div>
            <div v-else class="chat--message-content">[[ message.content ]]</div>
        </div>
    </div>
{%- endblock -%}
