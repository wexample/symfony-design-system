{%- extends '@WexampleSymfonyDesignSystemBundle/pages/design_system/generic/dialog/layout/layout-dialog.html.twig' -%}

{%- set page_body_mode = 'container' -%}

{%- block layout_config -%}
    {{ parent() }}
{%- endblock -%}

{%- block page_body -%}
    {% set dialog_tests = [
        { key: 'persist', route: 'wexample_design_system_generic_dialog_modal_test_persist', class: 'modal-test-persist-button', options: { closeOnEscape: true, closeOnOverlayClick: true, persistent: true } },
        { key: 'simple', route: 'wexample_design_system_generic_dialog_modal_test_simple', class: 'modal-test-simple-button', options: { closeOnEscape: true, closeOnOverlayClick: true, confirmOnClose: false, confirmOnCloseWhenDirty: false } },
        { key: 'components', route: 'wexample_design_system_generic_dialog_modal_test_components', class: 'modal-test-components-button', options: { closeOnEscape: false, closeOnOverlayClick: true, confirmOnClose: false, confirmOnCloseWhenDirty: false } },
        { key: 'medium', route: 'wexample_design_system_generic_dialog_modal_test_medium', class: 'modal-test-medium-button', options: { closeOnEscape: true, closeOnOverlayClick: false, confirmOnClose: false, confirmOnCloseWhenDirty: false } },
        { key: 'long', route: 'wexample_design_system_generic_dialog_modal_test_long', class: 'modal-test-long-button', options: { closeOnEscape: true, closeOnOverlayClick: true, confirmOnClose: true, confirmOnCloseWhenDirty: false } },
        { key: 'form_rendered', route: 'wexample_design_system_generic_form_rendered', class: 'modal-test-form-rendered-button', options: { closeOnEscape: true, closeOnOverlayClick: true, confirmOnClose: true } },
        { key: 'form_ajax', route: 'wexample_design_system_generic_form_ajax', class: 'modal-test-form-ajax-button', options: { closeOnEscape: false, closeOnOverlayClick: false, confirmOnCloseWhenDirty: true } },
    ] %}

    {% for test in dialog_tests %}
        <div class="block block--padded block--split">
            <div class="lead">
                {{ ('@page::section.' ~ test.key ~ '.description') | trans }}
            </div>
            {{ button_modal('ph:bold/app-window', '@page::section.' ~ test.key ~ '.button', test.route, [], { class: test.class, modal_options: test.options }) }}
        </div>
    {% endfor %}

    <div class="block block--padded block--split">
        <div class="lead">
            {{ '@page::section.recursive.description' | trans }}
        </div>
        {{ button_modal('ph:bold/app-window', '@page::section.recursive.button_modal', 'wexample_design_system_generic_dialog_index', [], { class: 'modal-test-recursive-modal-button', modal_options: { closeOnEscape: true, closeOnOverlayClick: true } }) }}
        {{ button_panel('ph:bold/sidebar-simple-duotone', '@page::section.recursive.button_panel', 'wexample_design_system_generic_dialog_panel', [], { class: 'modal-test-recursive-panel-button', panel_options: { closeOnEscape: true, closeOnOverlayClick: true } }) }}
    </div>
{%- endblock -%}
