{%- extends '@WexampleSymfonyDesignSystemBundle/pages/design_system/generic/content/layout/layout-content.html.twig' -%}

{%- block page_body -%}
    <h2>{{ '@page::section.inline.title' | trans }}</h2>
    <div class="block block--padded">
        <p>{{ '@page::section.inline.description' | trans }}</p>
        <p>
            {{ '@page::example.status.released' | trans }}
            <span class="pill">{{ '@page::pill.released' | trans }}</span>
            {{ '@page::example.status.deprecated' | trans }}
            <span class="pill">{{ '@page::pill.deprecated' | trans }}</span>
            {{ '@page::example.status.beta' | trans }}
            <span class="pill">{{ '@page::pill.beta' | trans }}</span>
        </p>
    </div>

    <h2>{{ '@page::section.colors.title' | trans }}</h2>
    <div class="block block--padded stack--horizontal stack--wrap">
        {% for variant in ['', 'success', 'warning', 'danger', 'info', 'neutral'] %}
            <span class="pill{{ variant ? ' pill--' ~ variant : '' }}">
                {{ ('@page::pill.' ~ (variant ?: 'default')) | trans }}
            </span>
        {% endfor %}
    </div>

    <h2>{{ '@page::section.sizes.title' | trans }}</h2>
    <div class="block block--padded stack--horizontal stack--wrap align-center">
        {% for size in ['xs', 's', '', 'l'] %}
            <span class="pill{{ size ? ' pill--' ~ size : '' }}">
                {{ ('@page::pill.size.' ~ (size ?: 'default')) | trans }}
            </span>
        {% endfor %}
    </div>
{%- endblock -%}
