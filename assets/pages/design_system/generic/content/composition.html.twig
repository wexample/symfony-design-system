{%- extends '@WexampleSymfonyDesignSystemBundle/pages/design_system/generic/content/layout/layout-content.html.twig' -%}

{%- block page_body -%}
    <h2>{{ '@page::section.prose.title' | trans }}</h2>
    <article class="content">
        <nav aria-label="{{ '@page::article.toc.label' | trans }}">
            <ul>
                <li><a href="#article-intro">{{ '@page::article.title' | trans }}</a></li>
                <li><a href="#article-why-tokens">{{ '@page::article.section_one.title' | trans }}</a></li>
                <li><a href="#article-practical">{{ '@page::article.section_two.title' | trans }}</a></li>
            </ul>
        </nav>

        <h2 id="article-intro">{{ '@page::article.title' | trans }}</h2>
        <p>{{ '@page::article.intro' | trans }}</p>

        <h3 id="article-why-tokens">{{ '@page::article.section_one.title' | trans }}</h3>
        <p>{{ '@page::article.section_one.body_one' | trans | raw }}</p>
        <p>{{ '@page::article.section_one.body_two' | trans | raw }}</p>

        <h3 id="article-practical">{{ '@page::article.section_two.title' | trans }}</h3>
        <p>{{ '@page::article.section_two.body' | trans | raw }}</p>

        <h4>{{ '@page::article.list_title' | trans }}</h4>
        <ul>
            {% for item in '@page::article.list' | trans %}
                <li>{{ item }}</li>
            {% endfor %}
        </ul>

        <blockquote>
            <p><em>{{ '@page::article.quote' | trans }}</em></p>
            <cite>— {{ '@page::article.quote_author' | trans }}</cite>
        </blockquote>

        <p><a href="#">{{ '@page::article.cta' | trans }}</a></p>
    </article>

    <h2>{{ '@page::section.image.title' | trans }}</h2>
    <div class="content">
        <p>{{ '@page::image.intro' | trans }}</p>
        <p>{{ '@page::image.simple.label' | trans }}</p>
        {{ content_image(path('wexample_design_system_fixtures_placeholder_svg'), '@page::image.simple.alt' | trans) }}
        <p>{{ '@page::image.captioned.label' | trans }}</p>
        {{ content_image(path('wexample_design_system_fixtures_placeholder_svg'), '@page::image.captioned.alt' | trans, { caption: '@page::image.captioned.caption' | trans }) }}
    </div>

    <h2>{{ '@page::section.media.title' | trans }}</h2>
    <div class="content content--media">
        {{ content_image(path('wexample_design_system_fixtures_placeholder_svg'), '@page::media.alt' | trans, { caption: '@page::media.caption' | trans }) }}
        <div>
            <p>{{ '@page::media.body_one' | trans }}</p>
            <p>{{ '@page::media.body_two' | trans }}</p>
        </div>
    </div>

    <h2>{{ '@page::section.dropcap.title' | trans }}</h2>
    <div class="content content--dropcap">
        <p>{{ '@page::dropcap.paragraph_one' | trans }}</p>
        <p>{{ '@page::dropcap.paragraph_two' | trans }}</p>
    </div>

    <h2>{{ '@page::section.meta_bar.title' | trans }}</h2>
    <div class="block block--padded content">
        <h2>{{ '@page::article.title' | trans }}</h2>
        <p>{{ '@page::article.intro' | trans }}</p>
    </div>
    <div class="meta-bar">
        <div class="meta-bar--group">
            {{ icon('ph:bold/user') }}
            <span>{{ '@page::meta.author' | trans }}</span>
            {{ icon('ph:bold/dot') }}
            {{ icon('ph:bold/calendar-blank') }}
            <span>{{ '@page::meta.date' | trans }}</span>
            {{ icon('ph:bold/dot') }}
            {{ icon('ph:bold/clock') }}
            <span>{{ '@page::meta.read_time' | trans }}</span>
        </div>
        <div class="meta-bar--group">
            {{ icon('ph:bold/heart') }}
            <span>{{ '@page::meta.likes' | trans }}</span>
            {{ button_link('ph:bold/share-network', '@page::action.share' | trans, '#') }}
        </div>
    </div>
    <p>{{ '@page::section.meta_bar.stack_note' | trans }}</p>
    <div class="meta-bar">
        <div class="meta-bar--group">
            {{ icon('ph:bold/folder') }}
            <span>{{ '@page::meta.category' | trans }}</span>
            <span class="pill tag-3">{{ '@page::meta.tag' | trans }}</span>
        </div>
        <div class="meta-bar--group">
            {{ icon('ph:bold/eye') }}
            <span>{{ '@page::meta.views' | trans }}</span>
        </div>
    </div>
    <p>{{ '@page::section.meta_bar.action_link_note' | trans }}</p>
    <div class="meta-bar">
        <div class="meta-bar--group">
            {{ icon('ph:bold/user') }}
            <span>{{ '@page::meta.author' | trans }}</span>
            {{ icon('ph:bold/dot') }}
            {{ icon('ph:bold/calendar-blank') }}
            <span>{{ '@page::meta.date' | trans }}</span>
        </div>
        <div class="meta-bar--group">
            {{ icon('ph:bold/heart') }}
            <span>{{ '@page::meta.likes' | trans }}</span>
            <a class="action-link" href="#">
                {{ icon('ph:bold/share-network') }}
                {{ '@page::action.share' | trans }}
            </a>
        </div>
    </div>

    <h2>{{ '@page::section.pills.title' | trans }}</h2>

    <h3>{{ '@page::section.pill_inline.title' | trans }}</h3>
    <div class="block block--padded block--vertical">
        <p>{{ '@page::section.pill_inline.description' | trans }}</p>
        <p>
            {{ '@page::example.sentence.released' | trans }}
            <span class="pill">{{ '@page::pill.released' | trans }}</span>
            {{ '@page::example.sentence.deprecated' | trans }}
            <span class="pill">{{ '@page::pill.deprecated' | trans }}</span>
        </p>
    </div>

    <h3>{{ '@page::section.pill_palette.title' | trans }}</h3>
    <div class="block block--padded stack--horizontal stack--wrap">
        <span class="pill">{{ '@page::pill.neutral' | trans }}</span>
        {% for i in 1..6 %}
            <span class="pill tag-{{ i }}">{{ '@page::pill.tag' | trans }} {{ i }}</span>
        {% endfor %}
    </div>
{%- endblock -%}
