{%- extends '@WexampleSymfonyDesignSystemBundle/pages/design_system/generic/content/layout/layout-content.html.twig' -%}

{%- block page_body -%}
    <h2>{{ '@page::section.typography.title' | trans }}</h2>
    <div class="content">
        {% for level in ['h1','h2','h3','h4','h5','h6'] %}
            {% set base = '@page::title.' ~ level %}
            <{{ level }}>{{ (base ~ '.title') | trans }}</{{ level }}>
            <p>{{ (base ~ '.description') | trans }}</p>
        {% endfor %}
    </div>

    <h2>{{ '@page::section.prose.title' | trans }}</h2>
    <article class="content">
        <h2>{{ '@page::article.title' | trans }}</h2>
        <p>{{ '@page::article.intro' | trans }}</p>

        <h3>{{ '@page::article.section_one.title' | trans }}</h3>
        <p>{{ '@page::article.section_one.body_one' | trans | raw }}</p>
        <p>{{ '@page::article.section_one.body_two' | trans | raw }}</p>

        <h3>{{ '@page::article.section_two.title' | trans }}</h3>
        <p>{{ '@page::article.section_two.body' | trans | raw }}</p>

        <h4>{{ '@page::article.list_title' | trans }}</h4>
        <ul>
            {% for item in '@page::article.list' | trans %}
                <li>{{ item }}</li>
            {% endfor %}
        </ul>

        <blockquote>
            <p><em>{{ '@page::article.quote' | trans }}</em></p>
            <cite>— {{ '@page::article.quote_author' | trans }}</cite>
        </blockquote>

        <p><a href="#">{{ '@page::article.cta' | trans }}</a></p>
    </article>

    <h2>{{ '@page::section.image.title' | trans }}</h2>
    <div class="content">
        <p>{{ '@page::image.intro' | trans }}</p>
        <p>{{ '@page::image.simple.label' | trans }}</p>
        {{ content_image(path('wexample_design_system_fixtures_placeholder_svg'), '@page::image.simple.alt' | trans) }}
        <p>{{ '@page::image.captioned.label' | trans }}</p>
        {{ content_image(path('wexample_design_system_fixtures_placeholder_svg'), '@page::image.captioned.alt' | trans, { caption: '@page::image.captioned.caption' | trans }) }}
    </div>

    <h2>{{ '@page::section.media.title' | trans }}</h2>
    <div class="content content--media">
        {{ content_image(path('wexample_design_system_fixtures_placeholder_svg'), '@page::media.alt' | trans, { caption: '@page::media.caption' | trans }) }}
        <div>
            <p>{{ '@page::media.body_one' | trans }}</p>
            <p>{{ '@page::media.body_two' | trans }}</p>
        </div>
    </div>

    <h2>{{ '@page::section.dropcap.title' | trans }}</h2>
    <div class="content content--dropcap">
        <p>{{ '@page::dropcap.paragraph_one' | trans }}</p>
        <p>{{ '@page::dropcap.paragraph_two' | trans }}</p>
    </div>
{%- endblock -%}
