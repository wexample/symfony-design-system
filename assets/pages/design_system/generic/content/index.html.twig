{%- extends '@WexampleSymfonyDesignSystemBundle/pages/design_system/generic/content/layout/layout-content.html.twig' -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.compound.title' | trans }}</h2>
    <h3>{{ '@page::compound.heading' | trans }}</h3>
    <p>{{ '@page::compound.body' | trans }}</p>
    <p>{{ '@page::compound.tag_sentence' | trans }} <span class="pill tag-2">{{ '@page::compound.pill' | trans }}</span></p>
    <div class="meta-bar">
        <div class="meta-bar--group">
            {{ icon('ph:bold/user') }}
            <span>{{ '@page::compound.author' | trans }}</span>
            {{ icon('ph:bold/dot') }}
            {{ icon('ph:bold/calendar-blank') }}
            <span>{{ '@page::compound.date' | trans }}</span>
        </div>
        <div class="meta-bar--group">
            {{ button_link('ph:bold/share-network', '@page::compound.share' | trans, '#') }}
        </div>
    </div>
{%- endblock -%}
