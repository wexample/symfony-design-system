{%- extends '@WexampleSymfonyDesignSystemBundle/pages/design_system/generic/components/layout/layout-components.html.twig' -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.default.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.default.description' | trans }}</div>
    <div class="block block--padded">
        <dl class="properties">
            <div class="properties--row">
                <dt class="properties--key">{{ '@page::field.name.key' | trans }}</dt>
                <dd class="properties--value">{{ '@page::field.name.value' | trans }}</dd>
            </div>
            <div class="properties--row">
                <dt class="properties--key">{{ '@page::field.identifier.key' | trans }}</dt>
                <dd class="properties--value">{{ '@page::field.identifier.value' | trans }}</dd>
            </div>
            <div class="properties--row">
                <dt class="properties--key">{{ '@page::field.description.key' | trans }}</dt>
                <dd class="properties--value">{{ '@page::field.description.value' | trans }}</dd>
            </div>
        </dl>
    </div>

    <h2>{{ '@page::section.bordered.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.bordered.description' | trans }}</div>
    <div class="block">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/info') }}</span>
            <span class="block--title-label">{{ '@page::section.bordered.block_title' | trans }}</span>
        </div>
        <div class="block--body">
            <dl class="properties properties--bordered">
                <div class="properties--row">
                    <dt class="properties--key">{{ '@page::field.status.key' | trans }}</dt>
                    <dd class="properties--value"><span class="pill">{{ '@page::field.status.value' | trans }}</span></dd>
                </div>
                <div class="properties--row">
                    <dt class="properties--key">{{ '@page::field.owner.key' | trans }}</dt>
                    <dd class="properties--value">{{ '@page::field.owner.value' | trans }}</dd>
                </div>
                <div class="properties--row">
                    <dt class="properties--key">{{ '@page::field.created.key' | trans }}</dt>
                    <dd class="properties--value">{{ '@page::field.created.value' | trans }}</dd>
                </div>
                <div class="properties--row">
                    <dt class="properties--key">{{ '@page::field.description.key' | trans }}</dt>
                    <dd class="properties--value">{{ '@page::field.description.value' | trans }}</dd>
                </div>
            </dl>
        </div>
    </div>

    <h2>{{ '@page::section.split.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.split.description' | trans }}</div>
    <div class="block block--padded">
        <dl class="properties properties--bordered properties--split">
            <div class="properties--row">
                <dt class="properties--key">{{ '@page::amount.subtotal.key' | trans }}</dt>
                <dd class="properties--value">{{ '@page::amount.subtotal.value' | trans }}</dd>
            </div>
            <div class="properties--row">
                <dt class="properties--key">{{ '@page::amount.tax.key' | trans }}</dt>
                <dd class="properties--value">{{ '@page::amount.tax.value' | trans }}</dd>
            </div>
            <div class="properties--row">
                <dt class="properties--key">{{ '@page::amount.total.key' | trans }}</dt>
                <dd class="properties--value">{{ '@page::amount.total.value' | trans }}</dd>
            </div>
        </dl>
    </div>

    <h2>{{ '@page::section.compact.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.compact.description' | trans }}</div>
    <div class="block block--padded">
        <dl class="properties properties--compact">
            <div class="properties--row">
                <dt class="properties--key">{{ '@page::field.region.key' | trans }}</dt>
                <dd class="properties--value">{{ '@page::field.region.value' | trans }}</dd>
            </div>
            <div class="properties--row">
                <dt class="properties--key">{{ '@page::field.runtime.key' | trans }}</dt>
                <dd class="properties--value">{{ '@page::field.runtime.value' | trans }}</dd>
            </div>
            <div class="properties--row">
                <dt class="properties--key">{{ '@page::field.version.key' | trans }}</dt>
                <dd class="properties--value">{{ '@page::field.version.value' | trans }}</dd>
            </div>
        </dl>
    </div>

    <h2>{{ '@page::section.stacked.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.stacked.description' | trans }}</div>
    <div class="zone zone--split zone--split--wrap zone--gap">
        <div class="zone zone--narrow zone--size-6">
            <div class="block block--padded">
                <dl class="properties properties--stacked properties--bordered">
                    <div class="properties--row">
                        <dt class="properties--key">{{ '@page::field.identifier.key' | trans }}</dt>
                        <dd class="properties--value">{{ '@page::field.identifier.value' | trans }}</dd>
                    </div>
                    <div class="properties--row">
                        <dt class="properties--key">{{ '@page::field.owner.key' | trans }}</dt>
                        <dd class="properties--value">{{ '@page::field.owner.value' | trans }}</dd>
                    </div>
                    <div class="properties--row">
                        <dt class="properties--key">{{ '@page::field.created.key' | trans }}</dt>
                        <dd class="properties--value">{{ '@page::field.created.value' | trans }}</dd>
                    </div>
                </dl>
            </div>
        </div>
        <div class="zone">
            <div class="block block--padded">
                <p>{{ '@page::section.stacked.aside' | trans }}</p>
            </div>
        </div>
    </div>
{%- endblock -%}
