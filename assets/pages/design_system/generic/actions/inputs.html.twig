{%- extends '@WexampleSymfonyDesignSystemBundle/pages/design_system/generic/actions/layout/layout-actions.html.twig' -%}

{%- macro render_selects(render_pass, options) -%}
    <select class="form--input form--input--select form--input--inline">
        <option>{{ '@page::select.option_one' | trans }}</option>
        <option>{{ '@page::select.option_two' | trans }}</option>
        <option>{{ '@page::select.option_three' | trans }}</option>
    </select>
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/select', {}, { options: options, value: 'one' }) }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/select-search', {}, { options: options, value: 'one' }) }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/select', {}, { options: options, value: 'one', class: 'is-assisted' }) }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/select-search', {}, { options: options, value: 'one', class: 'is-assisted' }) }}
{%- endmacro -%}

{%- macro render_switches(render_pass, icon_moon, icon_sun) -%}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/switch') }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/switch', { label: '@page::switch.label_right' }) }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/switch', { label: '@page::switch.label_left', label_position: 'left' }) }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/switch', { off_inner: icon_moon, on_inner: icon_sun }) }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/switch', { off_inner: 'OFF', on_inner: 'ON', label: '@page::switch.label_right', checked: true }) }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/switch', { label: '@page::switch.label_right', class: 'is-assisted' }) }}
{%- endmacro -%}

{%- block page_body -%}
    {% import _self as macros %}

    {% set select_options = [
        { value: 'one',   label: '@page::select.option_one' },
        { value: 'two',   label: '@page::select.option_two' },
        { value: 'three', label: '@page::select.option_three' }
    ] %}

    <h2>{{ '@page::section.select.title' | trans }}</h2>
    <div class="cluster">{{ macros.render_selects(render_pass, select_options) }}</div>
    <div class="block block--padded cluster">{{ macros.render_selects(render_pass, select_options) }}</div>
    <div class="toolbar">{{ macros.render_selects(render_pass, select_options) }}</div>

    <h2>{{ '@page::section.switch.title' | trans }}</h2>
    {% set icon_sun %}{{ icon('ph:bold/sun') }}{% endset %}
    {% set icon_moon %}{{ icon('ph:bold/moon') }}{% endset %}
    <div class="cluster">{{ macros.render_switches(render_pass, icon_moon, icon_sun) }}</div>
    <div class="block block--padded cluster">{{ macros.render_switches(render_pass, icon_moon, icon_sun) }}</div>
    <div class="toolbar">{{ macros.render_switches(render_pass, icon_moon, icon_sun) }}</div>
{%- endblock -%}
