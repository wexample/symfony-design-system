{%- extends '@WexampleSymfonyDesignSystemBundle/pages/design_system/generic/actions/layout/layout-actions.html.twig' -%}

{%- macro render_buttons() -%}
    {{ button('ph:bold/plus', '@page::button.primary' | trans) }}
    {{ button('ph:bold/check', '@page::button.success' | trans) }}
    {{ button('ph:bold/trash', '@page::button.danger' | trans) }}
    {{ button('ph:bold/sun', '@page::button.invert' | trans, { class: 'button--invert' }) }}
{%- endmacro -%}

{%- macro render_button_states() -%}
    {{ button('ph:bold/plus', '@page::button.state.default' | trans) }}
    {{ button('ph:bold/plus', '@page::button.state.loading' | trans, { class: 'is-loading' }) }}
    {{ button('ph:bold/plus', '@page::button.state.disabled' | trans, { disabled: true }) }}
    {{ button('ph:bold/plus', '@page::button.state.assisted' | trans, { class: 'is-assisted' }) }}
{%- endmacro -%}

{%- macro render_links() -%}
    {{ button_link('ph:bold/arrow-right', '@page::link.more' | trans, app_home_url()) }}
    {{ button_link('ph:bold/arrow-up-right', '@page::link.external' | trans, 'https://example.com', { attr: { target: '_blank', rel: 'noopener noreferrer' } }) }}
    {{ button_link('ph:bold/arrow-right', '@page::link.more' | trans, '#', { class: 'is-assisted' }) }}
{%- endmacro -%}

{%- macro render_compound(render_pass, options, menu_items) -%}
    {{ button('ph:bold/plus', '@page::button.primary' | trans) }}
    <select class="form--input form--input--select form--input--inline">
        <option>{{ '@page::select.option_one' | trans }}</option>
        <option>{{ '@page::select.option_two' | trans }}</option>
        <option>{{ '@page::select.option_three' | trans }}</option>
    </select>
    {{ button_menu('ph:bold/list', '@page::menu.primary' | trans, menu_items, { menu_align: 'right' }) }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/switch', { label: '@page::switch.label_right' }) }}
    {{ button_link('ph:bold/arrow-up-right', '@page::link.external' | trans, 'https://example.com', { attr: { target: '_blank', rel: 'noopener noreferrer' } }) }}
{%- endmacro -%}

{%- block page_body -%}
    {% import _self as macros %}

    {% set select_options = [
        { value: 'one',   label: '@page::select.option_one' },
        { value: 'two',   label: '@page::select.option_two' },
        { value: 'three', label: '@page::select.option_three' }
    ] %}

    {% set menu_items = [
        { icon: 'ph:bold/clipboard-text', label: '@page::menu.item.report',   href: app_home_url() },
        { icon: 'ph:bold/gear',           label: '@page::menu.item.settings', href: app_home_url() },
        { icon: 'ph:bold/sign-out',       label: '@page::menu.item.logout',   href: app_home_url() },
        { icon: 'ph:bold/text-aa',        label: '@page::menu.item.long',     href: app_home_url() }
    ] %}

    <h2>{{ '@page::section.buttons.title' | trans }}</h2>
    <div class="cluster">{{ macros.render_buttons() }}</div>
    <div class="block block--padded cluster">{{ macros.render_buttons() }}</div>
    <div class="toolbar">{{ macros.render_buttons() }}</div>

    <h2>{{ '@page::section.button_states.title' | trans }}</h2>
    <div class="cluster">{{ macros.render_button_states() }}</div>
    <div class="block block--padded cluster">{{ macros.render_button_states() }}</div>
    <div class="toolbar">{{ macros.render_button_states() }}</div>

    <h2>{{ '@page::section.link.title' | trans }}</h2>
    <div class="cluster">{{ macros.render_links() }}</div>
    <div class="block block--padded cluster">{{ macros.render_links() }}</div>
    <div class="toolbar">{{ macros.render_links() }}</div>

    <h2>{{ '@page::section.compound.title' | trans }}</h2>
    <div class="cluster">{{ macros.render_compound(render_pass, select_options, menu_items) }}</div>
    <div class="block block--padded cluster">{{ macros.render_compound(render_pass, select_options, menu_items) }}</div>
    <div class="toolbar">{{ macros.render_compound(render_pass, select_options, menu_items) }}</div>
{%- endblock -%}
