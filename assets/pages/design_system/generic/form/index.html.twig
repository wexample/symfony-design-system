{%- extends '@WexampleSymfonyDesignSystemBundle/pages/design_system/generic/form/layout/layout-form.html.twig' -%}

{%- block page_body -%}
        <h2>{{ '@page::section.default.title' | trans }}</h2>
        <form class="form">
            <div class="form--group">
                <label class="form--label" for="form-title">{{ '@page::field.title.label' | trans }}</label>
                <input class="form--input" id="form-title" type="text"
                       placeholder="{{ '@page::field.title.placeholder' | trans }}">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-message">{{ '@page::field.message.label' | trans }}</label>
                <textarea class="form--textarea" id="form-message" rows="4"
                          placeholder="{{ '@page::field.message.placeholder' | trans }}"></textarea>
            </div>
            <div class="form--group">
                <label class="form--label" for="form-date">{{ '@page::field.date.label' | trans }}</label>
                <input class="form--input" id="form-date" type="date">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-datetime">{{ '@page::field.datetime.label' | trans }}</label>
                <input class="form--input" id="form-datetime" type="datetime-local">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-time">{{ '@page::field.time.label' | trans }}</label>
                <input class="form--input" id="form-time" type="time">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-file">{{ '@page::field.file.label' | trans }}</label>
                <input class="form--input form--input-file" id="form-file" type="file">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-email">{{ '@page::field.email.label' | trans }}</label>
                <input class="form--input" id="form-email" type="email" placeholder="you@example.com">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-number">{{ '@page::field.number.label' | trans }}</label>
                <input class="form--input" id="form-number" type="number">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-url">{{ '@page::field.url.label' | trans }}</label>
                <input class="form--input" id="form-url" type="url" placeholder="https://">
            </div>
            <div class="form--actions">
                <a href="#">{{ '@page::action.link' | trans }}</a>
                {{ button('ph:bold/island', '@page::action.secondary' | trans) }}
                {{ form_submit('ph:bold/paper-plane-tilt', '@page::action.submit' | trans) }}
            </div>
        </form>
        <h2>{{ '@page::section.block.title' | trans }}</h2>
        <div class="block block--padded">
            <form class="form">
                <div class="stack--horizontal">
                    <div class="form--group">
                        <label class="form--label" for="form-title">{{ '@page::field.title.label' | trans }}</label>
                        <input class="form--input" id="form-title" type="text"
                               placeholder="{{ '@page::field.title.placeholder' | trans }}">
                    </div>
                    <div class="form--group">
                        <label class="form--label" for="form-title">{{ '@page::field.title.label' | trans }}</label>
                        <input class="form--input" id="form-title" type="text"
                               placeholder="{{ '@page::field.title.placeholder' | trans }}">
                    </div>
                </div>
                <div class="form--actions">
                    <input type="submit" value="{{ '@page::action.raw_submit' | trans }}">
                </div>
            </form>
        </div>
        <div class="block block--padded block--vertical">
            <h2>{{ '@page::section.assisted.title' | trans }}</h2>
            <form class="form is-assisted">
                <div class="form--group">
                    <label class="form--label"
                           for="form-assisted-title">{{ '@page::field.title.label' | trans }}</label>
                    <input class="form--input" id="form-assisted-title" type="text"
                           placeholder="{{ '@page::field.title.placeholder' | trans }}">
                </div>
                <div class="form--actions">
                    {{ form_submit('ph:bold/paper-plane-tilt', '@page::action.submit' | trans) }}
                </div>
            </form>
        </div>
{%- endblock -%}
