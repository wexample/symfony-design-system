{%- extends '@WexampleSymfonyDesignSystemBundle/layouts/default/layout.html.twig' -%}

{%- block layout_config -%}
    {{- render_pass.layoutRenderNode.setDefaultView(_self) -}}
    {{ parent() }}
{%- endblock -%}

{#- What every page carries whatever it looks like: the toasts, the tooltip,
    and what the scripts open over the page. -#}
{%- block page_layout_components -%}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/toast-stack') }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/tooltip') }}
    {{ component_frontend(render_pass, '@WexampleSymfonyDesignSystemBundle/components/confirm') }}
    {{ component_frontend(render_pass, '@WexampleSymfonyDesignSystemBundle/components/banner') }}
    {{ component_frontend(render_pass, '@WexampleSymfonyDesignSystemBundle/components/overlay') }}
{%- endblock -%}

{%- block page_composer_html -%}
    {#- A page asking for focus (`page_focus`) — signing in, a code, terms to
        accept — is one thing to do and nothing around it: no menu, no title
        bar, a narrow column under the application's mark, and only what the
        header offers anyone, a language, a scheme. -#}
    {%- if page_focus|default(false) -%}
        <div class="layout--focus">
            <header class="layout--focus-header">
                <div class="layout--focus-logo">{{- block('page_menu_logo') -}}</div>
                {{- block('page_header_menu_right') -}}
            </header>
            <div class="layout--focus-body" id="main-content" tabindex="-1">
                <section class="layout--body layout--body--{{ page_body_mode|default('default') }}">
                    {{- block('page_body_container') -}}
                </section>
            </div>
            <footer class="footer">
                <div class="footer--body"></div>
                {{- block('footer_items') -}}
            </footer>
            {{- block('page_layout_components') -}}
        </div>
    {%- else -%}
    {#- The sections in the header (`layout_navigation: 'top'`) rather than in a
        menu down the side: one bar, the page's title moving into the page with
        the actions the toolbar held, the way back above it. -#}
    {%- set navigationTop = layout_navigation|default('side') == 'top' -%}
    {%- if navigationTop -%}
        {%- set page_show_title = true -%}
        {%- set page_trail = page_trail ?? 'back' -%}
        {%- set page_title_actions_extra -%}{{ block('page_toolbar_left') }}{{ block('page_toolbar_right') }}{%- endset -%}
    {%- endif -%}
    {# Rendered up front so the header toggle and the panel itself can both tell
       whether the page has anything to put in the right menu. #}
    {% set menuRight %}{% block page_menu_right_body %}{% endblock %}{% endset %}
    {% set menuRight = menuRight|trim %}

    <div class="layout--horizontal">
        <div class="gutters--body layout--body--overlay-scope">
            <div class="layout--horizontal">
                {%- if not navigationTop -%}
                <div class="{{ component_init_class(render_pass, '@WexampleSymfonyDesignSystemBundle/components/menu-collapsible-panel') }} gutters--collapsible{% if not ui_state_get('ui.layout.menu.left', true) %} gutters--collapsible--collapsed{% endif %}" data-menu-id="left">
                    {% block page_menu %}
                        <nav class="menu menu--vertical menu--vertical--left">
                            {% block page_menu_header %}
                                <div class="menu--header menu--bar">
                                    <div class="menu--bar--content menu--bar--content--end">
                                        {% block page_menu_logo %}{% endblock %}
                                        {% block page_menu_toggle_close %}
                                            <a class="menu--bar--icon menu--toggle-close" href="#">
                                                {{ icon('ph:bold/text-outdent') }}
                                            </a>
                                        {% endblock %}
                                    </div>
                                </div>
                            {% endblock %}
                            <div class="menu--body">
                                <ul class="menu--items">
                                    {% block page_menu_links %}{% endblock %}
                                </ul>
                            </div>
                            {% block page_menu_footer %}{% endblock %}
                        </nav>
                    {% endblock %}
                </div>
                {%- endif -%}
                <div class="layout--body--scrollable">
                    <div class="layout--vertical" id="main-content" tabindex="-1">
                        {% block page_header %}
                            <header class="header">
                                {%- if navigationTop -%}
                                    <div class="header--brand">{{- block('page_menu_logo') -}}</div>
                                    {#- One section has no tab: the mark leads home. -#}
                                    {%- set headerTabs %}{{ block('page_menu_links') }}{% endset -%}
                                    {%- if headerTabs|split('<li')|length > 2 -%}
                                        {%- set tabsLabel = 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.navigation'|trans -%}
                                        <nav class="header--tabs" aria-label="{{ tabsLabel }}">
                                            <ul class="header--tabs-list">{{ headerTabs }}</ul>
                                            <button type="button" class="header--tabs-toggle" popovertarget="header-tabs-popover" aria-label="{{ tabsLabel }}" title="{{ tabsLabel }}">{{ icon('ph:bold/list') }}</button>
                                            <ul class="header--tabs-popover" id="header-tabs-popover" popover>{{ headerTabs }}</ul>
                                        </nav>
                                    {%- endif -%}
                                    <div class="header--body"></div>
                                {%- else -%}
                                {% block page_header_menu_left %}
                                    <nav class="header--menu">
                                        <a class="header--menu-item header--menu-item--icon" href="#" data-menu-target="left">
                                            {{ icon('ph:bold/list') }}
                                        </a>
                                    </nav>
                                {% endblock %}
                                <div class="header--body">
                                    {% block header_body %}
                                        {%- if not (page_show_title|default(false)) -%}
                                            <h1 class="visually-hidden">{{ page_title | default('@page::page_title' | trans) }}</h1>
                                        {%- endif -%}
                                        <div class="header--title">
                                            {{ page_title | default('@page::page_title' | trans) }}
                                        </div>
                                        {#- What a page says about the thing it is titled
                                            after, beside its name: a state, a version, a
                                            branch — markers, mostly. -#}
                                        {%- set headerTitleAside %}{% block header_title_aside %}{% endblock %}{% endset -%}
                                        {%- if headerTitleAside|trim is not empty -%}
                                            <div class="header--title-aside">{{ headerTitleAside }}</div>
                                        {%- endif -%}
                                    {% endblock %}
                                </div>
                                {%- endif -%}
                                {% block page_header_menu_right %}
                                    {% if menuRight is not empty %}
                                        <nav class="header--menu">
                                            <a class="header--menu-item header--menu-item--icon" href="#" data-menu-target="right">
                                                {{ icon('ph:bold/sidebar-simple') }}
                                            </a>
                                        </nav>
                                    {% endif %}
                                {% endblock %}
                            </header>
                        {% endblock %}
                        {% block page_navigation %}{% endblock %}
                        {%- if not navigationTop -%}
                        {% block page_toolbar %}
                            {% set toolbarLeft %}{% block page_toolbar_left %}{% endblock %}{% endset %}
                            {% set toolbarRight %}{% block page_toolbar_right %}{% endblock %}{% endset %}
                            {% set toolbarLeft = toolbarLeft|trim %}
                            {% set toolbarRight = toolbarRight|trim %}
                            {% if toolbarLeft is not empty or toolbarRight is not empty %}
                                <div class="toolbar toolbar--top">
                                    <div class="toolbar--group">{{ toolbarLeft|raw }}</div>
                                    <div class="toolbar--group align-right">{{ toolbarRight|raw }}</div>
                                </div>
                            {% endif %}
                        {% endblock %}
                        {%- endif -%}
                        <section class="layout--body layout--body--{{ page_body_mode|default('default') }}">
                            {{- block('page_body_container') -}}
                        </section>
                        <footer class="footer">
                            <div class="footer--body">
                                {% block footer_body %}
                                    {#- On top, the trail stands above the title instead. -#}
                                    {%- if not navigationTop -%}
                                        {{ breadcrumb_render({ current_label: page_title|default(null) }) }}
                                    {%- endif -%}
                                {% endblock %}
                            </div>
                            {#- What the footer holds beside the trail: status widgets,
                                a version number — each in its own footer-item. -#}
                            {% block footer_items %}{% endblock %}
                        </footer>
                    </div>
                </div>
                {#- Outside the scroller: it contains what is fixed in it (see
                    `.layout--body--scrollable`), and these keep to the window. -#}
                {{- block('page_layout_components') -}}
            </div>
        </div>
        {% if menuRight is not empty %}
            <div class="{{ component_init_class(render_pass, '@WexampleSymfonyDesignSystemBundle/components/menu-collapsible-panel') }} gutters--collapsible{% if not ui_state_get('ui.layout.menu.right', false) %} gutters--collapsible--collapsed{% endif %}" data-menu-id="right">
                {% block page_menu_right %}
                    <nav class="menu menu--vertical menu--vertical--right">
                        {% block page_menu_right_header %}
                            <div class="menu--header menu--bar">
                                <div class="menu--bar--content menu--bar--content--start">
                                    {% block page_menu_right_toggle_close %}
                                        <a class="menu--bar--icon menu--toggle-close" href="#">
                                            {{ icon('ph:bold/text-indent') }}
                                        </a>
                                    {% endblock %}
                                </div>
                            </div>
                        {% endblock %}
                        <div class="menu--body">
                            {{ menuRight|raw }}
                        </div>
                        {% block page_menu_right_footer %}{% endblock %}
                    </nav>
                {% endblock %}
            </div>
        {% endif %}
    </div>
    {%- endif -%}
{%- endblock -%}
