{%- extends '@WexampleSymfonyDesignSystemBundle/layouts/default/layout.html.twig' -%}

{%- block layout_config -%}
    {{- render_pass.layoutRenderNode.setDefaultView(_self) -}}
    {{ parent() }}
{%- endblock -%}

{#- What every page carries whatever it looks like: the toasts, the tooltip,
    and what the scripts open over the page. -#}
{%- block page_layout_components -%}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/toast-stack') }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/tooltip') }}
    {{ component_frontend(render_pass, '@WexampleSymfonyDesignSystemBundle/components/confirm') }}
    {{ component_frontend(render_pass, '@WexampleSymfonyDesignSystemBundle/components/banner') }}
    {{ component_frontend(render_pass, '@WexampleSymfonyDesignSystemBundle/components/overlay') }}
    {#- The three windows a script can show something in itself (showInTarget()). -#}
    {{ component_frontend(render_pass, '@WexampleSymfonyDesignSystemBundle/components/modal') }}
    {{ component_frontend(render_pass, '@WexampleSymfonyDesignSystemBundle/components/panel') }}
    {{ component_frontend(render_pass, '@WexampleSymfonyDesignSystemBundle/components/dock') }}
{%- endblock -%}

{#- The footer at the end of the page rather than under it (`layout_footer: 'page'`). -#}
{#- A page's own bar under the header: a record's tabs (`page_tabs`). -#}
{%- block page_navigation -%}{%- endblock -%}

{%- block page_foot -%}
    {#- A page asking for focus draws its own footer. -#}
    {%- if layout_footer|default('fixed') == 'page' and not page_focus|default(false) -%}
        {{- block('layout_footer') -}}
    {%- endif -%}
{%- endblock -%}

{%- block page_composer_html -%}
    {#- A page asking for focus (`page_focus`) — signing in, a code, terms to
        accept — is one thing to do and nothing around it: no menu, no title
        bar, a narrow column under the application's mark, and only what the
        header offers anyone, a language, a scheme. -#}
    {# Rendered up front so the header toggle and the panel itself can both tell
       whether the page has anything to put in the right menu. #}
    {% set menuRight %}{% block page_menu_right_body %}{% endblock %}{% endset %}
    {% set menuRight = menuRight|trim %}
    {%- if page_focus|default(false) -%}
        <div class="layout--focus">
            <header class="layout--focus-header">
                <div class="layout--focus-logo">{{- block('page_menu_logo') -}}</div>
                {{- block('page_header_menu_right') -}}
            </header>
            {#- `page_focus_width: 'reading'`: a text to read through — terms, codes
                to keep — rather than a short form. -#}
            <div class="layout--focus-body{{ page_focus_width|default(null) ? ' layout--focus-body--' ~ page_focus_width }}" id="main-content" tabindex="-1">
                <section class="layout--body layout--body--{{ page_body_mode|default('default') }}">
                    {{- block('page_body_container') -}}
                </section>
            </div>
            <footer class="footer">
                <div class="footer--body">{{- block('footer_start') -}}</div>
                {{- block('footer_environment') -}}
                {{- block('footer_items') -}}
            </footer>
            {{- block('page_layout_components') -}}
        </div>
    {%- else -%}
    {#- The sections in the header (`layout_navigation: 'top'`) rather than in a
        menu down the side: one bar, the page's title moving into the page with
        the actions the toolbar held, the way back above it. -#}
    {%- set navigationTop = layout_navigation|default('side') == 'top' -%}
    {%- if navigationTop -%}
        {#- Unless the page says it has none (`page_show_title: false`): a
            workspace — panes side by side — is its own heading, and keeps its
            actions in the toolbar under the header, as on the side. -#}
        {%- set page_show_title = page_show_title ?? true -%}
        {%- set page_trail = page_trail ?? 'back' -%}
        {#- Drawn once, where they stand: beside a title, or else in the toolbar —
            a component drawn twice would leave one of its two copies unplaced. -#}
        {%- if page_show_title -%}
            {%- set page_title_actions_extra -%}{{ block('page_toolbar_left') }}{{ block('page_toolbar_right') }}{%- endset -%}
        {%- endif -%}
        {#- The header holds no title on top: its aside follows the title into the page. -#}
        {%- set page_title_aside %}{{ block('header_title_aside') }}{% endset -%}
    {%- endif -%}
    {#- The bar under the header: the page's own navigation (`page_navigation`,
        a record's tabs), or else the way back at its start and the page's
        actions at its end — a toolbar, the way a record's tabs stand, and not
        a trail over the title with the actions beside it. On top, every page
        with a parent has it; on the side, the pages saying so
        (`page_trail: 'back'`), the menu already telling where one is. -#}
    {%- set pageNavigation %}{{ block('page_navigation') }}{% endset -%}
    {#- The views of the section a page stands in (`page_section_navigation`,
        NavigationService), written once by the section and drawn as the app
        chooses (`layout_section_navigation`): tabs under the header, or the
        side menu standing for the section — its way back out first —, the
        bar then keeping the section's actions alone. A page drawing its own
        navigation keeps it. -#}
    {%- set sectionNavigation = page_section_navigation|default(null) -%}
    {%- set sectionNavigationMenu = sectionNavigation and layout_section_navigation|default('tabs') == 'menu' -%}
    {%- if sectionNavigation and pageNavigation|trim is empty -%}
        {%- if sectionNavigationMenu -%}
            {%- if sectionNavigation.actions|default(null) -%}
                {%- set pageNavigation %}{{ page_tabs([], { back: false, actions: sectionNavigation.actions }) }}{% endset -%}
            {%- endif -%}
        {%- else -%}
            {%- set pageNavigation %}{{ page_tabs(sectionNavigation) }}{% endset -%}
        {%- endif -%}
    {%- endif -%}
    {%- if page_show_title|default(false) and pageNavigation|trim is empty and page_trail|default(null) == 'back' -%}
        {%- set pageBack = breadcrumb_render({ back: true })|trim -%}
        {%- if pageBack is not empty -%}
            {%- set pageBarActions %}{{ block('page_title_actions') }}{{ page_title_actions_extra|default('') }}{% endset -%}
            {#- A list of actions (`page_bar_actions`, as a menu's items) rather
                than markup: drawn as buttons, gathered in ⋮ on a phone. -#}
            {%- set pageNavigation %}{{ page_tabs([], { back: true, actions: page_bar_actions ?? (pageBarActions|trim ?: null) }) }}{% endset -%}
            {%- set page_trail = false -%}
            {%- set page_title_actions_hidden = true -%}
        {%- endif -%}
    {%- endif -%}
    {#- The bar of tools standing against the window's end, as an IDE has one
        (tool_dock()): the application's, written once by its layout
        (`layout_dock_tools`), and what the page adds to them for itself
        (`page_dock_tools`) — the findings of the file it shows, a preview of
        it. One list, so a page names its tools and nothing else: where they
        stand, what each one opened and the width it was left at are the
        dock's to keep. No tool, no bar. -#}
    {%- set dockTools = (layout_dock_tools|default([]))|merge(page_dock_tools|default([])) -%}

    {#- The dock is a region of the layout's row and not of the page: it stands
        beside everything the page has — its header, its footer —, and the row
        takes it out when nothing in it is open (shapes/zone). Joined, as the
        side menus stand against the page: the room round what a tool opens is
        the dock's own (components/tool-dock). -#}
    <div class="layout--horizontal{{ dockTools is not empty ? ' zone--split zone--split--joined' }}">
        <div class="gutters--body layout--body--overlay-scope">
            <div class="layout--horizontal">
                {%- if not navigationTop -%}
                {#- A side menu the visitor may widen (`menu_left_resizable`,
                    `menu_right_resizable`): an invisible handle on its edge
                    against the page, the cursor saying it moves, and the width
                    it is left at kept as its being open is. -#}
                {%- set menuLeftResizable = menu_left_resizable|default(false) -%}
                {%- set menuLeftSize = menuLeftResizable ? ui_state_get('ui.layout.menu.left.size') : null -%}
                <div class="{{ component_init_class(render_pass, '@WexampleSymfonyDesignSystemBundle/components/menu-collapsible-panel') }} gutters--collapsible{% if not ui_state_get('ui.layout.menu.left', true) %} gutters--collapsible--collapsed{% endif %}" id="layout-menu-left" data-menu-id="left"
                    {%- if menuLeftResizable %} data-resize-state="ui.layout.menu.left.size" data-resize-property="--menu-size"{% if menuLeftSize > 0 %} style="--menu-size: {{ menuLeftSize|round }}px"{% endif %}{% endif %}>
                    {%- if menuLeftResizable -%}
                        {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer', {}, { edge: 'end' }) }}
                    {%- endif -%}
                    {% block page_menu %}
                        <nav class="menu menu--vertical menu--vertical--left">
                            {% block page_menu_header %}
                                <div class="menu--header menu--bar">
                                    <div class="menu--bar--content menu--bar--content--end">
                                        {% block page_menu_logo %}{% endblock %}
                                        {% block page_menu_toggle_close %}
                                            <a class="menu--bar--icon menu--toggle-close" href="#" role="button" aria-controls="layout-menu-left" aria-label="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.close_left'|trans }}" title="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.close_left'|trans }}">
                                                {{ icon('ph:bold/text-outdent') }}
                                            </a>
                                        {% endblock %}
                                    </div>
                                </div>
                            {% endblock %}
                            <div class="menu--body">
                                <ul class="menu--items">
                                    {%- if sectionNavigationMenu -%}
                                        {{ menu_navigation(sectionNavigation) }}
                                    {%- else -%}
                                        {% block page_menu_links %}{% endblock %}
                                    {%- endif -%}
                                </ul>
                            </div>
                            {% block page_menu_footer %}{% endblock %}
                        </nav>
                    {% endblock %}
                </div>
                {%- endif -%}
                {#- What stands still — the header, the page's navigation, the
                    footer — around the one thing that scrolls, the body, on
                    both axes: a page wider than the window slides under them. -#}
                <div class="layout--vertical" id="main-content" tabindex="-1">
                        {% block page_header %}
                            <header class="header">
                                {%- if navigationTop -%}
                                    <div class="header--brand">{{- block('page_menu_logo') -}}</div>
                                    {#- One section has no tab: the mark leads home. -#}
                                    {%- set headerTabs %}{{ sectionNavigationMenu ? menu_navigation(sectionNavigation) : block('page_menu_links') }}{% endset -%}
                                    {%- if headerTabs|split('<li')|length > 2 -%}
                                        {%- set tabsLabel = 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.navigation'|trans -%}
                                        <nav class="header--tabs" aria-label="{{ tabsLabel }}">
                                            <ul class="header--tabs-list">{{ headerTabs }}</ul>
                                            <button type="button" class="header--tabs-toggle" popovertarget="header-tabs-popover" aria-label="{{ tabsLabel }}" title="{{ tabsLabel }}">{{ icon('ph:bold/list') }}</button>
                                            <ul class="header--tabs-popover" id="header-tabs-popover" popover>{{ headerTabs }}</ul>
                                        </nav>
                                    {%- endif -%}
                                    <div class="header--body"></div>
                                {%- else -%}
                                {% block page_header_menu_left %}
                                    <nav class="header--menu">
                                        <a class="header--menu-item header--menu-item--icon" href="#" data-menu-target="left" role="button" aria-controls="layout-menu-left" aria-label="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.open_left'|trans }}" title="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.open_left'|trans }}">
                                            {{ icon('ph:bold/list') }}
                                        </a>
                                    </nav>
                                {% endblock %}
                                <div class="header--body">
                                    {% block header_body %}
                                        {%- if not (page_show_title|default(false)) -%}
                                            <h1 class="visually-hidden">{{ page_title|default(null) ?: '@page::page_title'|trans }}</h1>
                                        {%- endif -%}
                                        <div class="header--title">
                                            {{ page_title|default(null) ?: '@page::page_title'|trans }}
                                        </div>
                                        {#- What a page says about the thing it is titled
                                            after, beside its name: a state, a version, a
                                            branch — markers, mostly. -#}
                                        {%- set headerTitleAside %}{% block header_title_aside %}{% endblock %}{% endset -%}
                                        {%- if headerTitleAside|trim is not empty -%}
                                            <div class="header--title-aside">{{ headerTitleAside }}</div>
                                        {%- endif -%}
                                    {% endblock %}
                                </div>
                                {%- endif -%}
                                {% block page_header_menu_right %}
                                    {#- The application's controls, in three parts: those always
                                        in the bar (`header_menu_start`, `header_menu_end`, around
                                        the side panel's toggle), and those a phone or a tablet
                                        folds behind one button (`header_menu_overflow`) — the GitHub link,
                                        a theme, the color scheme. Wide enough, the fold is not
                                        seen: its items stand in the bar with the others. -#}
                                    {%- set headerMenuStart -%}{% block header_menu_start %}{% endblock %}{%- endset -%}
                                    {%- set headerMenuOverflow -%}{% block header_menu_overflow %}{% endblock %}{%- endset -%}
                                    {%- set headerMenuEnd -%}{% block header_menu_end %}{% endblock %}{%- endset -%}
                                    {% if menuRight is not empty or headerMenuStart|trim or headerMenuOverflow|trim or headerMenuEnd|trim %}
                                        <nav class="header--menu">
                                            {{- headerMenuStart -}}
                                            {%- if headerMenuOverflow|trim -%}
                                                {%- set overflowLabel = 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.more'|trans -%}
                                                <button type="button" class="header--menu-item header--menu-item--icon header--overflow-toggle" popovertarget="header-menu-overflow" aria-label="{{ overflowLabel }}" title="{{ overflowLabel }}">
                                                    {{ icon('ph:bold/dots-three') }}
                                                </button>
                                                <div class="header--overflow" id="header-menu-overflow" popover>
                                                    {{- headerMenuOverflow -}}
                                                </div>
                                            {%- endif -%}
                                            {%- if menuRight is not empty -%}
                                                <a class="header--menu-item header--menu-item--icon" href="#" data-menu-target="right" role="button" aria-controls="layout-menu-right" aria-label="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.open_right'|trans }}" title="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.open_right'|trans }}">
                                                    {{ icon('ph:bold/sidebar-simple') }}
                                                </a>
                                            {%- endif -%}
                                            {{- headerMenuEnd -}}
                                        </nav>
                                    {% endif %}
                                {% endblock %}
                            </header>
                        {% endblock %}
                        {{- pageNavigation -}}
                        {%- if not navigationTop or not page_show_title -%}
                        {% block page_toolbar %}
                            {% set toolbarLeft %}{% block page_toolbar_left %}{% endblock %}{% endset %}
                            {% set toolbarRight %}{% block page_toolbar_right %}{% endblock %}{% endset %}
                            {% set toolbarLeft = toolbarLeft|trim %}
                            {% set toolbarRight = toolbarRight|trim %}
                            {% if toolbarLeft is not empty or toolbarRight is not empty %}
                                <div class="toolbar toolbar--top">
                                    <div class="toolbar--group">{{ toolbarLeft|raw }}</div>
                                    <div class="toolbar--group align-right">{{ toolbarRight|raw }}</div>
                                </div>
                            {% endif %}
                        {% endblock %}
                        {%- endif -%}
                        <div class="layout--body--scrollable">
                            {#- A page held to no measure (`page_measure: false`) is as wide
                                as what it holds, and so is the body under it: its ground
                                and its footer follow a table wider than the window. -#}
                            <section class="layout--body layout--body--{{ page_body_mode|default('default') }}{{ not (page_measure ?? true) and page_body_mode|default('default') != 'wide' ? ' layout--body--hug' }}">
                                {{- block('page_body_container') -}}
                            </section>
                        </div>
                        {#- Where the footer stands (`layout_footer`): `fixed`, under the
                            body that scrolls, always in view; `page`, at the end of the
                            page, the panel's whole width, scrolling with it. -#}
                        {#- What the application puts at the footer's start, on every page,
                            focused ones included (`footer_start`): links owed to everyone,
                            legal texts. -#}
                        {%- if false -%}{%- block footer_start -%}{%- endblock -%}{%- endif -%}
                        {%- if layout_footer|default('fixed') == 'fixed' -%}
                        {%- block layout_footer -%}
                        <footer class="footer footer--{{ layout_footer|default('fixed') }}">
                            <div class="footer--body">
                                {% block footer_body %}
                                    {#- On top, the trail stands above the title instead. -#}
                                    {%- if not (navigationTop ?? false) -%}
                                        {{ breadcrumb_render({ current_label: page_title|default(null) }) }}
                                    {%- endif -%}
                                {% endblock %}
                                {{- block('footer_start') -}}
                            </div>
                            {#- Anything but production says so, in the dev tone: the
                                environment named, and the development menu it opens —
                                what the installed bundles offer (dev_menu()). -#}
                            {%- block footer_environment -%}
                                {%- if app.environment != 'prod' -%}
                                    <div class="footer-item">{{ dev_menu() }}</div>
                                {%- endif -%}
                            {%- endblock -%}
                            {#- How what the page holds stands — an editor saving —, said
                                from wherever it is drawn, an embed included: a component
                                teleports its word here (`#footer-status`). Holding
                                nothing, it takes no room. -#}
                            <div class="footer-item footer-item--status text-secondary" id="footer-status"></div>
                            {#- What the footer holds beside the trail: status widgets,
                                a version number — each in its own footer-item. -#}
                            {% block footer_items %}{% endblock %}
                        </footer>
                        {%- endblock -%}
                        {%- endif -%}
                </div>
                {{- block('page_layout_components') -}}
            </div>
        </div>
        {% if menuRight is not empty %}
            {%- set menuRightResizable = menu_right_resizable|default(false) -%}
            {%- set menuRightSize = menuRightResizable ? ui_state_get('ui.layout.menu.right.size') : null -%}
            <div class="{{ component_init_class(render_pass, '@WexampleSymfonyDesignSystemBundle/components/menu-collapsible-panel') }} gutters--collapsible{% if not ui_state_get('ui.layout.menu.right', false) %} gutters--collapsible--collapsed{% endif %}" id="layout-menu-right" data-menu-id="right"
                {%- if menuRightResizable %} data-resize-state="ui.layout.menu.right.size" data-resize-property="--menu-size"{% if menuRightSize > 0 %} style="--menu-size: {{ menuRightSize|round }}px"{% endif %}{% endif %}>
                {%- if menuRightResizable -%}
                    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer', {}, { edge: 'start' }) }}
                {%- endif -%}
                {% block page_menu_right %}
                    <nav class="menu menu--vertical menu--vertical--right">
                        {% block page_menu_right_header %}
                            <div class="menu--header menu--bar">
                                <div class="menu--bar--content menu--bar--content--start">
                                    {% block page_menu_right_toggle_close %}
                                        <a class="menu--bar--icon menu--toggle-close" href="#" role="button" aria-controls="layout-menu-right" aria-label="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.close_right'|trans }}" title="{{ 'WexampleSymfonyDesignSystemBundle.common.system::frontend.menu.close_right'|trans }}">
                                            {{ icon('ph:bold/text-indent') }}
                                        </a>
                                    {% endblock %}
                                </div>
                            </div>
                        {% endblock %}
                        <div class="menu--body">
                            {{ menuRight|raw }}
                        </div>
                        {% block page_menu_right_footer %}{% endblock %}
                    </nav>
                {% endblock %}
            </div>
        {% endif %}
        {%- if dockTools is not empty -%}
            {{ tool_dock('layout', dockTools, { class: 'tool-dock--layout' }) }}
        {%- endif -%}
    </div>
    {%- endif -%}
{%- endblock -%}
