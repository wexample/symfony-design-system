{%- extends '@WexampleSymfonyLoaderBundle/layouts/default/layout.html.twig' -%}

{%- block layout_config -%}
    {#- On the stack, so the axis files shipped beside this layout are found
        for every app layout built on it. -#}
    {{- render_pass.layoutRenderNode.setDefaultView(_self) -}}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::*') }}
    {#- What the interface remembers, handed to the page once: a component
        restoring its state — a tree reopening its branches — reads it where it
        stands rather than every page passing it down. -#}
    {{ var_export(render_pass, 'uiState', ui_state_all()) }}
{%- endblock -%}

{#- Every page body is the same split of zones, whatever it holds: the page's
    own zone, and around it whatever regions the page opens beside it — a tree
    before, a detail after. Adding a neighbour is filling a block, never
    rebuilding the page's zone, so a page reads alike with or without one. -#}
{%- block page_body_container -%}
    {#- Words the stylesheets write themselves — the mark of an optional field
        — in the page's language, as custom properties every rule can read.
        Here and not in the layout's config, which a json response prints too. -#}
    <style>:root { --form-optional-label: {{ ('WexampleSymfonyDesignSystemBundle.common.system::frontend.form.optional'|trans)|json_encode|raw }}; }</style>
    {%- set pageZonesBefore %}{% block page_zones_before %}{% endblock %}{% endset -%}
    {%- set pageZonesAfter %}{% block page_zones_after %}{% endblock %}{% endset -%}
    {#- Beside a neighbour the page stops scrolling and each zone scrolls on its
        own; alone, the zone grows with what it holds and the page scrolls — a
        zone scrolling there would hold a sticky header that never sticks. -#}
    {%- set pageZonesScroll = page_body_mode|default('default') == 'wide'
        or pageZonesBefore|trim is not empty
        or pageZonesAfter|trim is not empty -%}
    {#- Without a measure, the row widens to its content — a table wider than
        the window — so the panel's ground runs under it all and the body is
        what scrolls. Not in wide mode, where the zones scroll by themselves. -#}
    {%- set pageZonesGrow = page_body_mode|default('default') != 'wide' and not (page_measure ?? true) -%}
    <div class="zone zone--split{{ pageZonesGrow ? ' zone--split--grow' }}">
        {{- pageZonesBefore -}}
        {#- What stands before the page — a tree — stays where it is: the page's
            zone and those after it are a row of their own, which is what
            scrolls sideways when they ask for more than the window has, with
            its scrollbar under them alone. Not nested without one, so a page
            with nothing before it keeps the one row. -#}
        {%- set pageZonesHeld = pageZonesBefore|trim is not empty -%}
        {%- if pageZonesHeld -%}
            <div class="zone zone--split {{ pageZonesGrow ? 'zone--split--grow' : 'zone--split--floor' }}">
        {%- endif -%}
        {#- The frame is the panel and never scrolls: a handle resizing it hangs
            into the gap beside it, which a scrolling frame would clip. What
            scrolls is the zone inside, and its content carries the room, so a
            sticky header sticks to that zone's edge rather than under a padding.
            A page naming `page_zone_resizable` gets the handle, and the width
            the visitor leaves it at comes back with the page. -#}
        {%- set pageZoneResizable = page_zone_resizable|default(null) -%}
        {#- `page_zone_folded` is the width it folds to while an embed beside it
            holds something, unless the visitor has sized it by hand. -#}
        {#- Held to the reading measure, unless the page is wide or says it
            wants none (`page_measure: false`): then as wide as what it holds —
            a table's columns —, its text wrapping first. Wide also fills the window and scrolls its
            zones; `page_measure: false` alone keeps the page scrolling.
            `page_measure: 'keep'` holds it to the measure for good: it never
            gives way, the row scrolls past the window instead. -#}
        {%- set pageMeasure = page_measure ?? true -%}
        {%- set pageZoneWidth = page_body_mode|default('default') == 'wide' ? '' : (pageMeasure ? ' zone--measure' ~ (pageMeasure is same as('keep') ? ' zone--rigid') : ' zone--hug') -%}
        <div class="zone zone--panel{{ pageZoneWidth }}"{% if pageZoneResizable %} {{ zone_state(pageZoneResizable) }}{% endif %}{% if page_zone_folded|default(null) %} data-zone-folded-size="{{ page_zone_folded }}"{% endif %}>
            {%- if pageZoneResizable -%}
                {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer') }}
            {%- endif -%}
            <div class="zone{{ pageZonesScroll ? ' zone--scrollable' }}">
                <div class="zone--content stack--vertical">
                    {#- What heads the page — its trail, its title, and what a page
                        adds under them (`page_head`): the steps of a tunnel. One
                        piece, so a layout can set it apart from the body it heads. -#}
                    {%- set pageHead -%}
                        {#- Where the page hangs from, above its title (`page_trail`): the
                            way back to the page above, or the whole trail. -#}
                        {%- if page_trail|default(null) -%}
                            {{ breadcrumb_render({ back: page_trail == 'back', current_label: page_title|default(null) }) }}
                        {%- endif -%}
                        {%- if page_show_title|default(false) -%}
                            {#- The page's own actions, and those a layout hands down
                                to stand beside the title (`page_title_actions_extra`). -#}
                            {%- set pageTitleActions %}{% block page_title_actions %}{% endblock %}{{ page_title_actions_extra|default('') }}{%- endset -%}
                            {#- Unless a bar under the header holds them already. -#}
                            {%- set pageTitleActions = page_title_actions_hidden|default(false) ? '' : pageTitleActions|trim -%}
                            {#- What the page says of the thing it is titled after, in a
                                line under its name (`page_subtitle`): when it was made,
                                where it belongs. -#}
                            {#- What the page's state is, beside its name (`page_title_aside`):
                                a marker — active, offline. -#}
                            {%- set pageSubtitle = page_subtitle|default(null) -%}
                            {%- if pageTitleActions is not empty -%}
                                <div class="toolbar page--title-bar">
                                    <div class="page--title-block">
                                        <h1 class="toolbar--title">{{ page_title | default('@page::page_title' | trans) }}</h1>
                                        {%- if page_title_aside|default('')|trim is not empty -%}<span class="page--title-aside">{{- page_title_aside -}}</span>{%- endif -%}
                                        {%- if pageSubtitle -%}<p class="page--subtitle">{{ pageSubtitle }}</p>{%- endif -%}
                                    </div>
                                    <div class="toolbar--group">{{- pageTitleActions|raw -}}</div>
                                </div>
                            {%- else -%}
                                <div class="page--title-block">
                                    <h1 class="page--title">{{ page_title | default('@page::page_title' | trans) }}</h1>
                                    {%- if page_title_aside|default('')|trim is not empty -%}<span class="page--title-aside">{{- page_title_aside -}}</span>{%- endif -%}
                                    {%- if pageSubtitle -%}<p class="page--subtitle">{{ pageSubtitle }}</p>{%- endif -%}
                                </div>
                            {%- endif -%}
                        {%- endif -%}
                        {%- block page_head -%}{%- endblock -%}
                    {%- endset -%}
                    {%- if pageHead|trim is not empty -%}
                        <div class="page--head stack--vertical">{{ pageHead }}</div>
                    {%- endif -%}
                    {{- block('page_body') -}}
                    {#- What the page does, below what it says — kept at the foot
                        of the zone as it scrolls. The same block a modal, a panel
                        or an embed draws in its own foot. -#}
                    {%- set pageActions %}{% block page_actions %}{% endblock %}{% endset -%}
                    {%- if pageActions|trim is not empty -%}
                        <div class="page-actions page-actions--sticky">{{ pageActions }}</div>
                    {%- endif -%}
                </div>
            </div>
        </div>
        {{- pageZonesAfter -}}
        {#- A row always runs its ground to the window's edge: after the page
            held to a width — the measure, or its content's — and whatever
            narrow column stands beside it, a zone takes what is left, the gap
            showing the page under them. It holds nothing, so the page still
            scrolls as one (`zone--filler`), and it steps aside where a zone of
            the row already takes what is left (_zone.scss). -#}
        {%- if page_body_mode|default('default') != 'wide' -%}
            <div class="zone zone--panel zone--filler" aria-hidden="true"></div>
        {%- endif -%}
        {%- if pageZonesHeld -%}
            </div>
        {%- endif -%}
    </div>
    {#- Under the row of zones and across all of them, scrolling with the page
        (`page_foot`): a footer at the end of the page. -#}
    {%- block page_foot -%}{%- endblock -%}
{%- endblock -%}
