{%- extends '@WexampleSymfonyLoaderBundle/layouts/default/layout.html.twig' -%}

{%- block layout_config -%}
    {#- On the stack, so the axis files shipped beside this layout are found
        for every app layout built on it. -#}
    {{- render_pass.layoutRenderNode.setDefaultView(_self) -}}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::*') }}
    {#- What the interface remembers, handed to the page once: a component
        restoring its state — a tree reopening its branches — reads it where it
        stands rather than every page passing it down. -#}
    {{ var_export(render_pass, 'uiState', ui_state_all()) }}
{%- endblock -%}

{#- Every page body is the same split of zones, whatever it holds: the page's
    own zone, and around it whatever regions the page opens beside it — a tree
    before, a detail after. Adding a neighbour is filling a block, never
    rebuilding the page's zone, so a page reads alike with or without one. -#}
{%- block page_body_container -%}
    {%- set pageZonesBefore %}{% block page_zones_before %}{% endblock %}{% endset -%}
    {%- set pageZonesAfter %}{% block page_zones_after %}{% endblock %}{% endset -%}
    {#- Beside a neighbour the page stops scrolling and each zone scrolls on its
        own; alone, the zone grows with what it holds and the page scrolls — a
        zone scrolling there would hold a sticky header that never sticks. -#}
    {%- set pageZonesScroll = page_body_mode|default('default') == 'wide'
        or pageZonesBefore|trim is not empty
        or pageZonesAfter|trim is not empty -%}
    <div class="zone zone--split">
        {{- pageZonesBefore -}}
        {#- The frame is the panel and never scrolls: a handle resizing it hangs
            into the gap beside it, which a scrolling frame would clip. What
            scrolls is the zone inside, and its content carries the room, so a
            sticky header sticks to that zone's edge rather than under a padding.
            A page naming `page_zone_resizable` gets the handle, and the width
            the visitor leaves it at comes back with the page. -#}
        {%- set pageZoneResizable = page_zone_resizable|default(null) -%}
        <div class="zone zone--panel zone--measure"{% if pageZoneResizable %} {{ zone_state(pageZoneResizable) }}{% endif %}>
            {%- if pageZoneResizable -%}
                {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer') }}
            {%- endif -%}
            <div class="zone{{ pageZonesScroll ? ' zone--scrollable' }}">
                <div class="zone--content stack--vertical">
                    {%- if page_show_title|default(false) -%}
                        {%- set pageTitleActions %}{% block page_title_actions %}{% endblock %}{%- endset -%}
                        {%- set pageTitleActions = pageTitleActions|trim -%}
                        {%- if pageTitleActions is not empty -%}
                            <div class="toolbar">
                                <h1 class="toolbar--title">{{ page_title | default('@page::page_title' | trans) }}</h1>
                                <div class="toolbar--group">{{- pageTitleActions|raw -}}</div>
                            </div>
                        {%- else -%}
                            <h1 class="page--title">{{ page_title | default('@page::page_title' | trans) }}</h1>
                        {%- endif -%}
                    {%- endif -%}
                    {{- block('page_body') -}}
                </div>
            </div>
        </div>
        {{- pageZonesAfter -}}
    </div>
{%- endblock -%}
