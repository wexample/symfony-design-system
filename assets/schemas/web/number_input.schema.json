{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "number_input.schema.json",
  "title": "Number input field",
  "description": "A number, held as its text (`value`) as the browser's number field holds it: bounded by `min` and `max`, moved by `step` (`any` for no step), a button on each side to take one step when `stepper`.",
  "type": "object",
  "allOf": [
    { "$ref": "field_base.schema.json" }
  ],
  "properties": {
    "type": {
      "const": "number"
    },
    "min": {
      "type": "number"
    },
    "max": {
      "type": "number"
    },
    "step": {
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "const": "any" }
      ]
    },
    "stepper": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["type", "name", "label"],
  "unevaluatedProperties": false
}
