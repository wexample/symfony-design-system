{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field_base.schema.json",
  "title": "Base field options",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Field name (form key)."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Label displayed to the user."
    },
    "placeholder": {
      "type": ["string", "null"],
      "default": null
    },
    "required": {
      "type": ["boolean", "null"],
      "default": false
    },
    "minLength": {
      "type": "integer",
      "minimum": 0
    },
    "maxLength": {
      "type": "integer",
      "minimum": 1
    },
    "pattern": {
      "type": "string",
      "description": "Regex pattern the value must match."
    },
    "value": {
      "type": ["string", "null"],
      "default": null
    },
    "span": {
      "type": "boolean",
      "description": "Among fields laid in columns, the whole line for this one: a long text, a choice of many options.",
      "default": false
    },
    "extensions": {
      "type": "object",
      "description": "What is attached to the field whatever its kind, each by its name and declared once (`extension_<name>.schema.json`): its earlier versions, an expression in place of its value. Cumulable; a field knows nothing of them, the form's base draws them.",
      "properties": {
        "versions": { "$ref": "extension_versions.schema.json" },
        "expression": { "$ref": "extension_expression.schema.json" }
      },
      "additionalProperties": false
    }
  }
}
