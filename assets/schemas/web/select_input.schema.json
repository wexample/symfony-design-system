{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "select_input.schema.json",
  "title": "Select input field",
  "type": "object",
  "allOf": [
    { "$ref": "field_base.schema.json" }
  ],
  "properties": {
    "type": {
      "const": "select"
    },
    "multiple": {
      "type": "boolean"
    },
    "optionsUrl": {
      "type": "string",
      "minLength": 1,
      "description": "Where the choices are read again when a field they follow changes — that field's value where it says `__field:<name>__` —, answering words or `{ value, label }`; the value dropped when it is no longer among them."
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {"type": "string"},
          "value": {"type": ["string", "number", "null"]},
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {"type": "string"},
                "value": {"type": ["string", "number", "null"]}
              },
              "required": ["label", "value"]
            }
          }
        },
        "required": ["label", "value"]
      }
    }
  },
  "required": ["type", "name", "label", "choices"],
  "unevaluatedProperties": false
}
