{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "textarea_input.schema.json",
  "title": "Textarea input field",
  "type": "object",
  "allOf": [
    { "$ref": "field_base.schema.json" }
  ],
  "properties": {
    "type": {
      "const": "textarea"
    },
    "versionsUrl": {
      "type": "string",
      "minLength": 1,
      "description": "Where the earlier versions of the field's content are read, the record's id where the form's action has it (`__id__`): answering `[{ label, content, date, author }]`, the latest first, without the current one."
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "max_rows": {
      "type": "integer",
      "minimum": 1
    },
    "auto_resize": {
      "type": "boolean"
    },
    "cols": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["type", "name", "label"],
  "unevaluatedProperties": false
}
