{%- extends '@WexampleSymfonyDesignSystemBundle/vue/bases/vue.vue.twig' -%}

{%- block vue_body -%}
    <li class="tree--item" :class="{ 'is-open': isOpen, 'is-selected': item.selected }">
        <component
                :is="item.href ? 'a' : 'span'"
                class="tree--row"
                :href="item.href || null"
                :style="{ '--tree-depth': depth }"
                @click="onRowClick"
        >
            <component
                    v-if="rowComponent"
                    :is="rowComponent"
                    :item="item"
                    :label="label"
                    :is-open="isOpen"
                    @action="$emit('action', $event)"
            ></component>
            <template v-else>
                <span class="tree--caret" v-html="caretHtml"></span>
                <span v-if="item.icon" class="tree--icon" v-html="iconHtml"></span>
                <span class="tree--label">[[ label ]]</span>
            </template>
        </component>
        <ul v-if="hasChildren" class="tree--children">
            <tree-node
                    v-for="(child, index) in children"
                    :key="index"
                    :item="child"
                    :depth="depth + 1"
                    @select="$emit('select', $event)"
                    @action="$emit('action', $event)"
            ></tree-node>
        </ul>
    </li>
{%- endblock -%}
