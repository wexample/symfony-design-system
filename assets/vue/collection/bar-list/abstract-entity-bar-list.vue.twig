{%- extends '@WexampleSymfonyDesignSystemBundle/vue/bases/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyDesignSystemBundle.common.system::frontend.*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/partials/bar') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/partials/date-display') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/partials/pagination') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/partials/spinner') -}}
{%- endblock -%}

{%- block vue_body -%}
    <div class="bar-list">
        <pagination
                v-if="hasPaginationAt('top')"
                v-bind="paginationProps"
                @change="goToPage"
        ></pagination>

        <div v-if="isLoading && !hasBars" class="text-empty">
            <spinner size="sm" :label="resolvedLoadingLabel"></spinner>
        </div>
        <div v-else-if="!hasBars" class="text-empty">[[ resolvedEmptyLabel ]]</div>

        <div v-else :class="itemsClass">
            {# `item` and not `bar`: the loop must not shadow the component it renders. #}
            <bar
                    v-for="item in bars"
                    :key="item.key"
                    :class="barClass"
                    :title="item.title"
                    :subtitle="item.subtitle"
                    :icon="item.icon"
                    :avatar="item.avatar"
                    :href="item.href"
            >
                <template v-if="item.date" #trailing>
                    {%- block bar_list_item_trailing -%}
                        <date-display :value="item.date"></date-display>
                    {%- endblock -%}
                </template>
            </bar>
        </div>

        <pagination
                v-if="hasPaginationAt('bottom')"
                v-bind="paginationProps"
                @change="goToPage"
        ></pagination>
    </div>
{%- endblock -%}
