{%- extends '@WexampleSymfonyDesignSystemBundle/vue/bases/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/partials/data-table') -}}
{%- endblock -%}

{%- block vue_config -%}
    {%- set entityName %}{% block vue_entity_name %}{% endblock %}{%- endset -%}
    {%- set entityName = entityName|trim -%}
    {%- if entityName is not empty -%}
        {{- trans_js(render_pass, '@entity.' ~ entityName ~ '::field.*') -}}
    {%- endif -%}
{%- endblock -%}

{%- block vue_body -%}
    <data-table
            :rows="entities"
            :columns="columns"
            :app="app"
            :show-header="showHeader"
            :loading="isLoading"
    ></data-table>
{%- endblock -%}
