{%- extends '@WexampleSymfonyDesignSystemBundle/vue/bases/form.vue.twig' -%}
{%- set td = translationDomain|default('WexampleSymfonyDesignSystemBundle.vue.form.demo-form') -%}
{%- set form_errors_translation_prefix = td ~ '::form.error.' -%}

{%- block vue_require -%}
    {{ parent() }}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/form/fields/text-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/form/fields/textarea-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/form/fields/radio-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/form/fields/switch-input') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/form/fields/submit-button') -}}
{%- endblock -%}

{%- block form_notification -%}
    <div v-if="formSubmitted" class="message message--success">
        <strong>{{ (td ~ '::toast.success.title')|trans }}</strong>
        {{ (td ~ '::toast.success.message')|trans }}
    </div>
{%- endblock -%}

{%- block form_body -%}
    <div class="lead">{{ (td ~ '::description')|trans }}</div>

    <div class="grid grid--2">
        <text-input
                v-model="textSimple"
                name="text_simple"
                :errors="fieldErrors['text_simple'] || []"
                label="{{ (td ~ '::field.text_simple.label')|trans }}"
                help="{{ (td ~ '::field.text_simple.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.text_simple.error.' }}"
        ></text-input>
        <text-input
                v-model="password"
                name="password"
                type="password"
                :errors="fieldErrors['password'] || []"
                label="{{ (td ~ '::field.password.label')|trans }}"
                help="{{ (td ~ '::field.password.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.password.error.' }}"
        ></text-input>
    </div>

    <textarea-input
            v-model="textArea"
            name="text_area"
            :rows="4"
            :errors="fieldErrors['text_area'] || []"
            label="{{ (td ~ '::field.text_area.label')|trans }}"
            help="{{ (td ~ '::field.text_area.help')|trans }}"
            placeholder="{{ (td ~ '::field.text_area.placeholder')|trans }}"
            error-translation-prefix="{{ td ~ '::field.text_area.error.' }}"
    ></textarea-input>

    <text-input
            v-model="emoji"
            name="emoji"
            :errors="fieldErrors['emoji'] || []"
            label="{{ (td ~ '::field.emoji.label')|trans }}"
            help="{{ (td ~ '::field.emoji.help')|trans }}"
            error-translation-prefix="{{ td ~ '::field.emoji.error.' }}"
    ></text-input>

    <div class="grid grid--3">
        <text-input
                v-model="number"
                name="number"
                type="number"
                :errors="fieldErrors['number'] || []"
                label="{{ (td ~ '::field.number.label')|trans }}"
                help="{{ (td ~ '::field.number.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.number.error.' }}"
        ></text-input>
        <text-input
                v-model="email"
                name="email"
                type="email"
                placeholder="{{ (td ~ '::field.email.placeholder')|trans }}"
                :errors="fieldErrors['email'] || []"
                label="{{ (td ~ '::field.email.label')|trans }}"
                help="{{ (td ~ '::field.email.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.email.error.' }}"
        ></text-input>
        <text-input
                v-model="url"
                name="url"
                type="url"
                placeholder="{{ (td ~ '::field.url.placeholder')|trans }}"
                :errors="fieldErrors['url'] || []"
                label="{{ (td ~ '::field.url.label')|trans }}"
                help="{{ (td ~ '::field.url.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.url.error.' }}"
        ></text-input>
    </div>

    <div class="grid grid--3">
        <text-input
                v-model="date"
                name="date"
                type="date"
                :errors="fieldErrors['date'] || []"
                label="{{ (td ~ '::field.date.label')|trans }}"
                help="{{ (td ~ '::field.date.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.date.error.' }}"
        ></text-input>
        <text-input
                v-model="datetime"
                name="datetime"
                type="datetime-local"
                :errors="fieldErrors['datetime'] || []"
                label="{{ (td ~ '::field.datetime.label')|trans }}"
                help="{{ (td ~ '::field.datetime.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.datetime.error.' }}"
        ></text-input>
        <text-input
                v-model="time"
                name="time"
                type="time"
                :errors="fieldErrors['time'] || []"
                label="{{ (td ~ '::field.time.label')|trans }}"
                help="{{ (td ~ '::field.time.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.time.error.' }}"
        ></text-input>
    </div>

    <text-input
            v-model="file"
            name="file"
            type="file"
            :errors="fieldErrors['file'] || []"
            label="{{ (td ~ '::field.file.label')|trans }}"
            help="{{ (td ~ '::field.file.help')|trans }}"
            error-translation-prefix="{{ td ~ '::field.file.error.' }}"
    ></text-input>

    <div class="grid grid--2">
        <radio-input
                v-model="radioChoice"
                name="radio_choice"
                :options="radioChoiceOptions"
                :errors="fieldErrors['radio_choice'] || []"
                label="{{ (td ~ '::field.radio_choice.label')|trans }}"
                help="{{ (td ~ '::field.radio_choice.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.radio_choice.error.' }}"
        ></radio-input>
        <switch-input
                v-model="switchValue"
                name="switch"
                :errors="fieldErrors['switch'] || []"
                label="{{ (td ~ '::field.switch.label')|trans }}"
                help="{{ (td ~ '::field.switch.help')|trans }}"
                error-translation-prefix="{{ td ~ '::field.switch.error.' }}"
        ></switch-input>
    </div>

    <submit-button :type="'button'" :label="'{{ td ~ '::action.button_demo' }}'"></submit-button>

    <div class="form--actions">
        <submit-button @click="behavior = 'error'" :label="'{{ td ~ '::action.submit_error' }}'"></submit-button>
        <submit-button @click="behavior = 'js'" :label="'{{ td ~ '::action.submit_js' }}'"></submit-button>
        <submit-button @click="behavior = 'redirect'" :label="'{{ td ~ '::action.submit_redirect' }}'"></submit-button>
        <submit-button @click="behavior = 'default'" :label="'{{ td ~ '::action.submit_default' }}'"></submit-button>
    </div>
{%- endblock -%}
